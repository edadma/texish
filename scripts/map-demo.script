// map-demo — a demonstration of the `map` package: a Web Mercator map of the Levant
// with a pre-projected Natural Earth base (coast, rivers, lakes, land), a graticule, an
// overlay of biblical sites entered in real longitude/latitude, a journey route, a scale
// bar, a north arrow and a neatline. The base linework is projected offline into
// levant-base.texish; everything in the \map body below is projected at run time by the
// package, so the sites and route are written as plain coordinates.

\use{document}
\use{map}
\include{levant-base.texish}

\geometry paper:a5 margin:0.55in

\centerline{\bfseries\large The Land of the Bible}
\vskip 4pt
\centerline{\small\itshape Web Mercator projection, Natural Earth base}
\vskip 8pt

\centerline{\map{
  \basemap
  \graticule{1}

  // A journey line: Nazareth down the Jordan valley to Jericho and up to Jerusalem.
  \route[#8a5a2b]{35.30 32.70  35.50 32.40  35.52 31.87  35.44 31.87  35.23 31.78}

  \place[east]{35.23}{31.78}{Jerusalem}
  \place[south]{35.20}{31.70}{Bethlehem}
  \place[north]{35.44}{31.87}{Jericho}
  \place[west]{35.10}{31.53}{Hebron}
  \place[west]{34.79}{31.25}{Beersheba}
  \place[south]{35.30}{32.70}{Nazareth}
  \place[north]{35.58}{32.88}{Capernaum}
  \place[west]{36.29}{33.51}{Damascus}
  \place[west]{35.19}{33.27}{Tyre}
  \place[west]{35.37}{33.56}{Sidon}

  \label[west]{35.63}{32.82}{\mapwaterfont{Sea of Galilee}}
  \label[west]{35.62}{31.42}{\mapwaterfont{Dead Sea}}
  \label[center]{34.35}{32.6}{\mapwaterfont{Mediterranean Sea}}

  \scalebar[50]{14}{16}
  \northarrow{278}{430}
  \neatline
}}

\vfill\eject
