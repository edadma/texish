// Tract duplex/fold calibration sheet.
//
// Print this DOUBLE-SIDED, flip on the LONG edge, at TRUE 100% (no "fit to page" scaling):
//   lp -d <printer> -o sides=two-sided-long-edge -o media=letter -o fit-to-page=false this.pdf
//
// It lays out the same six labelled panels the tract package would, with dashed fold guides at the
// thirds and a dashed cut guide across the middle, but no text to hide misregistration. Use it to:
//
//   1. Confirm the cut: fold the sheet in half top-to-bottom. Both the front (EN) and back (ES) cut
//      guides should land on that true middle. If one side is off, shift it onto the middle with the
//      package's tractfrontdy / tractbackdy (positive = up, about 2.835 points per millimetre).
//   2. Confirm the thirds: accordion-fold the sheet into three equal columns edge to edge; the folds
//      should fall on the printed fold guides. If they sit inboard, the printer is scaling -- reprint
//      at true 100%.
//   3. Confirm front/back: hold to the light; EN n should sit directly behind ES n.
//
// This sheet itself applies NO compensation, so it shows the printer's raw behaviour; once measured,
// set the offsets in your real document.

\set hoffset {0}\set voffset {0}\set hsize {612}\set vsize {792}\set raggedbottom {1}

\def lbl t {\font lmroman 30 bold \t}

// One side: dashed fold guides (x=204, x=408) and cut guide (y=396), then the three column labels in
// both the upper and the lower tract.
\def side a b c {
  \noindent\picture width:612 height:792 {
    \nofill\stroke{#b0b0b0}\linewidth{0.5}\dash{3 3}
    \line{204 0 204 792}\line{408 0 408 792}\line{0 396 612 396}
    \dash{}\stroke{black}
    \at anchor:center {102 600}{\lbl{\a}}
    \at anchor:center {306 600}{\lbl{\b}}
    \at anchor:center {510 600}{\lbl{\c}}
    \at anchor:center {102 204}{\lbl{\a}}
    \at anchor:center {306 204}{\lbl{\b}}
    \at anchor:center {510 204}{\lbl{\c}}
  }
}

\side{EN 1}{EN 2}{EN 3}\newpage
\side{ES 1}{ES 2}{ES 3}
