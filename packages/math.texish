// math — amsmath-style mathematics. Most of the heavy machinery lives in the engine and needs no package at
// all: the display fractions \dfrac and \tfrac, the binomial family \binom/\dbinom/\tbinom, the framed \boxed,
// the stacking \overset/\underset/\substack, custom operators \operatorname, and the math-array environments
//
//     \begin{aligned}  a &= b \\  c &= d  \end{aligned}      // equations aligned on their relations
//     \begin{pmatrix} 1 & 2 \\ 3 & 4 \end{pmatrix}           // and bmatrix/vmatrix/Vmatrix/Bmatrix/matrix
//     \begin{cases}  x^2 & x \ge 0 \\  -x & x < 0  \end{cases}
//     \begin{smallmatrix} a & b \\ c & d \end{smallmatrix}   // small, set inline
//
// are all built in (use them inside $…$ or a $$…$$ display). What this package adds are the amsmath name
// macros the engine does not define on its own: the remaining inverse and probability operators, the modular
// "mod" forms, and the implication arrows. Load it with \use{math}.

// The inverse trigonometric operators and the probability operator, set upright like the built-in \sin, \log
// and \lim. Each is an ordinary operator name; \operatorname keeps the letters roman and gives the run the
// spacing of an operator.
\def arcsin {\operatorname{arcsin}}//
\def arccos {\operatorname{arccos}}//
\def arctan {\operatorname{arctan}}//
\def Pr {\operatorname{Pr}}//

// The modular arithmetic forms. \bmod is the binary operator in "a mod b" --- \mathbin makes the upright "mod"
// a true binary operator, so it takes a medium space on either side; \pmod sets a parenthesised "(mod m)" after
// a quad of space, the way a congruence is closed off; \mod and \pod are its unparenthesised and
// bare-parenthesised cousins.
\def bmod {\mathbin{\operatorname{mod}}}//
\def pmod m {\quad(\operatorname{mod}\,\m)}//
\def mod m {\quad\operatorname{mod}\,\m}//
\def pod m {\quad(\m)}//

// The implication arrows of a proof, each a heavy arrow with a thick space on either side so it reads as a
// connective between whole statements rather than a symbol inside one.
\def implies {\;\Rightarrow\;}//
\def impliedby {\;\Leftarrow\;}//
\def iff {\;\Leftrightarrow\;}//

// The amsmath spelling of the low ellipsis, an alias for the engine's \ldots.
\def dots {\ldots}//
