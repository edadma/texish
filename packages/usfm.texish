// usfm — typeset Scripture from a USFM (Unified Standard Format Markers) file.
//
// Load it and hand the \usfm primitive a file:
//
//     \use{usfm}
//     \usfm{john.usfm}
//
// The primitive translates the file's markers into calls on the \usfm… macros defined below, so every visible
// decision — the chapter figure, the verse number, the poetry indents, the section headings, the footnotes, the
// words of Jesus — is an ordinary macro a document can redefine before the call. Set the appearance with plain
// texish commands first; then typeset the book:
//
//     \use{usfm}
//     \def usfmwj t {\t}          // words of Jesus in plain black rather than red
//     \set usfmqbase {24}          // a deeper poetry indent
//     \usfm{psalms.usfm}
//
// The format builds on `document`, so its title, sectioning and size commands are available too.

\use{document}

// ---- Body defaults --------------------------------------------------------------
// The font family every part of the book is set in — body, titles, headings, footnotes, and the inline styles,
// which all take their italic/bold/small-caps cut from this family. It is a macro, not a fixed face, so a document
// that sets Scripture in a non-Latin script redefines it once and the whole book follows: \def usfmfamily {cjksc}
// for Chinese, {arabic}, {hebrew}, {devanagari} … A family with no italic or small-caps cut (a CJK face, say)
// substitutes its nearest available weight automatically, so a heading or a reference line still sets.
\def usfmfamily {lmroman}
// A 10pt body on a 12pt baseline. A document overrides any of these before \usfm{…}.
\font \usfmfamily 10 regular
\set baselineskip {12}
\set parindent {15}

// The book introduction is set by default. A pocket portion that wants only the Scripture sets \usfmintro to 0
// before \usfm{…}, and the reader drops the introduction — no need to touch the USFM file.
\set usfmintro {1}

// ---- Book identity --------------------------------------------------------------
// \h records the running book name in \usfmbook (for a document that wants a running head); \toc entries are not
// printed. Both are redefinable.
\def usfmbook {}
\def usfmh n t {\gdef usfmbook {\t}}
\def usfmtoc n t {}

// ---- Titles ---------------------------------------------------------------------
// \mt1 is the book title; higher \mt levels are its subtitles (which appear above it in the file), set smaller.
// \ms is a major section title such as a psalter's book division, \mr its reference line. A title is a centred
// paragraph, not a single \centerline, so a long book name (say a French "Évangile selon Jean") wraps to fit a
// narrow measure rather than overrunning it — \usfmcenter sets the paragraph shape that centres every line.
\def usfmcenter {\set leftskip {0 plus 1fil}\set rightskip {0 plus 1fil}\set parfillskip {0}\set parindent {0}}
// A left-aligned, ragged-right paragraph shape for a heading or reference line, so a long one wraps to fit the
// measure instead of overrunning it. Some translations write a whole chapter summary as a section heading.
\def usfmleftpar {\set leftskip {0}\set rightskip {0 plus 1fil}\set parfillskip {0 plus 1fil}\set parindent {0}}
\def usfmmt n t {\par\if {\> {\n} {1}}\medskip{\usfmcenter\font \usfmfamily 13 regular \noindent\t\par}\smallskip\else\bigskip{\usfmcenter\font \usfmfamily 22 bold\noindent\t\par}\medskip\fi\noindent}
\def usfmmte n t {\usfmmt{\n}{\t}}
\def usfmms n t {\par\bigskip{\usfmcenter\font \usfmfamily 14 bold \noindent\t\par}\smallskip\noindent}
\def usfmmr n t {\par{\usfmcenter\font \usfmfamily 10 italic \noindent\t\par}\medskip\noindent}

// ---- Section headings -----------------------------------------------------------
// \s is a section heading (bold); \r the parallel-passage references beneath it (small italic, set as a ragged
// paragraph so a long four-way cross-reference wraps to fit a narrow measure rather than overrunning a single
// line); \d a psalm's descriptive title, or superscription, which can carry its own \v; \qa an acrostic heading;
// \sp a speaker label.
// Each ends with \noindent, as document's own \section does: that opens an empty paragraph left flush, so the body
// paragraph that follows the heading sets flush too, without \p needing to know a heading came before it.
\def usfms n t {\par\medskip{\usfmleftpar\font \usfmfamily 11 bold\noindent\t\par}\nobreak\smallskip\noindent}
\def usfmr n t {\par{\usfmleftpar\font \usfmfamily 9 italic\noindent\t\par}\nobreak\smallskip\noindent}
\def usfmsr n t {\usfmr{\n}{\t}}
\def usfmd n t {\par\smallskip{\usfmleftpar\font \usfmfamily 10 italic\noindent\t\par}\nobreak\smallskip\noindent}
\def usfmsp n t {\par\smallskip{\usfmleftpar\font \usfmfamily 10 bold\noindent\t\par}\nobreak\smallskip\noindent}
\def usfmqa n t {\par\smallskip{\usfmleftpar\font \usfmfamily 11 bold\noindent\t\par}\nobreak\smallskip\noindent}
\def usfmcl n t {\par\medskip{\usfmcenter\font \usfmfamily 13 bold \noindent\t\par}\smallskip\noindent}
\def usfmcp n t {}

// ---- Book introduction ----------------------------------------------------------
// A book may open with an introduction: its own titles (\imt), section headings (\is), an outline (\iot heading,
// \io entries each carrying an \ior reference span), and prose (\ip) and poetry (\iq). These render like their
// Scripture counterparts a size quieter, and each block ends with \noindent so the paragraph after a heading sets
// flush. \ib is a blank line within the introduction. \ie (intro end) is dropped by the reader.
\def usfmimt n t {\par\medskip{\usfmcenter\font \usfmfamily 12 bold \noindent\t\par}\smallskip\noindent}
\def usfmimte n t {\usfmimt{\n}{\t}}
\def usfmis n t {\par\smallskip{\usfmleftpar\font \usfmfamily 11 bold\noindent\t\par}\nobreak\smallskip\noindent}
\def usfmiot n t {\par\smallskip{\usfmleftpar\font \usfmfamily 11 bold\noindent\t\par}\nobreak\smallskip\noindent}
\def usfmio n t {\par{\set leftskip {\calc{\n * 12}}\set rightskip {0 plus 1fil}\set parfillskip {0 plus 1fil}\set parindent {0}\noindent\t\par}\noindent}
\def usfmip n {\par\usfmprose}
\def usfmipi n {\par\usfmprose\set leftskip {18}}
\def usfmim n {\par\usfmprose\noindent}
\def usfmimi n {\par\usfmprose\set leftskip {18}\noindent}
\def usfmipq n {\par\usfmprose\set leftskip {18}\set rightskip {18}}
\def usfmimq n {\par\usfmprose\set leftskip {18}\set rightskip {18}\noindent}
\def usfmipr n {\par\usfmprose\set leftskip {0 plus 1fil}\set parfillskip {0}\set parindent {0}\noindent}
\def usfmiq n {\par\usfmpoetry\set leftskip {\calc{usfmqbase + (\n - 1) * usfmqstep}}\noindent}
\def usfmili n {\par\set leftskip {\calc{\n * 18}}\set rightskip {0}\set parfillskip {0 plus 1fil}\set parindent {0}\noindent}
\def usfmiex n {\par\usfmprose\noindent}
\def usfmib {\par\smallskip}

// ---- Chapters and verses --------------------------------------------------------
// A chapter number is held until the next body paragraph, which opens with it set as a large figure (\usfmchapfig)
// — so the number leads the chapter's first paragraph, after any heading. The figure is document's \dropcap with an
// empty word-remainder: the number is enlarged until it spans two lines (its top on the first line's cap height,
// its baseline on the second) and the opening lines are carved around it. \dropcap opens the paragraph itself (it
// registers the carve between paragraphs, then runs its own \noindent), so the paragraph macros emit the figure in
// vertical mode — they no longer \noindent ahead of it. Because \dropcap carves with a \cutout rather than a
// hanging indent, the carve reaches across a paragraph break: a chapter whose verse 1 is a short one-line
// paragraph, followed by verse 2 as a new paragraph, still flows that next paragraph around the number instead of
// letting it ride onto the figure. The weight is set with the \bfseries / \mdseries declarations rather than
// \bold{…}, which change it without wrapping the \dropcap call in a group. Verse numbers are small sans-serif
// superscripts set in Latin Modern Sans (\usfmversenum), whatever the Scripture face: a verse number is always a
// Latin numeral, and a single sans face keeps it crisp at superscript size, sets it apart from the serif prose and
// from the serif footnote markers, and gives every edition the same numerals whether the body is Roman, CJK, Arabic
// or Hebrew (those faces carry no sans cut, so scaling the body face would fail on them). Verse 1's number is
// omitted: the chapter figure already marks where the first verse begins, as in most printed Bibles. A verse marked
// with a range (1-2) is not verse 1 and keeps its number. The paragraph macro that emits the figure ends with
// \ignorespaces, so the space the source leaves
// between the chapter number and the first word is swallowed: the word sits flush against the drop cap's carved
// inset, level with the carved lines below it, instead of one space further in.
// Redefine \usfmchapfig — e.g. \dropcap[3] for a three-line figure — to restyle.
\set usfmchappending {0}
\def usfmchapno {}
\def usfmchapfig {\bfseries\dropcap[2][5]{\usfmchapno}{}\mdseries}
\def usfmc n {\gdef usfmchapno {\n}\set usfmchappending {1}\par\medskip}
\def usfmchapmaybe {\if {\> {\calc{usfmchappending}} {0}}\set usfmchappending {0}\usfmchapfig\else\noindent\fi\ignorespaces}
\def usfmversenum n {\raise 0.3em \hbox{\font lmroman 7 {sans bold}\n}\kern 1.5 }
\def usfmv n {\if {\= {\n} {1}}\else\usfmversenum{\n}\fi}

// ---- Body paragraphs ------------------------------------------------------------
// \p is an indented paragraph — except a chapter's first paragraph, which opens flush with the chapter figure, and
// the first paragraph after a heading, which stays flush because the heading left the indent off (see above). \p
// itself forces neither: it lets the running indent state decide, indenting after a body paragraph and setting
// flush after a heading or chapter figure. \m, \pmo and \nb run flush left; \pc is centred. Each resets the
// paragraph shape it needs so a preceding poetry line's ragged margins do not leak in.
\def usfmprose {\set leftskip {0}\set rightskip {0}\set parfillskip {0 plus 1fil}\set parindent {15}}
\def usfmp n {\par\usfmprose\if {\> {\calc{usfmchappending}} {0}}\set usfmchappending {0}\usfmchapfig\fi\ignorespaces}
\def usfmm n {\par\usfmprose\usfmchapmaybe}
\def usfmpmo n {\usfmm{\n}}
\def usfmpm n {\usfmm{\n}}
\def usfmpo n {\usfmm{\n}}
\def usfmmi n {\usfmm{\n}}
\def usfmcls n {\usfmm{\n}}
\def usfmnb n {\par\usfmprose\noindent}
\def usfmpi n {\par\usfmprose\set leftskip {\calc{\n * 12}}\usfmchapmaybe}
\def usfmpc n {\par\set leftskip {0 plus 1fil}\set rightskip {0 plus 1fil}\set parfillskip {0}\set parindent {0}\usfmchapmaybe}
\def usfmpmc n {\usfmpc{\n}}

// ---- Poetry ---------------------------------------------------------------------
// Each poetry line is set on its own line, indented by its level: usfmqbase for level 1, a further usfmqstep for
// each level beyond, ragged along the right. \qr flushes right (a Selah); \b is a stanza break.
\set usfmqbase {18}
\set usfmqstep {18}
\def usfmpoetry {\set rightskip {0 plus 1fil}\set parfillskip {0 plus 1fil}\set parindent {0}}
\def usfmq n {\par\usfmpoetry\set leftskip {\calc{usfmqbase + (\n - 1) * usfmqstep}}\usfmchapmaybe}
\def usfmqm n {\usfmq{\n}}
\def usfmqd n {\usfmq{\n}}
\def usfmqc n {\par\usfmpoetry\set leftskip {0 plus 1fil}\usfmchapmaybe}
\def usfmqr n {\par\usfmpoetry\set leftskip {0 plus 1fil}\set rightskip {0}\set parfillskip {0}\usfmchapmaybe}
\def usfmpr n {\usfmqr{\n}}
\def usfmpmr n {\usfmqr{\n}}
\def usfmph n {\par\usfmprose\set leftskip {\calc{\n * 18}}\usfmchapmaybe}
\def usfmb {\par\smallskip}

// ---- Lists ----------------------------------------------------------------------
\def usfmli n {\par\set leftskip {\calc{\n * 18}}\set rightskip {0}\set parfillskip {0 plus 1fil}\set parindent {0}\usfmchapmaybe}
\def usfmlim n {\usfmli{\n}}

// ---- Illustrations --------------------------------------------------------------
// A USFM \fig figure. The reader hands \usfmfig the image path, the requested size (col = the text measure,
// span = the same in a single-column book), and the caption. A figure is set as its own centred block at
// the text width, with a small italic caption beneath when the source gives one. Placed right after a \c
// marker it heads the chapter, above the chapter number that opens the first paragraph. A break is allowed
// before the figure but not after it, so a chapter-head figure never strands at the foot of the previous
// chapter's page: image, caption and the chapter opening move to the next page together. Figures are shown
// by default; \set usfmfigures {0} drops every figure — an edition whose readers are aniconic (an Arabic or
// Hebrew portion, say) turns them off without touching the USFM. Redefine \usfmfig to restyle placement,
// width or caption.
\set usfmfigures {1}
\def usfmfig src size cap {\if {\> {\calc{usfmfigures}} {0}}\par\centerline{\includegraphics[width=\linewidth]{\src}}\if {\size {\cap}}\nobreak\smallskip{\usfmcenter\font \usfmfamily 8 italic\noindent\cap\par}\fi\nobreak\medskip\noindent\fi}

// ---- Inline character styles ----------------------------------------------------
// Words of Jesus are red by default (the red-letter convention) — \def usfmwj t {\t} for plain text. A cross-
// reference prints its display text, its canonical target available as a second argument for a linking document.
\def usfmwj t {\textcolor{#c0281e}{\t}}
\def usfmref d t {\d}
\def usfmnd t {\smallcaps{\t}}
\def usfmadd t {\italic{\t}}
\def usfmbk t {\italic{\t}}
\def usfmtl t {\italic{\t}}
\def usfmqt t {\t}
\def usfmqs t {\italic{\t}}
\def usfmsc t {\smallcaps{\t}}
\def usfmem t {\italic{\t}}
\def usfmit t {\italic{\t}}
\def usfmbd t {\bold{\t}}
\def usfmbdit t {\bold{\italic{\t}}}
\def usfmsup t {\textsup{\t}}
\def usfmk t {\italic{\t}}
\def usfmrq t {\italic{\t}}
\def usfmw t {\t}
\def usfmfv t {{\bold \textsup{\t}}}
\def usfmno t {\t}
\def usfmdc t {\t}
\def usfmpn t {\t}
\def usfmpng t {\t}
\def usfmpro t {\t}
\def usfmrb t {\t}
\def usfmwg t {\t}
\def usfmwh t {\t}
\def usfmwa t {\t}
\def usfmqac t {\t}
\def usfmlit t {\bold{\t}}
\def usfmord t {\textsup{\t}}
\def usfmsig t {\italic{\t}}
\def usfmsls t {\italic{\t}}
\def usfmior t {\italic{\t}}
\def usfmiqt t {\italic{\t}}

// ---- Footnotes ------------------------------------------------------------------
// A footnote rides the foot of its page through the engine's \footnote, set small. Its parts: \fr the origin
// reference (bold), \ft explanatory text (roman), \fqa an alternative rendering (italic), \fv a verse number
// inside the note. \usfmxref renders a cross-reference note the same way.
//
// Both take the note's USFM caller as their first argument. A `+` caller means "number it": the note joins the
// running footnote sequence. Any other caller is used verbatim — set as a small italic sigil, the way Louis
// Segond marks its per-passage cross-references with italic letters a, b, c — and does not touch the counter.
\def usfmfootnote c b {\if {\= {\c} {+}}\footnote{\font \usfmfamily 8 regular\b}\else\footnote[\italic{\c}]{\font \usfmfamily 8 regular\b}\fi}
\def usfmxref c b {\if {\= {\c} {+}}\footnote{\font \usfmfamily 8 regular\b}\else\footnote[\italic{\c}]{\font \usfmfamily 8 regular\b}\fi}
\def usfmfr t {{\bold \t} }
\def usfmft t {\t}
\def usfmfq t {\italic{\t}}
\def usfmfqa t {\italic{\t}}
\def usfmfqb t {\italic{\t}}
\def usfmfk t {\smallcaps{\t}}
\def usfmfl t {\t}
\def usfmfp t {\t}
\def usfmfw t {\t}
\def usfmfdc t {\t}
\def usfmfm t {\t}
\def usfmxo t {{\bold \t} }
\def usfmxt t {\t}
\def usfmxq t {\italic{\t}}
\def usfmxk t {\smallcaps{\t}}
\def usfmxot t {\t}
\def usfmxnt t {\t}
\def usfmxta t {\t}

// ---- Tables ---------------------------------------------------------------------
// A USFM table (\tr rows of \tc / \th cells) is translated to one \usfmtable, whose first argument is a column
// spec (one letter per column) and whose body is the cells joined with & and rows with \\ — the engine's \tabular
// lays them out in equal columns. Header cells are bold; the table stands off from the surrounding text.
\def usfmtable s b {\par\medskip\noindent\tabular{\s}{\b}\par\medskip\noindent}
\def usfmtc t {\t}
\def usfmth t {\bold{\t}}
