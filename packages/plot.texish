// plot — 2-D data plots, written entirely in the document language over the
// \picture vector-graphics layer. Import it with:
//
//     \use{plot}
//
// A plot is set up by declaring the data ranges (or letting \autorange derive them),
// then drawn by \plot, whose body holds one or more data series:
//
//     \xrange{0}{6}  \yrange{0}{130}
//     \xlabel{time (s)}  \ylabel{height (m)}  \plottitle{Projectile}
//     \plot{
//       \lineplot[royalblue][observed]{0 0  1 45  2 80  3 105  4 120  5 125  6 118}
//       \scatter[crimson][sampled]{2 80  4 120  6 120}
//       \legend
//     }
//
// \plot opens a \picture sized to hold the data area plus margins for the axes and
// labels, draws the frame (grid, axes, tick marks with numeric labels, axis labels
// and title), then runs its body to draw the series on top. Everything is the
// document language: \chunk groups a flat data list into points, \for steps them, \calc
// does the data-to-device arithmetic, and the series are \picture paths and shapes.
// There is no plot-specific engine primitive.
//
// Series take two optional bracket arguments before their data: a colour (default
// auto, drawn from a palette in turn) and a legend label (default none). So
// \lineplot{…} auto-colours and adds no legend entry, \lineplot[teal]{…} fixes the
// colour, and \lineplot[teal][Sales]{…} also records a legend entry.
//
// Data-to-device mapping. A series point in *data* coordinates (x, y) maps to a
// *device* point inside the picture by an affine transform that \plot stores in the
// variables plotOx/plotOy (the data area's bottom-left corner) and plotSx/plotSy
// (device points per data unit). \px and \py apply it.

// ---- Configuration (override with \set after \use, before \plot) --------------
// Sizes are in points (72 per inch). The data *area* is plotareaw × plotareah; the
// picture grows by the margins around it.
\set plotareaw {234}
\set plotareah {162}
\set plotml {46}            // left margin — y tick labels and the y axis label
\set plotmr {14}            // right margin
\set plotmt {12}            // top margin (a title adds to this)
\set plotmb {42}            // bottom margin — x tick labels and the x axis label

\set plotxstepcfg {0}       // 0 = choose a nice tick step automatically
\set plotystepcfg {0}
\set plottickdec {3}        // round tick labels to at most this many decimals

\set plotgrid {1}           // draw a light grid behind the data
\set plotzeroaxis {1}       // draw an axis line at zero when a range straddles it
\set plotticklen {4}        // length of a tick mark, in points
\set plotsamples {80}       // samples across the domain for \fnplot
\set plotmarkr {2.6}        // marker radius for \scatter
\set plotmarkshape {circle} // circle | square | triangle | diamond
\set plotbarfrac {0.6}      // bar width as a fraction of the x step, for \bars

\set plotaxiscolor {dimgray}
\set plotgridcolor {gainsboro}
\set plotgridcolorminor {whitesmoke}   // minor grid lines, lighter than the major grid
\set plotreflcolor {gray}   // default colour for \hline / \vline reference lines
\set plottickfontsize {8}
\set plotlabelfontsize {9}
\set plottitlefontsize {11}

\set plotleginset {8}       // legend inset from the data-area corner
\set plotlegrow {12}        // legend row height
\set plotlegswatch {16}     // legend swatch width

\set plotclip {1}           // clip series drawing to the data area
\set plotvalues {0}         // print each bar's value above it (\bars)
\set plotXcat {0}           // 1 when \xcategories has set a categorical x axis

\set ploterrcap {3}         // half-width of an error-bar cap, in points
\set plotxminor {0}         // minor x subdivisions per major interval (0 = none)
\set plotyminor {0}         // minor y subdivisions per major interval (0 = none)
\set plotminorgrid {1}      // draw minor grid lines when minor subdivisions are on

\set plotbubblemin {3}        // smallest bubble radius, in points (\bubble)
\set plotbubblemax {18}       // largest bubble radius, in points
\set plotbubbleopacity {0.55} // bubble fill opacity, so overlapping bubbles show through

\set plotbandopacity {0.25}   // fill opacity of a \bandplot, so the line inside it stays readable
\set plothistbins {10}        // number of bins a \histogram divides its values into

// ---- Colour palette ------------------------------------------------------------
// Series with colour `auto` draw their colour from this palette in turn, cycling if
// there are more series than entries. \set a new entry or change plotPaletteLen to
// recolour the cycle.
\global\mapset plotPalette {0} {royalblue}
\global\mapset plotPalette {1} {crimson}
\global\mapset plotPalette {2} {seagreen}
\global\mapset plotPalette {3} {darkorange}
\global\mapset plotPalette {4} {mediumvioletred}
\global\mapset plotPalette {5} {teal}
\global\mapset plotPalette {6} {goldenrod}
\global\mapset plotPalette {7} {slateblue}
\set plotPaletteLen {8}

// ---- Range and label declarations ----------------------------------------------
// Ranges are forced through \calc so the stored bounds are numbers. Labels and the
// title are stored as macros (like a document title), so they typeset when referenced
// and read as empty until set.
\def xrange a b {\set plotXmin {\calc{\a}}\set plotXmax {\calc{\b}}}
\def yrange a b {\set plotYmin {\calc{\a}}\set plotYmax {\calc{\b}}}
\def xstep s {\set plotxstepcfg {\calc{\s}}}
\def ystep s {\set plotystepcfg {\calc{\s}}}

\def plotxlabtext {}
\def plotylabtext {}
\def plottitletext {}
\def xlabel t {\def plotxlabtext {\t}}
\def ylabel t {\def plotylabtext {\t}}
\def plottitle t {\def plottitletext {\t}}

// Tick-label affixes: \xtickformat{prefix}{suffix} wraps every numeric x tick label, so
// $ before or % / k after a value reads naturally (e.g. $1.5M, 50%). The y axis has its
// own \ytickformat. Stored as macros so they typeset inline where a label is built.
\def plotxpre {}
\def plotxsuf {}
\def plotypre {}
\def plotysuf {}
\def xtickformat pre suf {\def plotxpre {\pre}\def plotxsuf {\suf}}
\def ytickformat pre suf {\def plotypre {\pre}\def plotysuf {\suf}}

// \xcategories{Jan Feb Mar …} — label the x axis with names instead of numbers. The
// categories sit at x = 1, 2, 3, …, and the x range is set to enclose them, so a series
// plotted at those integer x positions (bars especially) lines up under the labels.
\def xcategories list {
  \global\set plotXcatList {\seq{\list}}
  \global\set plotXcat {1}
  \global\set plotXcatN {\size{\plotXcatList}}
  \set xcatHi {\calc{plotXcatN + 0.5}}
  \xrange{0.5}{\xcatHi}
}

// ---- Auto-ranging --------------------------------------------------------------
// \autorange{x1 y1 x2 y2 …} derives the ranges from the data: \chunk pairs the flat list
// into points, one \transform pulls out each axis, and \minimum / \maximum bound it. x spans the data
// exactly, y is padded by 5% of its span (and pinned to a 0 baseline when the data is
// all non-negative, so bars and lines rest on the axis). Call it before \plot; an
// explicit \xrange / \yrange afterwards still overrides.
\def autorange data {
  \set plotARpts {\chunk{\seq{\data}}{2}}
  \set plotARxs {\transform\arP{\plotARpts}{\nth{\arP}{1}}}
  \set plotARys {\transform\arP{\plotARpts}{\nth{\arP}{2}}}
  \set plotARxmin {\minimum{\plotARxs}}
  \set plotARxmax {\maximum{\plotARxs}}
  \set plotARymin {\minimum{\plotARys}}
  \set plotARymax {\maximum{\plotARys}}
  \xrange{\plotARxmin}{\plotARxmax}
  \set plotARyspan {\calc{plotARymax - plotARymin}}
  \if {\< {\plotARyspan} {0.000001}} \set plotARyspan {1} \fi
  \set plotARylo {\calc{plotARymin - plotARyspan * 0.05}}
  \if {\>= {\plotARymin} {0}} \set plotARylo {0} \fi
  \set plotARyhi {\calc{plotARymax + plotARyspan * 0.05}}
  \yrange{\plotARylo}{\plotARyhi}
}

// ---- Device-coordinate mapping -------------------------------------------------
// \px{v} / \py{v} map a data coordinate to a device coordinate. The argument is any
// expression \calc can evaluate — a number, a variable under either spelling, or a call
// such as \nth{\pt}{1} — so a series maps a point straight out of the list it came from.
\def px v {\calc{plotOx + ((\v) - plotXmin) * plotSx}}
\def py v {\calc{plotOy + ((\v) - plotYmin) * plotSy}}

// The x and y of a two-value point, and the third value of a triple, named so a series
// reads as what it draws rather than as index arithmetic.
\def ptx p {\nth{\p}{1}}
\def pty p {\nth{\p}{2}}
\def ptz p {\nth{\p}{3}}

// ---- Nice tick step ------------------------------------------------------------
// Round a rough target step (the range over the desired number of intervals) up to the
// nearest 1, 2, or 5 times a power of ten, and answer it — the macro's value is the step,
// so a caller writes \set plotXstep {\plotNiceStep{\rough}}.
\def plotNiceStep raw {
  \set pnsMag {\calc{10 ^ floor(log(\raw))}}
  \set pnsNorm {\calc{(\raw) / pnsMag}}
  \if {\< {\pnsNorm} {1.5}} \calc{pnsMag}
  \else \if {\< {\pnsNorm} {3}} \calc{2 * pnsMag}
  \else \if {\< {\pnsNorm} {7}} \calc{5 * pnsMag}
  \else \calc{10 * pnsMag}
  \fi \fi \fi
}

// ---- Series colour and legend bookkeeping --------------------------------------
// Resolve a series colour: an explicit colour is used as given; `auto` takes the next
// palette entry and advances the cycle. The result lands in plotCurColor.
// A colour of `auto` — or an empty [] bracket, so a label can be given without naming
// a colour — takes the next palette entry; anything else is used as given.
\def plotResolveColor c {
  \set prcAuto {0}
  \if {\= {\c} {auto}} \set prcAuto {1} \fi
  \if {\< {\size{\c}} {1}} \set prcAuto {1} \fi
  \if {\= {\prcAuto} {1}}
    \set plotCurColor {\mapget plotPalette {\calc{plotSeriesIdx % plotPaletteLen}}}
    \global\set plotSeriesIdx {\calc{plotSeriesIdx + 1}}
  \else
    \set plotCurColor {\c}
  \fi}

// Record a legend entry (kind, colour, label) when a series was given a label. The
// entries accumulate in three index-keyed maps; \legend draws them.
\def plotRecord kind color label {
  \if {\> {\size{\label}} {0}}
    \global\mapset plotLegKind {\plotLegendN} {\kind}
    \global\mapset plotLegColor {\plotLegendN} {\color}
    \global\mapset plotLegLabel {\plotLegendN} {\label}
    \global\mapset plotLegShape {\plotLegendN} {\plotmarkshape}
    \global\set plotLegendN {\calc{plotLegendN + 1}}
  \fi}

// ---- The plot frame ------------------------------------------------------------
// \plot computes the transform and tick steps, resets the per-plot colour cycle and
// legend, opens a picture of the right size, draws the frame, and runs the series body
// on top. The group keeps the transform variables and label macros from leaking out.
\def plot body {{
  \global\set plotSeriesIdx {0}
  \global\set plotLegendN {0}

  \if {\> {\plotxstepcfg} {0}}
    \set plotXstep {\plotxstepcfg}
  \else
    \set plotXstep {\plotNiceStep{\calc{(plotXmax - plotXmin) / 5}}}
  \fi
  \if {\> {\plotystepcfg} {0}}
    \set plotYstep {\plotystepcfg}
  \else
    \set plotYstep {\plotNiceStep{\calc{(plotYmax - plotYmin) / 5}}}
  \fi

  \set plotMT {\plotmt}
  \if {\> {\size{\plottitletext}} {0}} \set plotMT {\calc{plotmt + 18}} \fi

  \set plotW {\plotareaw}
  \set plotH {\plotareah}
  \set plotOx {\plotml}
  \set plotOy {\plotmb}
  \set plotSx {\calc{plotW / (plotXmax - plotXmin)}}
  \set plotSy {\calc{plotH / (plotYmax - plotYmin)}}

  \picture width:{\calc{plotml + plotW + plotmr}} height:{\calc{plotmb + plotH + plotMT}} {
    \if {\= {\plotgrid} {1}} \plotDrawGrid \fi
    \plotDrawAxes
    \plotDrawZeroAxis
    \if {\= {\plotXcat} {1}} \plotDrawXCatTicks \else \plotDrawXTicks \fi
    \plotDrawYTicks
    \plotDrawMinorTicks
    \plotDrawLabels
    // The series body is clipped to the data area (unless plotclip is 0) so a curve or
    // marker that runs past the range does not spill into the margins.
    \if {\= {\plotclip} {1}}
      \group{
        \clip{ \moveto{\plotOx \plotOy}  \lineto{\calc{plotOx + plotW} \plotOy}
               \lineto{\calc{plotOx + plotW} \calc{plotOy + plotH}}
               \lineto{\plotOx \calc{plotOy + plotH}}  \close }
        \body
      }
    \else
      \body
    \fi
  }

  // Each plot is self-contained: clear the per-plot labels, title, categorical axis, and
  // any forced tick steps so the next \plot starts clean and nothing leaks from this one.
  \global\set plotxstepcfg {0}
  \global\set plotystepcfg {0}
  \global\set plotXcat {0}
  \gdef plotxlabtext {}
  \gdef plotylabtext {}
  \gdef plottitletext {}
  \gdef plotxpre {}
  \gdef plotxsuf {}
  \gdef plotypre {}
  \gdef plotysuf {}
}}

// The grid: faint lines at every tick position, drawn first so the data sits over
// them. plotNX / plotNY are the number of whole steps that fit in each range.
\def plotDrawGrid {
  \plotMinorGrid
  \nofill \stroke{\plotgridcolor} \linewidth{0.5pt}
  // Vertical grid lines align with the numeric x ticks; a categorical axis has no even
  // step, so it gets horizontal grid lines only.
  \if {\= {\plotXcat} {0}}
    \set plotNX {\calc{floor((plotXmax - plotXmin) / plotXstep + 0.0001)}}
    \for\i{\range{0}{\plotNX}}{
      \set gx {\calc{plotOx + (\i * plotXstep) * plotSx}}
      \line{\gx \plotOy  \gx \calc{plotOy + plotH}}
    }
  \fi
  \set plotNY {\calc{floor((plotYmax - plotYmin) / plotYstep + 0.0001)}}
  \for\j{\range{0}{\plotNY}}{
    \set gy {\calc{plotOy + (\j * plotYstep) * plotSy}}
    \line{\plotOx \gy  \calc{plotOx + plotW} \gy}
  }
}

// Minor grid lines: between the major ticks, at every plotxminor / plotyminor-th of a
// major step, skipping the positions that coincide with a major (a multiple of the
// subdivision count). Drawn before the major grid so the lighter lines sit behind it.
\def plotMinorGrid {
  \if {\= {\plotminorgrid} {1}}
    \nofill \stroke{\plotgridcolorminor} \linewidth{0.4pt}
    \if {\= {\plotXcat} {0}} \if {\> {\plotxminor} {0}}
      \set xmStep {\calc{plotXstep / plotxminor}}
      \set xmN {\calc{floor((plotXmax - plotXmin) / xmStep + 0.0001)}}
      \for\mm{\range{0}{\xmN}}{
        \if {\> {\calc{\mm % plotxminor}} {0}}
          \set xmx {\calc{plotOx + (\mm * xmStep) * plotSx}}
          \line{\xmx \plotOy  \xmx \calc{plotOy + plotH}}
        \fi
      }
    \fi \fi
    \if {\> {\plotyminor} {0}}
      \set ymStep {\calc{plotYstep / plotyminor}}
      \set ymN {\calc{floor((plotYmax - plotYmin) / ymStep + 0.0001)}}
      \for\mm{\range{0}{\ymN}}{
        \if {\> {\calc{\mm % plotyminor}} {0}}
          \set ymy {\calc{plotOy + (\mm * ymStep) * plotSy}}
          \line{\plotOx \ymy  \calc{plotOx + plotW} \ymy}
        \fi
      }
    \fi
  \fi}

// Minor tick marks: short ticks at the same positions as the minor grid, drawn after the
// major ticks. Independent of the grid, so they appear even with plotgrid 0.
\def plotDrawMinorTicks {
  \nofill \stroke{\plotaxiscolor} \linewidth{0.6pt}
  \set mtLen {\calc{plotticklen * 0.6}}
  \if {\= {\plotXcat} {0}} \if {\> {\plotxminor} {0}}
    \set xmStep {\calc{plotXstep / plotxminor}}
    \set xmN {\calc{floor((plotXmax - plotXmin) / xmStep + 0.0001)}}
    \for\mm{\range{0}{\xmN}}{
      \if {\> {\calc{\mm % plotxminor}} {0}}
        \set xmx {\calc{plotOx + (\mm * xmStep) * plotSx}}
        \line{\xmx \plotOy  \xmx \calc{plotOy - mtLen}}
      \fi
    }
  \fi \fi
  \if {\> {\plotyminor} {0}}
    \set ymStep {\calc{plotYstep / plotyminor}}
    \set ymN {\calc{floor((plotYmax - plotYmin) / ymStep + 0.0001)}}
    \for\mm{\range{0}{\ymN}}{
      \if {\> {\calc{\mm % plotyminor}} {0}}
        \set ymy {\calc{plotOy + (\mm * ymStep) * plotSy}}
        \line{\plotOx \ymy  \calc{plotOx - mtLen} \ymy}
      \fi
    }
  \fi}

// The two axes: the x axis along the bottom of the area, the y axis up its left.
\def plotDrawAxes {
  \nofill \stroke{\plotaxiscolor} \linewidth{0.8pt} \linecap{square}
  \line{\plotOx \plotOy  \calc{plotOx + plotW} \plotOy}
  \line{\plotOx \plotOy  \plotOx \calc{plotOy + plotH}}
}

// A light axis line at y = 0 (and x = 0) when the data range straddles zero, so a plot
// with negative values shows where the sign changes.
\def plotDrawZeroAxis {
  \if {\= {\plotzeroaxis} {1}}
    \if {\< {\plotYmin} {0}} \if {\> {\plotYmax} {0}}
      \nofill \stroke{\plotaxiscolor} \linewidth{0.6pt}
      \set zy {\calc{plotOy + (0 - plotYmin) * plotSy}}
      \line{\plotOx \zy  \calc{plotOx + plotW} \zy}
    \fi \fi
    \if {\< {\plotXmin} {0}} \if {\> {\plotXmax} {0}}
      \nofill \stroke{\plotaxiscolor} \linewidth{0.6pt}
      \set zx {\calc{plotOx + (0 - plotXmin) * plotSx}}
      \line{\zx \plotOy  \zx \calc{plotOy + plotH}}
    \fi \fi
  \fi}

// X tick marks and their numeric labels, set just below the axis.
\def plotDrawXTicks {
  \set plotNX {\calc{floor((plotXmax - plotXmin) / plotXstep + 0.0001)}}
  \nofill \stroke{\plotaxiscolor} \linewidth{0.8pt}
  \for\i{\range{0}{\plotNX}}{
    \set tickv {\calc{plotXmin + \i * plotXstep}}
    \set tickx {\calc{plotOx + (tickv - plotXmin) * plotSx}}
    \line{\tickx \plotOy  \tickx \calc{plotOy - plotticklen}}
    \at anchor:north {\tickx \calc{plotOy - plotticklen - 2}}{{\font {lmroman} {\plottickfontsize} {regular}\plotxpre\round{\tickv}{\plottickdec}\plotxsuf}}
  }
}

// Categorical x ticks: one tick per category name (from \xcategories), placed at the
// integer positions 1, 2, 3, … The 1-based \forloop.index is the category's x value.
\def plotDrawXCatTicks {
  \nofill \stroke{\plotaxiscolor} \linewidth{0.8pt}
  \for\catname{\plotXcatList}{
    \set ci {\forloop.index}
    \set ctx {\calc{plotOx + (ci - plotXmin) * plotSx}}
    \line{\ctx \plotOy  \ctx \calc{plotOy - plotticklen}}
    \at anchor:north {\ctx \calc{plotOy - plotticklen - 2}}{{\font {lmroman} {\plottickfontsize} {regular}\the\catname}}
  }
}

// Y tick marks and their numeric labels, set just left of the axis.
\def plotDrawYTicks {
  \set plotNY {\calc{floor((plotYmax - plotYmin) / plotYstep + 0.0001)}}
  \nofill \stroke{\plotaxiscolor} \linewidth{0.8pt}
  \for\j{\range{0}{\plotNY}}{
    \set tickv {\calc{plotYmin + \j * plotYstep}}
    \set ticky {\calc{plotOy + (tickv - plotYmin) * plotSy}}
    \line{\plotOx \ticky  \calc{plotOx - plotticklen} \ticky}
    \at anchor:east {\calc{plotOx - plotticklen - 3} \ticky}{{\font {lmroman} {\plottickfontsize} {regular}\plotypre\round{\tickv}{\plottickdec}\plotysuf}}
  }
}

// The x axis label (centred under the ticks), the y axis label (set vertically by
// rotating the coordinate system before placing it), and the title (over the top).
\def plotDrawLabels {
  \if {\> {\size{\plotxlabtext}} {0}}
    \at anchor:north {\calc{plotOx + plotW / 2} \calc{plotOy - plotticklen - plottickfontsize - 8}}{{\font {lmroman} {\plotlabelfontsize} {regular}\plotxlabtext}}
  \fi
  \if {\> {\size{\plotylabtext}} {0}}
    \group{
      \translate{\calc{plotOx - plotml + 12} \calc{plotOy + plotH / 2}}
      \rotate{90}
      \at anchor:south {0 0}{{\font {lmroman} {\plotlabelfontsize} {regular}\plotylabtext}}
    }
  \fi
  \if {\> {\size{\plottitletext}} {0}}
    \at anchor:north {\calc{plotOx + plotW / 2} \calc{plotOy + plotH + plotMT - 4}}{{\font {lmroman} {\plottitlefontsize} {bold}\plottitletext}}
  \fi
}

// ---- Data series ---------------------------------------------------------------
// Every series reads the same flat "x1 y1 x2 y2 …" list. \chunk groups it into points —
// pairs, or triples where a third value carries a size or an error — and \for steps
// them, with \forloop.first telling the first point from the rest where a path has to
// begin before it can continue. \ptx / \pty / \ptz name the values of a point, and
// \px / \py map them, so a series body reads as the shape it draws.

// \lineplot[colour][label]{data} — a polyline through the data points.
\def lineplot [color:auto] [label:] data {{
  \plotResolveColor{\color}
  \plotRecord{line}{\plotCurColor}{\label}
  \nofill \stroke{\plotCurColor} \linewidth{1.4pt} \linejoin{round} \linecap{round}
  \path{
    \for\pt{\chunk{\seq{\data}}{2}}{
      \if {\forloop.first}
        \moveto{\px{\ptx{\pt}} \py{\pty{\pt}}}
      \else
        \lineto{\px{\ptx{\pt}} \py{\pty{\pt}}}
      \fi
    }
  }
}}

// \areaplot[colour][label]{data} — the band between the polyline and a baseline, filled.
// The baseline is zero when the y range includes it, otherwise the bottom of the area.
\def areaplot [color:auto] [label:] data {{
  \plotResolveColor{\color}
  \plotRecord{bar}{\plotCurColor}{\label}
  \set plotBaseY {\plotYmin}
  \if {\< {\plotYmin} {0}} \if {\> {\plotYmax} {0}} \set plotBaseY {0} \fi \fi
  \fill{\plotCurColor} \nostroke
  \path{\plotAreaPath{\chunk{\seq{\data}}{2}}}
}}
// The band is one closed path: up to the first point from the baseline, along the data,
// then down to the baseline under the last point. Both ends come straight out of the
// point list — \head and \last — rather than being remembered during a walk.
\def plotAreaPath pts {
  \moveto{\px{\ptx{\head{\pts}}} \py{plotBaseY}}
  \for\pt{\pts}{\lineto{\px{\ptx{\pt}} \py{\pty{\pt}}}}
  \lineto{\px{\ptx{\last{\pts}}} \py{plotBaseY}}
  \close}

// \stepplot[colour][label]{data} — a staircase line that holds each value until the next
// x, for piecewise-constant or cumulative data. From a point it goes horizontally to the
// next x, then vertically to the next value.
\def stepplot [color:auto] [label:] data {{
  \plotResolveColor{\color}
  \plotRecord{line}{\plotCurColor}{\label}
  \nofill \stroke{\plotCurColor} \linewidth{1.4pt} \linejoin{miter} \linecap{butt}
  \path{
    \set stepPts {\chunk{\seq{\data}}{2}}
    \for\pt{\stepPts}{
      \if {\forloop.first}
        \moveto{\px{\ptx{\pt}} \py{\pty{\pt}}}
      \else
        // hold the previous value across to this x, then step to this one. The 0-based
        // \forloop.indexz is the 1-based position of the point before this one.
        \lineto{\px{\ptx{\pt}} \py{\pty{\nth{\stepPts}{\forloop.indexz}}}}
        \lineto{\px{\ptx{\pt}} \py{\pty{\pt}}}
      \fi
    }
  }
}}

// \scatter[colour][label]{data} — a marker at each data point, shaped by plotmarkshape.
\def scatter [color:auto] [label:] data {{
  \plotResolveColor{\color}
  \plotRecord{marker}{\plotCurColor}{\label}
  \fill{\plotCurColor} \nostroke
  \for\pt{\chunk{\seq{\data}}{2}}{\plotMarker{\px{\ptx{\pt}}}{\py{\pty{\pt}}}}
}}

// Draw one marker of the current shape, centred on the device point (cx, cy).
\def plotMarker cx cy {
  \if {\= {\plotmarkshape} {square}}
    \rect{\calc{\cx - plotmarkr} \calc{\cy - plotmarkr} \calc{2 * plotmarkr} \calc{2 * plotmarkr}}
  \else \if {\= {\plotmarkshape} {triangle}}
    \polygon{\calc{\cx} \calc{\cy + plotmarkr * 1.2}
             \calc{\cx - plotmarkr * 1.1} \calc{\cy - plotmarkr * 0.9}
             \calc{\cx + plotmarkr * 1.1} \calc{\cy - plotmarkr * 0.9}}
  \else \if {\= {\plotmarkshape} {diamond}}
    \polygon{\calc{\cx} \calc{\cy + plotmarkr * 1.3}  \calc{\cx + plotmarkr * 1.3} \calc{\cy}
             \calc{\cx} \calc{\cy - plotmarkr * 1.3}  \calc{\cx - plotmarkr * 1.3} \calc{\cy}}
  \else
    \circle{\calc{\cx} \calc{\cy} \plotmarkr}
  \fi \fi \fi}

// \bubble[colour][label]{x y size  x y size  …} — a scatter whose third value at each
// point sets the marker's size, drawn as a translucent disc so overlapping bubbles show
// through one another. The size values map to a radius between plotbubblemin and
// plotbubblemax with *area* (not radius) proportional to the value — the perceptually
// honest scaling. The discs are drawn inside a \group so the fill opacity set here does
// not leak to a later series.
\def bubble [color:auto] [label:] data {{
  \plotResolveColor{\color}
  \plotRecord{bubble}{\plotCurColor}{\label}
  \set bbPts {\chunk{\seq{\data}}{3}}
  // The size values bound the radius range. A degenerate (all-equal) span would divide
  // by zero, so it is floored at 1 and every bubble then comes out the smallest size.
  \set bbSizes {\transform\b{\bbPts}{\ptz{\b}}}
  \set bbSmin {\minimum{\bbSizes}}
  \set bbSpan {\calc{\maximum{\bbSizes} - bbSmin}}
  \if {\< {\bbSpan} {0.000001}} \set bbSpan {1} \fi
  \group{
    \fill{\plotCurColor} \stroke{\plotCurColor} \linewidth{0.6pt}
    \fillopacity{\plotbubbleopacity} \strokeopacity{0.9}
    // The radius is sqrt(rmin² + (rmax² − rmin²)·t) so the disc *area* rises linearly with
    // the size value between the two configured limits — the perceptually honest scaling.
    \for\b{\bbPts}{
      \set bbt {\calc{(\ptz{\b} - bbSmin) / bbSpan}}
      \circle{\px{\ptx{\b}} \py{\pty{\b}}
              \calc{sqrt(plotbubblemin * plotbubblemin + (plotbubblemax * plotbubblemax - plotbubblemin * plotbubblemin) * bbt)}}
    }
  }
}}

// \bars[colour][label]{data} — a vertical bar from the axis up to each data point,
// centred on its x value and a fixed fraction of the x step wide.
\def bars [color:auto] [label:] data {{
  \plotResolveColor{\color}
  \plotRecord{bar}{\plotCurColor}{\label}
  \fill{\plotCurColor} \nostroke
  \set plotBarHW {\calc{plotbarfrac * plotXstep * plotSx / 2}}
  \for\pt{\chunk{\seq{\data}}{2}}{
    \set barx {\px{\ptx{\pt}}}
    \set bartop {\py{\pty{\pt}}}
    \rect{\calc{barx - plotBarHW} \plotOy  \calc{2 * plotBarHW} \calc{bartop - plotOy}}
    \if {\= {\plotvalues} {1}}
      \at anchor:south {\barx \calc{bartop + 2}}{{\font {lmroman} {\plottickfontsize} {regular}\round{\pty{\pt}}{\plottickdec}}}
    \fi
  }
}}

// \fnplot[colour][label]{expression} — sample a function of x across the domain and
// stroke it. The expression is ordinary \calc arithmetic written in terms of x.
\def fnplot [color:auto] [label:] expr {{
  \plotResolveColor{\color}
  \plotRecord{line}{\plotCurColor}{\label}
  \nofill \stroke{\plotCurColor} \linewidth{1.6pt} \linejoin{round}
  \path{
    \for\k{\range{0}{\plotsamples}}{
      \set x {\calc{plotXmin + \k * (plotXmax - plotXmin) / plotsamples}}
      \set fy {\calc{\expr}}
      \if {\= {\k} {0}} \moveto{\px{x} \py{fy}} \else \lineto{\px{x} \py{fy}} \fi
    }
  }
}}

// \errorbars[colour][label]{x y err  x y err  …} — a vertical whisker at each point
// spanning y±err, with a short cap at each end. Usually drawn over a \scatter or
// \lineplot of the same x y values.
\def errorbars [color:auto] [label:] data {{
  \plotResolveColor{\color}
  \plotRecord{line}{\plotCurColor}{\label}
  \nofill \stroke{\plotCurColor} \linewidth{1pt} \linecap{butt}
  \for\e{\chunk{\seq{\data}}{3}}{
    \set ebcx {\px{\ptx{\e}}}
    \set ebLo {\py{\calc{\pty{\e} - \ptz{\e}}}}
    \set ebHi {\py{\calc{\pty{\e} + \ptz{\e}}}}
    \line{\ebcx \ebLo  \ebcx \ebHi}
    \line{\calc{ebcx - ploterrcap} \ebLo  \calc{ebcx + ploterrcap} \ebLo}
    \line{\calc{ebcx - ploterrcap} \ebHi  \calc{ebcx + ploterrcap} \ebHi}
  }
}}

// \trendline[colour][label]{x y x y …} — the least-squares line of best fit through the
// data, drawn dashed across the x range. The fit accumulates n, Σx, Σy, Σxy, Σx² over the
// points (a fold), then slope = (nΣxy − ΣxΣy) / (nΣx² − (Σx)²) and intercept = (Σy −
// slope·Σx) / n. The clip keeps the line inside the data area.
\def trendline [color:auto] [label:] data {{
  \plotResolveColor{\color}
  \plotRecord{line}{\plotCurColor}{\label}
  \plotTrendSums{\seq{\data}}
  \set tlSlope {\calc{(tlN * tlSxy - tlSx * tlSy) / (tlN * tlSxx - tlSx * tlSx)}}
  \set tlInt {\calc{(tlSy - tlSlope * tlSx) / tlN}}
  \set tlYZero {\calc{tlSlope * plotXmin + tlInt}}
  \set tlYOne {\calc{tlSlope * plotXmax + tlInt}}
  \nofill \stroke{\plotCurColor} \linewidth{1.4pt} \linetype{dashed}
  \line{\px{plotXmin} \py{tlYZero}  \px{plotXmax} \py{tlYOne}}
  \linetype{solid}
}}
// The five sums a least-squares fit needs, each a \total of one \transform over the points
// rather than a running \global accumulator.
\def plotTrendSums items {
  \set tlPts {\chunk{\items}{2}}
  \set tlN {\size{\tlPts}}
  \set tlSx {\total{\transform\q{\tlPts}{\ptx{\q}}}}
  \set tlSy {\total{\transform\q{\tlPts}{\pty{\q}}}}
  \set tlSxy {\total{\transform\q{\tlPts}{\calc{\ptx{\q} * \pty{\q}}}}}
  \set tlSxx {\total{\transform\q{\tlPts}{\calc{\ptx{\q} * \ptx{\q}}}}}
}

// \bandplot[colour][label]{x lo hi  x lo hi  …} — the band between a lower and an upper
// value at each x, filled translucently. It is the shape of a confidence interval or a
// min/max envelope, and is usually drawn *before* the \lineplot it belongs to so the line
// sits on top of it. One closed path: forward along the upper edge, then back along the
// lower — which is what \reverse over the points gives, with no second walk to write.
\def bandplot [color:auto] [label:] data {{
  \plotResolveColor{\color}
  \plotRecord{bar}{\plotCurColor}{\label}
  \set bandPts {\chunk{\seq{\data}}{3}}
  \group{
    \fill{\plotCurColor} \nostroke \fillopacity{\plotbandopacity}
    \path{
      \for\b{\bandPts}{
        \if {\forloop.first}
          \moveto{\px{\ptx{\b}} \py{\ptz{\b}}}
        \else
          \lineto{\px{\ptx{\b}} \py{\ptz{\b}}}
        \fi
      }
      \for\b{\reverse{\bandPts}}{\lineto{\px{\ptx{\b}} \py{\pty{\b}}}}
      \close
    }
  }
}}

// ---- Histogram -----------------------------------------------------------------
// \histogram[colour][label]{v v v …} — bin a flat list of *values* (not points) into
// plothistbins equal-width bins and draw the counts as bars. Unlike every other series
// this one takes raw observations and derives both axes from them, so \histrange sets the
// ranges the same way \autorange does for point data.
//
// The binning is a fold, not a walk: each value's bin is floor((v − lo) / w), clamped so
// the maximum falls in the last bin rather than one past the end, and the count of a bin
// is the size of the values that land in it.
\def plotHistBins values {
  \set histVals {\seq{\values}}
  \set histLo {\minimum{\histVals}}
  \set histHi {\maximum{\histVals}}
  \set histW {\calc{(histHi - histLo) / plothistbins}}
  \if {\< {\histW} {0.000001}} \set histW {1} \fi
  \set histCounts {\transform\k{\range{0}{\calc{plothistbins - 1}}}{\size{\filter\v{\histVals}{\= {\calc{min(plothistbins - 1, floor((v - histLo) / histW))}} {\k}}}}}
}

// \histrange{v v v …} — set the ranges to hold the histogram: x spans the values, y runs
// from zero to a little above the tallest bin. Call it before \plot, as \autorange is.
\def histrange values {
  \plotHistBins{\values}
  \xrange{\histLo}{\histHi}
  \yrange{0}{\calc{\maximum{\histCounts} * 1.05}}
}

\def histogram [color:auto] [label:] values {{
  \plotResolveColor{\color}
  \plotRecord{bar}{\plotCurColor}{\label}
  \plotHistBins{\values}
  \fill{\plotCurColor} \stroke{white} \linewidth{0.5pt}
  \for\c{\histCounts}{
    \set hbLeft {\px{\calc{histLo + \forloop.indexz * histW}}}
    \rect{\hbLeft \plotOy  \calc{histW * plotSx} \calc{\py{\c} - plotOy}}
  }
}}

// ---- Annotations ---------------------------------------------------------------
// \annotate[colour]{x}{y}{text} — set a short label at a data point, just above it. The
// position is in *data* coordinates, so a note stays with its point when the range
// changes. With no colour it takes plotreflcolor, as the reference lines do.
\def annotate [col:?] x y text {
  \plotReflColor{\col}
  \at anchor:south {\px{\x} \calc{\py{\y} + 4}}{{\font {lmroman} {\plottickfontsize} {regular}\color{\plotCurColor}\text}}}

// ---- Reference lines -----------------------------------------------------------
// \hline[colour]{y} / \vline[colour]{x} draw a dashed line across the plot at a data
// value — a threshold, a target, a mean — mapped through the same transform. With no
// colour they use plotreflcolor.
\def hline [color:?] y {
  \plotReflColor{\color}
  \nofill \stroke{\plotCurColor} \linewidth{0.8pt} \linetype{dashed}
  \line{\plotOx \calc{plotOy + ((\y) - plotYmin) * plotSy}  \calc{plotOx + plotW} \calc{plotOy + ((\y) - plotYmin) * plotSy}}
  \linetype{solid}}
\def vline [color:?] x {
  \plotReflColor{\color}
  \nofill \stroke{\plotCurColor} \linewidth{0.8pt} \linetype{dashed}
  \line{\calc{plotOx + ((\x) - plotXmin) * plotSx} \plotOy  \calc{plotOx + ((\x) - plotXmin) * plotSx} \calc{plotOy + plotH}}
  \linetype{solid}}
\def plotReflColor c {
  \if {\= {\c} {?}} \set plotCurColor {\plotreflcolor} \else \set plotCurColor {\c} \fi}

// ---- Legend --------------------------------------------------------------------
// \legend[pos] draws the entries recorded by series given a label, stacked in a corner
// of the data area: ne (default), nw, se, sw. Each row is a colour swatch — a line, a
// marker, or a filled square according to the series kind — beside the label.
\def legend [pos:ne] {
  \if {\> {\plotLegendN} {0}}
    \set legLast {\calc{plotLegendN - 1}}

    // Measure the widest label (\setbox into a box register, then \wd) so the legend box is
    // sized to its contents rather than a guessed fixed width.
    \set legMaxW {\maximum{\transform\lm{\range{0}{\legLast}}{\plotLabelWidth{\lm}}}}
    \set legContentW {\calc{plotlegswatch + 6 + legMaxW}}

    \if {\= {\pos} {nw}} \set legLeft {\calc{plotOx + plotleginset}}
    \else \if {\= {\pos} {sw}} \set legLeft {\calc{plotOx + plotleginset}}
    \else \set legLeft {\calc{plotOx + plotW - plotleginset - legContentW}}
    \fi \fi
    \if {\= {\pos} {sw}} \set legTop {\calc{plotOy + plotleginset + plotLegendN * plotlegrow}}
    \else \if {\= {\pos} {se}} \set legTop {\calc{plotOy + plotleginset + plotLegendN * plotlegrow}}
    \else \set legTop {\calc{plotOy + plotH - plotleginset}}
    \fi \fi
    \set legBoxH {\calc{plotLegendN * plotlegrow}}
    \fill{white} \stroke{gainsboro} \linewidth{0.5pt}
    \rect{\calc{legLeft - 5} \calc{legTop - legBoxH}  \calc{legContentW + 10} \legBoxH}
    \for\li{\range{0}{\legLast}}{
      \set legRowY {\calc{legTop - \li * plotlegrow - plotlegrow / 2}}
      \set legK {\mapget plotLegKind {\li}}
      \set legC {\mapget plotLegColor {\li}}
      \set legLbl {\mapget plotLegLabel {\li}}
      \set plotmarkshape {\mapget plotLegShape {\li}}
      \plotLegendSwatch{\legK}{\legC}{legLeft}{legRowY}
      \at anchor:west {\calc{legLeft + plotlegswatch + 5} \legRowY}{{\font {lmroman} {\plottickfontsize} {regular}\the\legLbl}}
    }
  \fi}

// The set width of legend entry n's label, in points.
\def plotLabelWidth n {\set plwLbl {\mapget plotLegLabel {\n}}\setbox plotLegBox \hbox{\font {lmroman} {\plottickfontsize} {regular}\the\plwLbl}\wd plotLegBox}

// One legend swatch at the device point (lx, ry): a short line for line and
// function series, the current marker for scatter series, a small filled square for bars.
\def plotLegendSwatch kind color lx ry {
  \if {\= {\kind} {bar}}
    \fill{\color} \nostroke
    \rect{\calc{\lx} \calc{\ry - 4} \plotlegswatch 8}
  \else \if {\= {\kind} {bubble}}
    \fill{\color} \nostroke
    \circle{\calc{\lx + plotlegswatch / 2} \calc{\ry} 4}
  \else \if {\= {\kind} {marker}}
    \fill{\color} \nostroke
    \set legSwCx {\calc{\lx + plotlegswatch / 2}}
    \plotMarker{legSwCx}{\ry}
  \else
    \nofill \stroke{\color} \linewidth{2pt} \linecap{round}
    \line{\calc{\lx} \calc{\ry}  \calc{\lx + plotlegswatch} \calc{\ry}}
  \fi \fi \fi}
