// music — staff notation set in a SMuFL (Standard Music Font Layout) music font over the \picture vector
// layer. SMuFL fixes the codepoint of every notation glyph and the convention that one staff space is a
// quarter of the em, so the package works with any SMuFL face; \set musicfont {…} chooses it (bravura is the
// reference font and the default; petaluma is a handwritten-style alternative). Import it with:
//
//     \use{music}
//
// A line of music is drawn by \score, whose body is a space-separated list of notes:
//
//     \score{c d e f g a b c'}
//     \score{e4 d4 c4 d4 | e4 e4 e2}
//
// A note is an optional accidental, a letter a–g, optional octave marks, then an optional duration digit:
//   - + - n    an accidental — sharp, flat, or natural — drawn just left of the head (it changes how the
//              note reads, not where it sits, so +c and c share a line)
//   - letter   the pitch class; lowercase c is middle C (one ledger line below the staff)
//   - ' or ,   raise / lower by an octave, repeatable (c' is the C above, c, the C below)
//   - 1 2 4 8  the duration — whole, half, quarter (the default), or eighth note
// `r` is a rest and `|` a barline. `[` and `]` bracket a run of notes joined by one beam instead of flags.
// So `g,2` is the G below middle C held for a half note, `+c'8` the C-sharp an octave up as an eighth, and
// `[ c d e f ]` four beamed notes. A time signature is drawn from \musictimenum / \musictimeden (see below).
//
// Heads, clefs, flags, rests, accidentals and time-signature figures are real engraved glyphs from the music
// font, stamped with \fontglyph; stems, beams, staff lines, ledger lines and barlines are ruled. Since one
// staff space is a quarter of the em, the font is set at a size of four staff spaces (\set fs inside \score)
// and its own coordinates fall straight onto the staff.

// ---- Configuration (override with \set after \use, before \score) ---------------
// Sizes are in points (72 per inch).
\set musicgap {8}          // space between adjacent staff lines — the staff space, the unit everything scales from
\set musicnote {22}        // horizontal advance from one note to the next
\set musicleft {44}        // x of the first note — leaves room for the clef
\set musicpad {30}         // vertical room above and below the staff for ledger lines, stems and flags
\set musiccolor {black}
\set musicfont {bravura}   // the SMuFL music font to set the glyphs in — any loaded SMuFL face (bravura, petaluma, …)
\set musicclef {treble}    // treble, bass, alto, or tenor; chooses the clef and how pitches sit on the staff
\set musictimenum {}       // time-signature numerator, drawn after the clef (e.g. {3}); empty for no signature
\set musictimeden {}       // time-signature denominator (e.g. {4})
\set musickey {0}          // key signature: a signed count — positive = that many sharps, negative = flats (0 none)
// c d e f g a b -> 0..6, the diatonic step of each pitch class within an octave.
\set musicLetters {\map{c 0 d 1 e 2 f 3 g 4 a 5 b 6}}

// Key-signature accidental positions, as diatonic steps above the bottom staff line, in the order the signs are
// written: sharps F C G D A E B, flats B E A D G C F. The treble and bass staves place them differently, so each
// has its own row. (Bottom line is step 0; a line or space is one step.) A key signature takes the first |musickey|
// of the matching row.
\set musicSharpStepsTreble {\seq{8 5 9 6 3 7 4}}
\set musicFlatStepsTreble  {\seq{4 7 3 6 2 5 1}}
\set musicSharpStepsBass   {\seq{6 3 7 4 1 5 2}}
\set musicFlatStepsBass    {\seq{2 5 1 4 0 3 -1}}
\set musicSharpStepsAlto   {\seq{7 4 8 5 2 6 3}}
\set musicFlatStepsAlto    {\seq{3 6 2 5 1 4 0}}

// ---- SMuFL codepoints ----------------------------------------------------------
// The Private-Use codepoints of the glyphs this package stamps. Names follow the SMuFL glyph registry.
\set cpGClef {57424}            // U+E050 gClef
\set cpFClef {57442}            // U+E062 fClef
\set cpCClef {57436}            // U+E05C cClef (alto / tenor)
\set cpNoteWhole {57506}        // U+E0A2 noteheadWhole
\set cpNoteHalf {57507}         // U+E0A3 noteheadHalf
\set cpNoteBlack {57508}        // U+E0A4 noteheadBlack
// Note these glyph names spell their durations out (Eighth, Sixteenth) rather than using 8/16: a control
// sequence is letters only, so \cpFlag8Up would tokenize as \cpFlag followed by the text 8Up and silently
// resolve to nothing. Letter-only names stay safe to reference with a backslash anywhere.
\set cpEighthFlagUp {57920}     // U+E240 flag8thUp
\set cpEighthFlagDown {57921}   // U+E241 flag8thDown
\set cpSixteenthFlagUp {57922}  // U+E242 flag16thUp
\set cpSixteenthFlagDown {57923} // U+E243 flag16thDown
\set cpAugDot {57831}           // U+E1E7 augmentationDot
\set cpRestWhole {58595}        // U+E4E3 restWhole
\set cpRestHalf {58596}         // U+E4E4 restHalf
\set cpRestQuarter {58597}      // U+E4E5 restQuarter
\set cpEighthRest {58598}       // U+E4E6 rest8th
\set cpAccFlat {57952}          // U+E260 accidentalFlat
\set cpAccNatural {57953}       // U+E261 accidentalNatural
\set cpAccSharp {57954}         // U+E262 accidentalSharp
\set cpTimeDigitBase {57472}    // U+E080 timeSig0; a digit d is at cpTimeDigitBase + d

// ---- The score -----------------------------------------------------------------
// \score sizes a picture to hold the notes, draws the five staff lines and the clef, then walks the note
// list left to right. The bottom staff line sits at y = musicpad; a pitch's vertical position is half the
// staff space per diatonic step above it. The font size fs is four staff spaces, so a SMuFL glyph's own
// units (where the staff space is a quarter of the em) come out one staff space = musicgap points.
\def score notes {{
  \set msList {\seq{\notes}}
  \set msN {\size{\msList}}
  \set g {\musicgap}
  \set fs {\calc{4 * g}}

  // The notehead's actual width (points), read from the chosen music font, so a stem seats on the head's right
  // edge and a ledger line spans the head whatever font is in use — no per-font constants. (A black and a half
  // notehead share a width, so one measurement covers every stemmed note.)
  \set msHeadW {\glyphwidth{\musicfont}{\fs}{\cpNoteBlack}}
  \set msStemHalf {\calc{0.06 * g}}
  // The head is tilted, so its right tip (where an up-stem joins) sits a little above centre and its left tip a
  // little below. Pull the stem foot this far toward that tip so the stem meets the head instead of starting at
  // dead centre and overshooting past the tip — a small amount that reads well across SMuFL fonts.
  \set msStemAttach {\calc{0.2 * g}}

  \set msBottom {\musicpad}
  \set msTop {\calc{msBottom + 4 * g}}
  \set msMiddle {\calc{msBottom + 2 * g}}
  \set msH {\calc{msBottom + 4 * g + musicpad}}

  // The leading area runs clef → key signature → time signature → notes, each taking the room it needs so the
  // next clears it. The key signature is |musickey| accidentals at 0.9 staff-space steps; the time signature a
  // column wide enough for its longest row of figures. The first note sits past all of it (but no closer than
  // musicleft, which still controls the spacing when there is neither a key nor a time signature).
  \set msKeyX {\calc{4.8 * g}}
  \set msKeyN {\calc{musickey}}
  \if {\< {\msKeyN} {0}} \set msKeyN {\calc{0 - msKeyN}} \fi
  // Key signatures are placed for treble, bass and alto; the tenor C-clef's layout is irregular, so it reserves
  // no key-signature column (a key set with the tenor clef is simply not drawn).
  \if {\= {\musicclef} {tenor}} \set msKeyN {0} \fi
  \set msKeyW {\calc{msKeyN * 0.9 * g}}
  \set msTimeX {\calc{msKeyX + msKeyW + 0.5 * g}}
  \set msTimeW {0}
  \if {\size{\cat{\musictimenum}{}}}
    \set msTimeLen {\size{\cat{\musictimenum}{}}}
    \if {\< {\msTimeLen} {\size{\cat{\musictimeden}{}}}} \set msTimeLen {\size{\cat{\musictimeden}{}}} \fi
    \set msTimeW {\calc{msTimeLen * 1.4 * g}}
  \fi
  \set msFirstX {\calc{msTimeX + msTimeW + 0.6 * g}}
  \if {\< {\msFirstX} {\musicleft}} \set msFirstX {\musicleft} \fi

  \set msW {\calc{msFirstX + msN * musicnote + 12}}

  // msBeam is 1 while a [ … ] run is open. The beam itself is not flat: when a run opens, its line (a start
  // height and a per-note slope) is measured from the run's pitches, so the beam tilts to follow the melody.
  \set msBeam {0}

  // The diatonic step of the bottom line, used to place every pitch: E4 (index 2) on the treble staff, G2
  // (index -10) on the bass, F3 (-4) on the alto, D3 (-6) on the tenor. A note's index is msOct*7 + its pitch
  // class; its step above the bottom line is that index minus this base, and half the staff space per step
  // gives its height. Middle C sits on the middle line in the alto clef, the fourth line in the tenor.
  \set msBase {2}
  \if {\= {\musicclef} {bass}} \set msBase {-10}
  \else \if {\= {\musicclef} {alto}} \set msBase {-4}
  \else \if {\= {\musicclef} {tenor}} \set msBase {-6}
  \fi \fi \fi

  \picture width:{\msW} height:{\msH} {
    \musicStaffLines
    \musicClef
    \musicKeySig
    \musicTimeSig
    \set msX {\msFirstX}
    \musicWalk{\msList}
  }
}}

// The five staff lines, spanning the full width, at the SMuFL staff-line thickness. They begin half a staff
// space in from the picture edge, leaving the clef room to sit inside the staff rather than off its left end.
\def musicStaffLines {
  \nofill \stroke{\musiccolor} \linewidth{\calc{0.13 * g}}
  \for\i{\range{0}{4}}{
    \set ly {\calc{msBottom + \i * g}}
    \line{\calc{0.5 * g} \ly  \calc{msW - 10} \ly}
  }}

// Walk the note list, advancing msX. A barline advances less than a note. `[` and `]` open and close a beamed
// run: the notes between them share one beam, tilted to follow the melody, instead of carrying flags. Several
// barline kinds are written
// as their own tokens: `|` plain, `||` double, `|.` final, `|:` and `:|` the start and end of a repeat.
\def musicWalk items {
  \if {\size{\items}}
    \set tok {\head{\items}}
    \if {\= {\tok} {[}}
      \global\set msBeam {1}
      \global\set msBeamPrev {0}
      \musicBeamLine{\tail{\items}}
    \else \if {\= {\tok} {]}}
      \global\set msBeam {0}
    \else \if {\= {\tok} {|}}
      \musicBarThin{\msX}
      \set msX {\calc{msX + musicnote * 0.6}}
    \else \if {\= {\tok} {||}}
      \musicBarDouble
      \set msX {\calc{msX + musicnote * 0.7}}
    \else \if {\= {\tok} {|.}}
      \musicBarFinal
      \set msX {\calc{msX + musicnote * 0.8}}
    \else \if {\= {\tok} {|:}}
      \musicBarRepeatStart
      \set msX {\calc{msX + musicnote}}
    \else \if {\= {\tok} {:|}}
      \musicBarRepeatEnd
      \set msX {\calc{msX + musicnote * 0.9}}
    \else
      \musicNote{\tok}
      \set msX {\calc{msX + musicnote}}
    \fi \fi \fi \fi \fi \fi \fi
    \musicWalk{\tail{\items}}
  \fi}

// ---- Barlines ------------------------------------------------------------------
// The pieces every barline kind is built from: a thin rule, a thick rule, and the pair of repeat dots in the
// two middle spaces. Each takes its x so a compound barline can place several side by side.
\def musicBarThin x {
  \nofill \stroke{\musiccolor} \linewidth{\calc{0.16 * g}}
  \line{\x \msBottom  \x \msTop}}

\def musicBarThick x {
  \nofill \stroke{\musiccolor} \linewidth{\calc{0.5 * g}}
  \line{\x \msBottom  \x \msTop}}

\def musicBarDots x {
  \fill{\musiccolor} \nostroke
  \circle{\x \calc{msBottom + 1.5 * g} \calc{0.22 * g}}
  \circle{\x \calc{msBottom + 2.5 * g} \calc{0.22 * g}}}

// A double barline (two thin rules), a final barline (a thin rule then a thick one), and the two repeat
// barlines (a thick and thin rule with the dots on the inside of the repeated span).
\def musicBarDouble {
  \musicBarThin{\msX}
  \musicBarThin{\calc{msX + 0.45 * g}}}

\def musicBarFinal {
  \musicBarThin{\msX}
  \musicBarThick{\calc{msX + 0.55 * g}}}

\def musicBarRepeatStart {
  \musicBarThick{\msX}
  \musicBarThin{\calc{msX + 0.55 * g}}
  \musicBarDots{\calc{msX + 0.95 * g}}}

\def musicBarRepeatEnd {
  \musicBarDots{\msX}
  \musicBarThin{\calc{msX + 0.4 * g}}
  \musicBarThick{\calc{msX + 0.95 * g}}}

// ---- One note ------------------------------------------------------------------
// Parse the token into pitch class, octave offset, and duration; place the head; then the stem and flag
// (for half notes and shorter), and any ledger lines. msX is the left edge of the head; the head glyph is
// stamped origin-on-point with a baseline anchor, since a notehead's origin is its left edge on the line.
\def musicNote tok {
  \musicParse{\tok}
  \if {\= {\msLetter} {r}}
    \musicRest
  \else
    \set li {\mapget musicLetters {\msLetter}}
    \set step {\calc{msOct * 7 + li - msBase}}
    \set ny {\calc{msBottom + step * g / 2}}
    \musicLedgers{\step}
    \musicAccidental
    // The head: a black notehead for a quarter or shorter, an open half-note head, or a whole-note head.
    \fill{\musiccolor} \nostroke
    \if {\>= {\msDur} {4}} \set msHead {\cpNoteBlack}
    \else \if {\= {\msDur} {2}} \set msHead {\cpNoteHalf}
    \else \set msHead {\cpNoteWhole} \fi \fi
    \fontglyph anchor:baseline {\msX \ny}{\musicfont}{\fs}{\msHead}
    \musicDot
    // The stem and any flag. In a beamed run every note shares one flat beam; otherwise the stem rises on
    // the right of low notes and falls on the left of high ones, flipping at the middle line, and a flagged
    // note (eighth or shorter) gets its own flag. A whole note has no stem at all.
    \if {\= {\msBeam} {1}}
      \musicBeamedStem
    \else \if {\>= {\msDur} {2}}
      \musicStem
    \fi \fi
  \fi}

// An augmentation dot, drawn right of the head for a dotted note. A dot belongs in a space, so when the head
// sits on a line (an even step) the dot is nudged up into the space above; in a space it stays on the line.
\def musicDot {
  \if {\= {\msDot} {1}}
    \fill{\musiccolor} \nostroke
    \set msDotY {\ny}
    \if {\= {\calc{step - 2 * floor(step / 2)}} {0}} \set msDotY {\calc{ny + g / 2}} \fi
    \fontglyph anchor:west {\calc{msX + msHeadW + 0.35 * g} \msDotY}{\musicfont}{\fs}{\cpAugDot}
  \fi}

// The stem and, for an eighth note, its flag. A note below the middle line stems up on the head's right edge,
// one at or above it stems down on its left; the stem meets the head at its centre height. The head's right
// edge comes from the font (msHeadW), so the stem seats correctly whatever music font is in use.
\def musicStem {
  \nofill \stroke{\musiccolor} \linewidth{\calc{0.12 * g}}
  \set msStemLen {\calc{3.3 * g}}
  \if {\< {\step} {4}}
    \set msStemX {\calc{msX + msHeadW - msStemHalf}}
    \set msStemTop {\calc{ny + msStemLen}}
    \line{\msStemX \calc{ny + msStemAttach}  \msStemX \msStemTop}
    \if {\>= {\msDur} {16}}
      \fill{\musiccolor} \nostroke
      \fontglyph anchor:baseline {\calc{msStemX - msStemHalf} \msStemTop}{\musicfont}{\fs}{\cpSixteenthFlagUp}
    \else \if {\>= {\msDur} {8}}
      \fill{\musiccolor} \nostroke
      \fontglyph anchor:baseline {\calc{msStemX - msStemHalf} \msStemTop}{\musicfont}{\fs}{\cpEighthFlagUp}
    \fi \fi
  \else
    \set msStemX {\calc{msX + msStemHalf}}
    \set msStemTop {\calc{ny - msStemLen}}
    \line{\msStemX \calc{ny - msStemAttach}  \msStemX \msStemTop}
    \if {\>= {\msDur} {16}}
      \fill{\musiccolor} \nostroke
      \fontglyph anchor:baseline {\msStemX \msStemTop}{\musicfont}{\fs}{\cpSixteenthFlagDown}
    \else \if {\>= {\msDur} {8}}
      \fill{\musiccolor} \nostroke
      \fontglyph anchor:baseline {\msStemX \msStemTop}{\musicfont}{\fs}{\cpEighthFlagDown}
    \fi \fi
  \fi}

// Measure the beam line for the run that starts at the head of `items` and ends at the next `]`. The beam is an
// up-stem beam above the staff; its line is recorded as a start height (msBeamY0, at the first note) and a slope
// (msBeamDy, the rise from one note to the next), so each note finds the beam at its own position. The slope
// follows the run's first-to-last pitch but is clamped so a wide leap does not tilt the beam wildly, and the
// whole line is then shifted up so even the highest interior note keeps a stem of at least msBeamMin.
\def musicBeamLine items {
  \global\set bmCount {0}
  \global\set bmFirst {0}
  \global\set bmS0 {0}
  \global\set bmSN {0}
  \musicBeamMeasure{\items}
  \set bmNy0 {\calc{msBottom + bmS0 * g / 2}}
  \set bmRise {\calc{(bmSN - bmS0) * g / 2}}
  \set bmCap {\calc{1.5 * g}}
  \if {\> {\bmRise} {\bmCap}} \set bmRise {\bmCap} \fi
  \if {\< {\bmRise} {\calc{0 - bmCap}}} \set bmRise {\calc{0 - bmCap}} \fi
  \global\set msBeamY0 {\calc{bmNy0 + 3.3 * g}}
  \global\set msBeamDy {0}
  \if {\> {\bmCount} {1}} \global\set msBeamDy {\calc{bmRise / (bmCount - 1)}} \fi
  // Raise the line until every note clears it by at least msBeamMin staff spaces, so an interior peak (an arch
  // like c g c) never pokes through the beam.
  \global\set bmJ {0}
  \global\set bmShift {0}
  \musicBeamClear{\items}
  \global\set msBeamY0 {\calc{msBeamY0 + bmShift}}
  \global\set msBeamJ {0}}

// First pass: count the notes in the run and record the diatonic step of its first and last note.
\def musicBeamMeasure items {
  \if {\size{\items}}
    \set tok {\head{\items}}
    \if {\= {\tok} {]}} \else
      \musicParse{\tok}
      \set li {\mapget musicLetters {\msLetter}}
      \set bs {\calc{msOct * 7 + li - msBase}}
      \if {\= {\bmFirst} {0}} \global\set bmS0 {\bs} \global\set bmFirst {1} \fi
      \global\set bmSN {\bs}
      \global\set bmCount {\calc{bmCount + 1}}
      \musicBeamMeasure{\tail{\items}}
    \fi
  \fi}

// Second pass: for each note find how far the provisional beam line falls short of a full stem above it, and
// keep the largest such shortfall in bmShift; adding it to the line lengthens the tightest stem to msBeamMin.
\def musicBeamClear items {
  \if {\size{\items}}
    \set tok {\head{\items}}
    \if {\= {\tok} {]}} \else
      \musicParse{\tok}
      \set li {\mapget musicLetters {\msLetter}}
      \set bs {\calc{msOct * 7 + li - msBase}}
      \set bny {\calc{msBottom + bs * g / 2}}
      \set bby {\calc{msBeamY0 + bmJ * msBeamDy}}
      \set bneed {\calc{bny + 2.5 * g - bby}}
      \if {\> {\bneed} {\bmShift}} \global\set bmShift {\bneed} \fi
      \global\set bmJ {\calc{bmJ + 1}}
      \musicBeamClear{\tail{\items}}
    \fi
  \fi}

// A note inside a beamed run: an up-stem reaching the beam line at this note's place in the run (msBeamYcur),
// joined to the previous note by a thick bar along the line. A run of sixteenths carries a second beam parallel
// to and just below the first. The first note of a run only records its stem foot for the next to beam to.
\def musicBeamedStem {
  \nofill \stroke{\musiccolor} \linewidth{\calc{0.12 * g}}
  \set msStemX {\calc{msX + msHeadW - msStemHalf}}
  \set msBeamYcur {\calc{msBeamY0 + msBeamJ * msBeamDy}}
  \line{\msStemX \calc{ny + msStemAttach}  \msStemX \msBeamYcur}
  \if {\= {\msBeamPrev} {1}}
    \linewidth{\calc{0.5 * g}}
    // Run the beam half a stem-width past each stem centre so it ends flush with the outer edge of the stem
    // rather than leaving the stem's corner poking out; interior segments simply overlap at the shared stems.
    \line{\calc{msBeamPrevX - msStemHalf} \msBeamPrevY  \calc{msStemX + msStemHalf} \msBeamYcur}
    // A second beam, three-quarters of a staff space below the first, parallel to it, for a run of sixteenths.
    \if {\>= {\msDur} {16}}
      \line{\calc{msBeamPrevX - msStemHalf} \calc{msBeamPrevY - 0.75 * g}  \calc{msStemX + msStemHalf} \calc{msBeamYcur - 0.75 * g}}
    \fi
  \fi
  \global\set msBeamPrev {1}
  \global\set msBeamPrevX {\msStemX}
  \global\set msBeamPrevY {\msBeamYcur}
  \global\set msBeamJ {\calc{msBeamJ + 1}}}

// Ledger lines for a note that sits outside the staff: short rules on the even steps between the staff edge
// and the note (step 0 is the bottom line, step 8 the top), centred on the head and overhanging it a little.
\def musicLedgers step {
  \nofill \stroke{\musiccolor} \linewidth{\calc{0.16 * g}}
  \if {\<= {\step} {-2}}
    \set nb {\calc{floor((0 - (\step)) / 2)}}
    \for\k{\range{1}{\nb}}{
      \set ly {\calc{msBottom - \k * g}}
      \line{\calc{msX - 0.4 * g} \ly  \calc{msX + msHeadW + 0.4 * g} \ly}
    }
  \fi
  \if {\>= {\step} {10}}
    \set na {\calc{floor(((\step) - 8) / 2)}}
    \for\k{\range{1}{\na}}{
      \set ly {\calc{msTop + \k * g}}
      \line{\calc{msX - 0.4 * g} \ly  \calc{msX + msHeadW + 0.4 * g} \ly}
    }
  \fi}

// A rest sized to its duration, stamped from the music font. A whole rest hangs under the second line from the
// top, a half rest sits on the middle line, and quarter and eighth rests centre on the middle line.
\def musicRest {
  \fill{\musiccolor} \nostroke
  \if {\= {\msDur} {1}}
    \fontglyph anchor:baseline {\msX \calc{msBottom + 3 * g}}{\musicfont}{\fs}{\cpRestWhole}
  \else \if {\= {\msDur} {2}}
    \fontglyph anchor:baseline {\msX \msMiddle}{\musicfont}{\fs}{\cpRestHalf}
  \else \if {\>= {\msDur} {8}}
    \fontglyph anchor:west {\msX \msMiddle}{\musicfont}{\fs}{\cpEighthRest}
  \else
    \fontglyph anchor:west {\msX \msMiddle}{\musicfont}{\fs}{\cpRestQuarter}
  \fi \fi \fi}

// ---- Accidentals ---------------------------------------------------------------
// A sharp, flat or natural sign drawn just left of the head, its glyph origin (centred on the note line) set
// a glyph-width plus a small gap to the left of the head. The widths are the glyphs' own, in staff spaces.
\def musicAccidental {
  \if {\= {\msAcc} {none}} \else
    \fill{\musiccolor} \nostroke
    \if {\= {\msAcc} {sharp}}
      \fontglyph anchor:baseline {\calc{msX - 1.2 * g} \ny}{\musicfont}{\fs}{\cpAccSharp}
    \else \if {\= {\msAcc} {flat}}
      \fontglyph anchor:baseline {\calc{msX - 1.1 * g} \ny}{\musicfont}{\fs}{\cpAccFlat}
    \else
      \fontglyph anchor:baseline {\calc{msX - 0.9 * g} \ny}{\musicfont}{\fs}{\cpAccNatural}
    \fi \fi
  \fi}

// ---- Key signature -------------------------------------------------------------
// The sharps or flats of the key, written after the clef in their conventional order and on their conventional
// staff positions (which differ by clef — see the musicSharpSteps/musicFlatSteps rows). A positive musickey
// draws that many sharps, a negative one that many flats. Each accidental is a music-font glyph seated with its
// baseline on the pitch's line, advancing 0.9 staff spaces from the previous one.
\def musicKeySig {
  \set ksN {\calc{musickey}}
  \if {\= {\musicclef} {tenor}} \set ksN {0} \fi   // tenor key-signature layout is irregular; not drawn
  \if {\= {\ksN} {0}} \else
    \fill{\musiccolor} \nostroke
    \if {\> {\ksN} {0}}
      \set ksGlyph {\cpAccSharp}
      \set ksCount {\ksN}
      \set ksSteps {\musicSharpStepsTreble}
      \if {\= {\musicclef} {bass}} \set ksSteps {\musicSharpStepsBass} \fi
      \if {\= {\musicclef} {alto}} \set ksSteps {\musicSharpStepsAlto} \fi
    \else
      \set ksGlyph {\cpAccFlat}
      \set ksCount {\calc{0 - ksN}}
      \set ksSteps {\musicFlatStepsTreble}
      \if {\= {\musicclef} {bass}} \set ksSteps {\musicFlatStepsBass} \fi
      \if {\= {\musicclef} {alto}} \set ksSteps {\musicFlatStepsAlto} \fi
    \fi
    \set ksX {\msKeyX}
    \set ksI {0}
    \musicKeyAccs{\ksSteps}
  \fi}

// Place the next key-signature accidental and recurse for the rest, advancing ksX and the count ksI across the
// staff. The counter is a plain variable (advanced eagerly with \set) and the recursion peels the steps list,
// so it stops at ksCount accidentals without doing arithmetic on a macro argument.
\def musicKeyAccs steps {
  \if {\< {\ksI} {\ksCount}}
    \set ksStep {\head{\steps}}
    \fontglyph anchor:baseline {\ksX \calc{msBottom + ksStep * g / 2}}{\musicfont}{\fs}{\ksGlyph}
    \set ksX {\calc{ksX + 0.9 * g}}
    \set ksI {\calc{ksI + 1}}
    \musicKeyAccs{\tail{\steps}}
  \fi}

// ---- Time signature ------------------------------------------------------------
// The numerator over the denominator, after the clef and key signature. Each is a row of the font's time-signature
// figures (timeSig0..9), centred on a common x: the numerator between the middle and top lines, the denominator
// between the middle and bottom. A figure is about two staff spaces tall and centred on its baseline, so
// placing the row's baseline a staff space above and below the middle line seats the pair across the staff.
\def musicTimeSig {
  \if {\size{\cat{\musictimenum}{}}}
    \set tsCenterX {\calc{msTimeX + msTimeW / 2}}
    \fill{\musiccolor} \nostroke
    \musicTimeRow{\musictimenum}{\calc{msMiddle + g}}
    \musicTimeRow{\musictimeden}{\calc{msMiddle - g}}
  \fi}

// One row of time-signature figures, centred on tsCenterX at height y. Each digit occupies a fixed cell so
// a two-digit signature (12, 16) stays centred as a block; the digit glyph is centred within its cell.
\def musicTimeRow digits y {
  \set ds {\cat{\digits}{}}
  \set n {\size{\ds}}
  \set cell {\calc{1.4 * g}}
  \set x0 {\calc{tsCenterX - n * cell / 2}}
  \set i {0}
  \musicTimeDigits{\ds}{\y}}

\def musicTimeDigits s y {
  \if {\size{\s}}
    \set d {\head{\s}}
    \set cx {\calc{x0 + i * cell + cell / 2}}
    \fontglyph anchor:center {\cx \y}{\musicfont}{\fs}{\calc{cpTimeDigitBase + \d}}
    \set i {\calc{i + 1}}
    \musicTimeDigits{\tail{\s}}{\y}
  \fi}

// ---- Note parsing --------------------------------------------------------------
// Set msAcc (accidental: sharp/flat/nat/none), msLetter (pitch class), msOct (octave offset from middle C's
// octave), msDur (1/2/4/8/16/32), and msDot (1 if dotted). An optional accidental (+ sharp, - flat, n natural)
// leads the token; then the letter, then any octave marks, a duration number, and a trailing dot. An accidental
// shifts the look, not the staff line — a sharpened C and a plain C sit on the same line — so it only chooses
// which sign is drawn. The duration's digits accumulate, so 16 and 32 read as one number, not two marks.
\def musicParse tok {
  \global\set ps {\cat{\tok}{}}
  \global\set msAcc {none}
  \set accCh {\head{\ps}}
  \if {\= {\accCh} {+}} \global\set msAcc {sharp} \global\set ps {\tail{\ps}}
  \else \if {\= {\accCh} {-}} \global\set msAcc {flat} \global\set ps {\tail{\ps}}
  \else \if {\= {\accCh} {n}} \global\set msAcc {nat} \global\set ps {\tail{\ps}}
  \fi \fi \fi
  \global\set msLetter {\head{\ps}}
  \global\set msOct {0}
  \global\set msDur {4}
  \global\set msDot {0}
  \global\set msDurSeen {0}
  \musicParseRest{\tail{\ps}}}

\def musicParseRest s {
  \if {\size{\s}}
    \set pc {\head{\s}}
    \if {\= {\pc} {'}} \global\set msOct {\calc{msOct + 1}}
    \else \if {\= {\pc} {,}} \global\set msOct {\calc{msOct - 1}}
    \else \if {\= {\pc} {.}} \global\set msDot {1}
    \else
      \if {\= {\msDurSeen} {0}} \global\set msDur {\calc{pc}} \global\set msDurSeen {1}
      \else \global\set msDur {\calc{msDur * 10 + pc}} \fi
    \fi \fi \fi
    \musicParseRest{\tail{\s}}
  \fi}

// ---- The clef ------------------------------------------------------------------
// The clef, stamped from the music font. Each clef's origin sits on the line it names, so a baseline anchor on
// that line seats the glyph: the G (treble) clef on the second line from the bottom, the F (bass) clef on the
// second from the top, and the C (alto/tenor) clef on the line that is middle C — the middle line for the alto,
// the fourth line for the tenor. A small left margin keeps the clef clear of the staff's left edge.
\def musicClef {
  \fill{\musiccolor} \nostroke
  \set msClefX {\calc{1.4 * g}}
  \if {\= {\musicclef} {bass}}
    \fontglyph anchor:baseline {\msClefX \calc{msBottom + 3 * g}}{\musicfont}{\fs}{\cpFClef}
  \else \if {\= {\musicclef} {alto}}
    \fontglyph anchor:baseline {\msClefX \calc{msBottom + 2 * g}}{\musicfont}{\fs}{\cpCClef}
  \else \if {\= {\musicclef} {tenor}}
    \fontglyph anchor:baseline {\msClefX \calc{msBottom + 3 * g}}{\musicfont}{\fs}{\cpCClef}
  \else
    \fontglyph anchor:baseline {\msClefX \calc{msBottom + 1 * g}}{\musicfont}{\fs}{\cpGClef}
  \fi \fi \fi}
