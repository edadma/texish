// music — staff notation set in a SMuFL (Standard Music Font Layout) music font over the \picture vector
// layer. SMuFL fixes the codepoint of every notation glyph and the convention that one staff space is a
// quarter of the em, so the package works with any SMuFL face; \set musicfont {…} chooses it (bravura is the
// reference font and the default; petaluma is a handwritten-style alternative). Import it with:
//
//     \use{music}
//
// A line of music is drawn by \score, whose body is a space-separated list of notes:
//
//     \score{c d e f g a b c'}
//     \score{e4 d4 c4 d4 | e4 e4 e2}
//
// A note is an optional accidental, a letter a–g, optional octave marks, a duration digit, then optional marks:
//   - + - n    an accidental — sharp, flat, or natural — drawn just left of the head (it changes how the
//              note reads, not where it sits, so +c and c share a line)
//   - letter   the pitch class; lowercase c is middle C (one ledger line below the staff)
//   - ' or ,   raise / lower by an octave, repeatable (c' is the C above, c, the C below)
//   - 1 2 4 8  the duration — whole, half, quarter (the default), or eighth note
//   - .        an augmentation dot, lengthening the note by half
//   - > ! = * ;  an articulation, drawn on the side away from the stem — accent, staccato, tenuto, marcato,
//              fermata (several may follow, and they stack outward)
//   - -        a tie: this note is joined by a curve to the next, which should be the same pitch (so c-c)
// `r` is a rest and `|` a barline. `[` and `]` bracket a run of notes joined by one beam instead of flags,
// and `( )` bracket a run under one slur. Expression marks set below the staff are their own tokens: a token
// beginning `!` is a dynamic built from the marks that follow (`!p`, `!mf`, `!ff`, `!sfz`); `<` opens a
// crescendo hairpin and `>` a diminuendo, each closed by `=`, spanning the notes between.
// So `g,2` is the G below middle C held for a half note, `+c'8>` a sharpened eighth with an accent, and
// `( c d e f )` a slurred run. A time signature is drawn from \musictimenum / \musictimeden (see below).
//
// Lyrics are given by \lyrics just before the \score they belong to, one syllable per note:
//
//     \lyrics{I have de -- cid -- ed}
//     \score{g4 a4 b4 c'4 d'2}
//
// Syllables are space-separated and taken by the notes in order (rests take none). A `--` between two syllables
// joins them as one word, drawn with a hyphen centred in the gap; a `_` gives its note no syllable. Each syllable
// is centred under its note, and a note is moved further from the next when the two syllables need the room — so
// a long word spreads the music out rather than running into its neighbour.
//
// A chord name in double quotes, written as its own token, is set above the staff over the note or rest that
// follows it — the convention of ABC notation and of a lead sheet:
//
//     \score{"G" g4 a4 b4 "C" c'4 | "D7" d'2 "G" g2}
//
// The name starts at the left edge of its note's head and is set as a lead sheet sets it: the root (with a b or
// # written as a flat or sharp sign, and a minor m) at full size, the extension raised and smaller (G7, Cmaj7,
// Gsus4, G7b9), a slash bass at full size (F/C, Eb/Bb). Where a chord name is wider than the room to the next
// chord, its note is moved along to make that room. Otherwise notes stand musicnote apart, more where an
// accidental needs room to clear the note before it.
//
// Heads, clefs, flags, rests, accidentals and time-signature figures are real engraved glyphs from the music
// font, stamped with \fontglyph; stems, beams, staff lines, ledger lines and barlines are ruled. Since one
// staff space is a quarter of the em, the font is set at a size of four staff spaces (\set fs inside \score)
// and its own coordinates fall straight onto the staff.

// Everything below is code: the package sets no literal text of its own (syllables and chord names come from
// the document), so its whitespace only separates and never adds space beside a score set inside a line.
\codesyntax

// ---- Configuration (override with \set after \use, before \score) ---------------
// Sizes are in points (72 per inch).
\set musicgap {8}          // space between adjacent staff lines — the staff space, the unit everything scales from
\set musicnote {22}        // horizontal advance from one note to the next
\set musicleft {44}        // x of the first note — leaves room for the clef
\set musicpad {30}         // vertical room above and below the staff for ledger lines, stems and flags
\set musiccolor {black}
\set musicfont {bravura}   // the SMuFL music font to set the glyphs in — any loaded SMuFL face (bravura, petaluma, …)
\set musicclef {treble}    // treble, bass, alto, or tenor; chooses the clef and how pitches sit on the staff
\set musictimenum {}       // time-signature numerator, drawn after the clef (e.g. {3}); empty for no signature
\set musictimeden {}       // time-signature denominator (e.g. {4})
\set musickey {0}          // key signature: a signed count — positive = that many sharps, negative = flats (0 none)
\set musiclyricfont {lmroman} // the text face lyrics are set in
\set musiclyricsize {11}   // the lyric font size
\set musiclyricgap {6}     // the least white space left between two neighbouring syllables
\set musiclyricdrop {26}   // how far the lyric baseline sits below the bottom staff line
\set musicchordfont {lmroman} // the text face chord names are set in
\set musicchordsize {12}   // the chord-name font size
\set musicchordweight {bold} // the chord-name weight (regular, bold, …)
\set musicchordgap {8}     // the least white space left between two neighbouring chord names
\set musicchordsupscale {0.7}  // a chord extension's size (the 7 of G7), as a fraction of the chord size
\set musicchordsupraise {0.4}  // how far an extension is raised, as a fraction of the chord size
\set musicchordrise {22}   // how far the chord-name baseline sits above the top staff line
// No score has lyrics until \lyrics arms the next one.
\global\set msLyrArmed {0}
// c d e f g a b -> 0..6, the diatonic step of each pitch class within an octave.
\set musicLetters {\map{c 0 d 1 e 2 f 3 g 4 a 5 b 6}}

// Key-signature accidental positions, as diatonic steps above the bottom staff line, in the order the signs are
// written: sharps F C G D A E B, flats B E A D G C F. The treble and bass staves place them differently, so each
// has its own row. (Bottom line is step 0; a line or space is one step.) A key signature takes the first |musickey|
// of the matching row.
\set musicSharpStepsTreble {\seq{8 5 9 6 3 7 4}}
\set musicFlatStepsTreble  {\seq{4 7 3 6 2 5 1}}
\set musicSharpStepsBass   {\seq{6 3 7 4 1 5 2}}
\set musicFlatStepsBass    {\seq{2 5 1 4 0 3 -1}}
\set musicSharpStepsAlto   {\seq{7 4 8 5 2 6 3}}
\set musicFlatStepsAlto    {\seq{3 6 2 5 1 4 0}}

// ---- SMuFL codepoints ----------------------------------------------------------
// The Private-Use codepoints of the glyphs this package stamps. Names follow the SMuFL glyph registry.
\set cpGClef {57424}            // U+E050 gClef
\set cpFClef {57442}            // U+E062 fClef
\set cpCClef {57436}            // U+E05C cClef (alto / tenor)
\set cpNoteWhole {57506}        // U+E0A2 noteheadWhole
\set cpNoteHalf {57507}         // U+E0A3 noteheadHalf
\set cpNoteBlack {57508}        // U+E0A4 noteheadBlack
// Note these glyph names spell their durations out (Eighth, Sixteenth) rather than using 8/16: a control
// sequence is letters only, so \cpFlag8Up would tokenize as \cpFlag followed by the text 8Up and silently
// resolve to nothing. Letter-only names stay safe to reference with a backslash anywhere.
\set cpEighthFlagUp {57920}     // U+E240 flag8thUp
\set cpEighthFlagDown {57921}   // U+E241 flag8thDown
\set cpSixteenthFlagUp {57922}  // U+E242 flag16thUp
\set cpSixteenthFlagDown {57923} // U+E243 flag16thDown
\set cpAugDot {57831}           // U+E1E7 augmentationDot
\set cpRestWhole {58595}        // U+E4E3 restWhole
\set cpRestHalf {58596}         // U+E4E4 restHalf
\set cpRestQuarter {58597}      // U+E4E5 restQuarter
\set cpEighthRest {58598}       // U+E4E6 rest8th
\set cpAccFlat {57952}          // U+E260 accidentalFlat
\set cpAccNatural {57953}       // U+E261 accidentalNatural
\set cpAccSharp {57954}         // U+E262 accidentalSharp
\set cpTimeDigitBase {57472}    // U+E080 timeSig0; a digit d is at cpTimeDigitBase + d
\set cpCsymFlat {60768}         // U+ED60 csymAccidentalFlat — the chord-symbol flat, standing on the baseline
\set cpCsymSharp {60770}        // U+ED62 csymAccidentalSharp

// Articulations come in an above and a below form; the package picks the one on the side away from the stem.
\set cpAccentAbove {58528}      // U+E4A0 articAccentAbove
\set cpAccentBelow {58529}      // U+E4A1 articAccentBelow
\set cpStaccatoAbove {58530}    // U+E4A2 articStaccatoAbove
\set cpStaccatoBelow {58531}    // U+E4A3 articStaccatoBelow
\set cpTenutoAbove {58532}      // U+E4A4 articTenutoAbove
\set cpTenutoBelow {58533}      // U+E4A5 articTenutoBelow
\set cpMarcatoAbove {58540}     // U+E4AC articMarcatoAbove
\set cpMarcatoBelow {58541}     // U+E4AD articMarcatoBelow
\set cpFermataAbove {58560}     // U+E4C0 fermataAbove
\set cpFermataBelow {58561}     // U+E4C1 fermataBelow
// Dynamic letters are separate glyphs strung together: mf is dynamicMezzo then dynamicForte.
\set cpDynP {58656}             // U+E520 dynamicPiano
\set cpDynM {58657}             // U+E521 dynamicMezzo
\set cpDynF {58658}             // U+E522 dynamicForte
\set cpDynR {58659}             // U+E523 dynamicRinforzando
\set cpDynS {58660}             // U+E524 dynamicSforzando
\set cpDynZ {58661}             // U+E525 dynamicZ
\set cpDynN {58662}             // U+E526 dynamicNiente

// ---- The score -----------------------------------------------------------------
// \score sizes a picture to hold the notes, draws the five staff lines and the clef, then walks the note
// list left to right. The bottom staff line sits at y = musicpad; a pitch's vertical position is half the
// staff space per diatonic step above it. The font size fs is four staff spaces, so a SMuFL glyph's own
// units (where the staff space is a quarter of the em) come out one staff space = musicgap points.
\def score notes {{
  \set msList {\seq{\notes}}
  \set g {\musicgap}
  \set fs {\calc{4 * g}}
  // The notehead's actual width (points), read from the chosen music font, so a stem seats on the head's right
  // edge and a ledger line spans the head whatever font is in use — no per-font constants. (A black and a half
  // notehead share a width, so one measurement covers every stemmed note.)
  \set msHeadW {\glyphwidth{\musicfont}{\fs}{\cpNoteBlack}}
  \set msStemHalf {\calc{0.06 * g}}
  // The head is tilted, so its right tip (where an up-stem joins) sits a little above centre and its left tip a
  // little below. Pull the stem foot this far toward that tip so the stem meets the head instead of starting at
  // dead centre and overshooting past the tip — a small amount that reads well across SMuFL fonts.
  \set msStemAttach {\calc{0.2 * g}}
  //
  // The diatonic step of the bottom line, used to place every pitch: E4 (index 2) on the treble staff, G2
  // (index -10) on the bass, F3 (-4) on the alto, D3 (-6) on the tenor. A note's index is msOct*7 + its pitch
  // class; its step above the bottom line is that index minus this base, and half the staff space per step
  // gives its height. Middle C sits on the middle line in the alto clef, the fourth line in the tenor.
  \set msBase {2}
  \if {\= {\musicclef} {bass}} \set msBase {-10}
  \else \if {\= {\musicclef} {alto}} \set msBase {-4}
  \else \if {\= {\musicclef} {tenor}} \set msBase {-6}
  \fi \fi \fi
  //
  // Lyrics armed by \lyrics are measured before anything is placed: musicLyricPlan measures every syllable and
  // works out how far right the first note must sit for its syllable to stay inside the picture (msLyrLead), 0
  // for a score without lyrics. \lyrics arms only the next score, so the flag is cleared here.
  \set msLyr {\msLyrArmed}
  \global\set msLyrArmed {0}
  \global\set msSylN {0}
  \global\set msLyrLead {0}
  \if {\= {\msLyr} {1}} \musicLyricPlan \fi
  //
  // The spacing plan then walks the notes once, ahead of drawing, and records the advance every token will take
  // (msTokAdv): musicnote unless a syllable, a chord name or an accidental needs more. It also notes whether the
  // score names any chord (msChordOn), which reserves a lane above the staff, whether it has dynamics or hairpins
  // (msDynOn), and how low the dynamics must sit to clear everything drawn below the staff (msDynLane, in staff
  // spaces below the bottom line, never above the usual 2.6).
  \musicSpacePlan
  \set chRoom {0}
  \if {\= {\msChordOn} {1}} \set chRoom {\calc{musicchordrise + 0.9 * musicchordsize}} \fi
  //
  // Below the staff: the dynamics, then the lyric line clear beneath them. With no dynamics the lane is the
  // usual one and the lyrics keep their usual drop; the picture keeps the largest room any of them needs below
  // the bottom line.
  \set dyLane {-2.6}
  \set dyRoom {0}
  \if {\= {\msDynOn} {1}} \set dyLane {\msDynLane} \fi
  \if {\= {\msDynOn} {1}} \set dyRoom {\calc{(1.1 - dyLane) * g}} \fi
  \set lyDrop {\musiclyricdrop}
  \if {\= {\msDynOn} {1}} \set lyDrop {\calc{max(musiclyricdrop, (1.4 - dyLane) * g + 0.8 * musiclyricsize)}} \fi
  \set lyRoom {0}
  \if {\= {\msLyr} {1}} \set lyRoom {\calc{lyDrop + 0.6 * musiclyricsize}} \fi
  \set msBottom {\calc{max(musicpad, lyRoom, dyRoom)}}
  \set msTop {\calc{msBottom + 4 * g}}
  \set msMiddle {\calc{msBottom + 2 * g}}
  \set msH {\calc{msBottom + 4 * g + max(musicpad, chRoom)}}
  // The chord-name baseline, a fixed rise above the top staff line, and the lyric baseline, its drop below the
  // bottom one.
  \set msChordY {\calc{msTop + musicchordrise}}
  \set msLyrY {\calc{msBottom - lyDrop}}
  //
  // The leading area runs clef → key signature → time signature → notes, each taking the room it needs so the
  // next clears it. The key signature is |musickey| accidentals at 0.9 staff-space steps; the time signature a
  // column wide enough for its longest row of figures. The first note sits past all of it (but no closer than
  // musicleft, which still controls the spacing when there is neither a key nor a time signature, nor closer
  // than its syllable needs).
  \set msKeyX {\calc{4.8 * g}}
  \set msKeyN {\calc{abs(musickey)}}
  // Key signatures are placed for treble, bass and alto; the tenor C-clef's layout is irregular, so it reserves
  // no key-signature column (a key set with the tenor clef is simply not drawn).
  \if {\= {\musicclef} {tenor}} \set msKeyN {0} \fi
  \set msKeyW {\calc{msKeyN * 0.9 * g}}
  \set msTimeX {\calc{msKeyX + msKeyW + 0.5 * g}}
  \set msTimeLen {\calc{max(\size{\cat{\musictimenum}{}}, \size{\cat{\musictimeden}{}})}}
  \set msTimeW {\calc{msTimeLen * 1.4 * g}}
  \set msFirstX {\calc{max(msTimeX + msTimeW + 0.6 * g, musicleft, msLyrLead)}}
  //
  // The staff runs from the clef to where the spacing plan ended: the right edge of a closing barline, or one
  // advance past the last note. The picture is as wide as that, or as the furthest syllable or chord name if one
  // reaches past it, with a hair to spare.
  \set msStaffEnd {\calc{msFirstX + msPlanEnd}}
  \set msW {\calc{max(msStaffEnd, msFirstX + msPlanInk) + 2}}
  //
  // The walk's running state. msBeam is 1 while a [ … ] run is open. The spanning expression marks: a slur ( … )
  // records its first and last note, a tie its first note so the curve can be closed at the second, a hairpin
  // its opening x and kind. A dynamic or hairpin token only arms its mark; the next note fixes the x for it.
  \global\set msBeam {0}
  \global\set msSlur {0}
  \global\set msSlurStarted {0}
  \global\set msSlurDown {0}
  \global\set msTie {0}
  \global\set msTiePending {0}
  \global\set msHair {0}
  \global\set msHairArmed {0}
  \global\set msDynArmed {0}
  \global\set msChordPend {-}
  \global\set msTokI {0}
  \global\set msLyrJ {1}
  \global\set msLyrHyPend {0}
  \global\set msDynI {0}
  // The lane below the staff where dynamics and hairpins are drawn. Each dynamic or hairpin moves it to its own
  // group's lane as the walk reaches it.
  \global\set msUnder {\calc{msBottom + dyLane * g}}
  //
  \picture width:{\msW} height:{\msH} {
    \musicStaffLines
    \musicClef
    \musicKeySig
    \musicTimeSig
    \set msX {\msFirstX}
    \musicWalk{\msList}
  }
}}

// The five staff lines, spanning the full width, at the SMuFL staff-line thickness. They begin half a staff
// space in from the picture edge, leaving the clef room to sit inside the staff rather than off its left end.
\def musicStaffLines {
  \nofill \stroke{\musiccolor} \linewidth{\calc{0.13 * g}}
  \for\i{\range{0}{4}}{
    \set ly {\calc{msBottom + \i * g}}
    \line{\calc{0.5 * g} \ly  \msStaffEnd \ly}
  }}

// Walk the note list, advancing msX. Only notes and barlines advance the cursor; the bracketing and expression
// tokens annotate the current position. `[` and `]` open and close a beamed run (the notes between them share one
// beam, tilted to follow the melody, instead of carrying flags); `(` and `)` open and close a slur. A token
// beginning `!` is a dynamic; `<` and `>` open a crescendo and a diminuendo hairpin and `=` closes it. Several
// barline kinds are written as their own tokens: `|` plain, `||` double, `|.` final, `|:` and `:|` the start and end of a repeat.
\def musicWalk items {
  \if {\size{\items}}
    \set tok {\head{\items}}
    // msTokI is this token's place in the list, which indexes the advance the spacing plan recorded for it.
    \global\set msTokI {\calc{msTokI + 1}}
    \if {\= {\tok} {[}}
      \global\set msBeam {1}
      \global\set msBeamPrev {0}
      \musicBeamLine{\tail{\items}}
    \else \if {\= {\tok} {]}}
      \global\set msBeam {0}
    \else \if {\= {\tok} {(}}
      \global\set msSlur {1}
      \global\set msSlurStarted {0}
      \global\set msSlurDown {0}
    \else \if {\= {\tok} {)}}
      \musicSlurEnd
      \global\set msSlur {0}
    \else \if {\= {\tok} {<}}
      \musicDynLaneNext
      \global\set msHair {1}
      \global\set msHairArmed {1}
    \else \if {\= {\tok} {>}}
      \musicDynLaneNext
      \global\set msHair {2}
      \global\set msHairArmed {1}
    \else \if {\= {\tok} {=}}
      \musicHairpinEnd
      \global\set msHair {0}
    \else \if {\= {\head{\cat{\tok}{}}} {!}}
      \musicDynLaneNext
      \global\set msDynStr {\tail{\cat{\tok}{}}}
      \global\set msDynArmed {1}
    \else \if {\= {\head{\cat{\tok}{}}} {"}}
      \musicChordName{\tok}
      \global\set msChordPend {\msChordStr}
    \else \if {\= {\tok} {|}}
      \musicBarThin{\msX}
      \set msX {\calc{msX + musicnote * 0.6}}
    \else \if {\= {\tok} {||}}
      \musicBarDouble
      \set msX {\calc{msX + musicnote * 0.7}}
    \else \if {\= {\tok} {|.}}
      \musicBarFinal
      \set msX {\calc{msX + musicnote * 0.8}}
    \else \if {\= {\tok} {|:}}
      \musicBarRepeatStart
      \set msX {\calc{msX + musicnote}}
    \else \if {\= {\tok} {:|}}
      \musicBarRepeatEnd
      \set msX {\calc{msX + musicnote * 0.9}}
    \else
      \musicNote{\tok}
      // A sung note takes its syllable (a rest takes none), a note or rest takes the chord name waiting for it,
      // and either moves on by the advance planned for it.
      \if {\= {\msLyr} {1}} \if {\= {\msLetter} {r}} \else \musicLyricNote \fi \fi
      \if {\= {\msChordPend} {-}} \else \musicChordDraw \fi
      \set msAdvNow {\nth{\msTokAdv}{\msTokI}}
      \set msX {\calc{msX + msAdvNow}}
    \fi \fi \fi \fi \fi \fi \fi \fi \fi \fi \fi \fi \fi \fi
    \musicWalk{\tail{\items}}
  \fi}

// ---- Lyrics --------------------------------------------------------------------
// \lyrics records the syllables for the next \score and arms it; the score clears the flag, so a later score
// without its own \lyrics has none.
\def lyrics words {
  \global\set msLyrText {\words}
  \global\set msLyrArmed {1}}

// Measure the lyric line before the score is drawn. Three parallel lists hold one entry per syllable — its text
// (msSylT, `_` for a note left without one), its width in the lyric font (msSylW), and whether a hyphen joins it
// to the next (msSylH). The spacing plan reads them to decide how far each sung note advances.
\def musicLyricPlan {
  \global\set msSylT {\seq{}}
  \global\set msSylW {\seq{}}
  \global\set msSylH {\seq{}}
  \musicLyrMeasure{-}
  \global\set msHyphW {\msLyrWv}
  \musicLyrPrep{\seq{\msLyrText}}
  \global\set msSylN {\size{\msSylT}}
  // The first syllable is centred under the first note, so the note sits far enough right that the syllable's
  // left edge stays inside the picture.
  \if {\> {\msSylN} {0}}
    \set lpW {\nth{\msSylW}{1}}
    \global\set msLyrLead {\calc{lpW / 2 - msHeadW / 2 + 2}}
  \fi
  }

// The width of one piece of lyric text, set in the lyric font, into msLyrWv.
\def musicLyrMeasure s {
  \setbox msLyrBox \hbox{{\font {\musiclyricfont} {\musiclyricsize} {regular}\s}}
  \global\set msLyrWv {\wd msLyrBox}}

// Split the \lyrics text into syllables. A `--` marks the syllable before it as hyphenated to the next one rather
// than becoming a syllable itself; a `_` holds a note's place with no text and no width.
\def musicLyrPrep toks {
  \if {\size{\toks}}
    \set lt {\head{\toks}}
    \if {\= {\lt} {--}}
      \set lhn {\size{\msSylH}}
      \if {\> {\lhn} {0}} \global\set msSylH {\put{\msSylH}{\lhn}{1}} \fi
    \else
      \global\set msSylT {\append{\msSylT}{\lt}}
      \global\set msSylH {\append{\msSylH}{0}}
      \global\set msLyrWv {0}
      \if {\= {\lt} {_}} \else \musicLyrMeasure{\lt} \fi
      \global\set msSylW {\append{\msSylW}{\msLyrWv}}
    \fi
    \musicLyrPrep{\tail{\toks}}
  \fi}

// Set the syllable for the sung note at msX, centred under its head, and the hyphen left pending by the syllable
// before it, centred in the gap between the two. msLyrJ counts the sung notes; notes past the last syllable get
// none.
\def musicLyricNote {
  \set lj {\msLyrJ}
  \if {\<= {\lj} {\msSylN}}
    \set lsT {\nth{\msSylT}{\lj}}
    \if {\= {\lsT} {_}} \else \musicLyricSyllable \fi
  \fi
  \global\set msLyrJ {\calc{lj + 1}}}

\def musicLyricSyllable {
  \set lsW {\nth{\msSylW}{\lj}}
  \set lsL {\calc{msX + msHeadW / 2 - lsW / 2}}
  \fill{\musiccolor} \nostroke
  \at anchor:baseline {\lsL \msLyrY}{{\font {\musiclyricfont} {\musiclyricsize} {regular}\lsT}}
  \if {\= {\msLyrHyPend} {1}} \musicLyricHyphen{\msLyrPrevR}{\lsL} \fi
  \global\set msLyrPrevR {\calc{lsL + lsW}}
  \global\set msLyrHyPend {\nth{\msSylH}{\lj}}}

// A hyphen centred between the right edge of one syllable (xa) and the left edge of the next (xb).
\def musicLyricHyphen xa xb {
  \set lyA {\xa}
  \set lyB {\xb}
  \set lyHw {\msHyphW}
  \at anchor:baseline {\calc{(lyA + lyB) / 2 - lyHw / 2} \msLyrY}{{\font {\musiclyricfont} {\musiclyricsize} {regular}-}}}

// ---- Chord names ---------------------------------------------------------------
// The name inside a "…" token, quotes stripped, into msChordStr: the characters after the opening quote, up to
// the closing one.
\def musicChordName tok {
  \global\set msChordStr {}
  \musicChordChars{\tail{\cat{\tok}{}}}}

\def musicChordChars s {
  \if {\size{\s}}
    \set cc {\head{\s}}
    \if {\= {\cc} {"}} \else
      \global\set msChordStr {\cat{\msChordStr}{\cc}}
      \musicChordChars{\tail{\s}}
    \fi
  \fi}

// A chord name is set the way a lead sheet sets it: the root (a letter, any flat `b` or sharp `#`, and a minor
// `m`) at full size, the extension that follows (7, maj7, sus4, 9, add9, …) raised as a superscript, and a slash
// bass (/C) at full size again — so "Am7" reads A m ⁷ and "G7/B" G ⁷ /B. musicChordParts splits a name into those
// three parts, msChRoot, msChExt and msChBass; an `m` followed by `a` begins `maj`, an extension, not a minor.
\def musicChordParts s {
  \global\set msChRoot {\head{\s}}
  \global\set msChExt {}
  \global\set msChBass {}
  \global\set msChPart {root}
  \musicChordPartChars{\tail{\s}}}

\def musicChordPartChars s {
  \if {\size{\s}}
    \set pc {\head{\s}}
    \set pn {\head{\tail{\s}}}
    \if {\= {\pc} {/}} \global\set msChPart {bass} \global\set msChBass {/}
    \else \if {\= {\msChPart} {bass}} \global\set msChBass {\cat{\msChBass}{\pc}}
    \else \if {\= {\msChPart} {root}} \musicChordRootChar{\pc}{\pn}
    \else \global\set msChExt {\cat{\msChExt}{\pc}}
    \fi\fi\fi
    \musicChordPartChars{\tail{\s}}
  \fi}

\def musicChordRootChar pc pn {
  \global\set chRootKeep {0}
  \if {\= {\pc} {b}} \global\set chRootKeep {1} \fi
  \if {\= {\pc} {#}} \global\set chRootKeep {1} \fi
  \if {\= {\pc} {m}} \if {\= {\pn} {a}} \else \global\set chRootKeep {1} \fi \fi
  \if {\= {\chRootKeep} {1}} \global\set msChRoot {\cat{\msChRoot}{\pc}}
  \else \global\set msChPart {ext} \global\set msChExt {\cat{\msChExt}{\pc}}
  \fi}

// A chord name split by musicChordParts, as one box of text: the root at the chord size, the extension raised by
// musicchordsupraise of the size and set at musicchordsupscale of it, then the slash bass at the chord size.
\def musicChordBox {
  \hbox{
    \musicChordRun{\msChRoot}{\musicchordsize}
    \if {\> {\size{\msChExt}} {0}}
      \raise{\calc{musicchordsize * musicchordsupraise}}\hbox{\musicChordRun{\msChExt}{\calc{musicchordsize * musicchordsupscale}}}
    \fi
    \musicChordRun{\msChBass}{\musicchordsize}
  }}

// One run of a chord name at size sz, in the chord face and weight. A `b` or `#` in it is a flat or sharp sign
// (root letters are capitals and no extension word has a b): the music font's chord-symbol accidental, a glyph
// made to stand on the baseline at about the height of a capital, set at the same weight as the letters — a bold
// chord name gets a synthetic bold sign, since a music font has one weight.
\def musicChordRun s sz {
  {\font {\musicchordfont} {\sz} {\musicchordweight}\musicChordRunChars{\s}{\sz}}}

\def musicChordRunChars s sz {
  \if {\size{\s}}
    \musicChordChar{\head{\s}}{\sz}
    \musicChordRunChars{\tail{\s}}{\sz}
  \fi}

\def musicChordChar c sz {
  \if {\= {\c} {b}}
    \musicChordSign{\cpCsymFlat}{\sz}
  \else
    \if {\= {\c} {#}}
      \musicChordSign{\cpCsymSharp}{\sz}
    \else
      \c
    \fi
  \fi}

// A sign at just under the run's size, so its three-staff-space height matches the capitals, with a hair of room
// either side.
\def musicChordSign cp sz {
  {\font {\musicfont} {\calc{\sz * 0.95}} {\musicchordweight}\kern{\calc{\sz * 0.03}}\char{\cp}\kern{\calc{\sz * 0.03}}}}

// Set the chord name waiting for this note or rest, its left edge on the head's, on the lane above the staff.
\def musicChordDraw {
  \fill{\musiccolor} \nostroke
  \musicChordParts{\msChordPend}
  \at anchor:baseline {\msX \msChordY}{\musicChordBox}
  \global\set msChordPend {-}}

// The width of a chord name as musicChordDraw sets it, into msChordWv.
\def musicChordMeasure s {
  \musicChordParts{\s}
  \setbox msChordBox \hbox{\musicChordBox}
  \global\set msChordWv {\wd msChordBox}}

// ---- The spacing plan ----------------------------------------------------------
// One pass over the score ahead of drawing, appending to msTokAdv the advance each token will take, in token
// order, so the drawing walk can read its own by position. Only a note or rest advances by it (barlines keep
// their own fixed advances), and it is musicnote unless something needs more:
//   - a sung note whose syllable and the next one, each centred on its note, would come closer than
//     musiclyricgap — with room for a hyphen and a second gap when the two are one word;
//   - a note or rest carrying a chord name, when the next note or rest also carries one (or the score ends) and
//     the name is wider than the advance — it gets its width plus musicchordgap.
// Every point added past musicnote widens the score by that much (msSpaceExtra). A score with neither lyrics
// nor chords plans musicnote for every note, the fixed spacing it has always had.
\def musicSpacePlan {
  \global\set msTokAdv {\seq{}}
  \global\set msSpaceExtra {0}
  \global\set msChordOn {0}
  \global\set msChordN {0}
  \global\set spJ {1}
  \global\set spChW {0}
  \global\set spBeam {0}
  \global\set spSlur {0}
  \global\set msDynOn {0}
  \global\set msDynLane {-2.6}
  \global\set msDynLanes {\seq{}}
  \global\set msDynTokGrp {\seq{}}
  \global\set spGrpN {0}
  \global\set spGrpOpen {0}
  \global\set spGrpLane {-2.6}
  \global\set spHair {0}
  \global\set spSpan {0}
  \global\set spSince {0}
  \global\set spItemTop {1.1}
  // spX follows the drawing cursor, from the first note; spEnd is where the staff should stop, and spInk the
  // right edge of the furthest syllable or chord name.
  \global\set spX {0}
  \global\set spEnd {0}
  \global\set spInk {0}
  \global\set spPrevNote {-1}
  \global\set spPrevAdv {0}
  \global\set spBarSince {0}
  \musicSpaceWalk{\msList}
  \musicDynGroupClose
  \global\set msPlanEnd {\spEnd}
  \global\set msPlanInk {\spInk}}

\def musicSpaceWalk items {
  \if {\size{\items}}
    \set st {\head{\items}}
    \global\set spAdv {0}
    \musicTokKind{\st}
    \if {\= {\msKind} {chord}}
      \musicChordName{\st}
      \musicChordMeasure{\msChordStr}
      \global\set spChW {\msChordWv}
      \global\set msChordOn {1}
      \set scn {\msChordN}
      \global\set msChordN {\calc{scn + 1}}
    \else \if {\= {\msKind} {note}}
      \musicSpaceNote{\st}{\tail{\items}}
    \else
      \musicSpaceMark{\st}
    \fi \fi
    \global\set msTokAdv {\append{\msTokAdv}{\spAdv}}
    \musicSpaceWalk{\tail{\items}}
  \fi}

// The advance for one note or rest (tok), given the tokens after it (rest).
\def musicSpaceNote tok rest {
  \musicParse{\tok}
  \if {\= {\msAcc} {none}} \else \musicSpaceAcc \fi
  \global\set spLyrNeed {0}
  \global\set spSylW {0}
  \if {\= {\msLyr} {1}} \if {\= {\msLetter} {r}} \else \musicSpaceSyllable \fi \fi
  \global\set spChNeed {0}
  \global\set spChRight {0}
  \if {\> {\spChW} {0}} \musicSpaceChord{\rest} \fi
  \set snL {\spLyrNeed}
  \set snC {\spChNeed}
  \set snA {\calc{max(musicnote, snL, snC)}}
  \global\set spAdv {\snA}
  \set snX {\msSpaceExtra}
  \global\set msSpaceExtra {\calc{snX + snA - musicnote}}
  // How far this note's syllable (centred on its head) and chord name (from its head) reach, and the cursor and
  // staff end moving on by its advance.
  \set snP {\spX}
  \set snSw {\spSylW}
  \set snCr {\spChRight}
  \set snI {\spInk}
  \global\set spInk {\calc{max(snI, snP + msHeadW / 2 + snSw / 2, snP + snCr)}}
  \global\set spX {\calc{snP + snA}}
  \global\set spEnd {\calc{snP + snA}}
  // This note is the one an accidental on the next note would have to clear.
  \set snTi {\size{\msTokAdv}}
  \global\set spPrevNote {\calc{snTi + 1}}
  \global\set spPrevAdv {\snA}
  \global\set spBarSince {0}
  \global\set spPrevLedger {0}
  \if {\= {\msLetter} {r}} \else \musicSpaceLedger \fi
  // A rest's ink sits inside the staff, so it lowers nothing, but it still counts as one of a mark's notes.
  \global\set spLow {0}
  \if {\= {\msLetter} {r}} \else \musicSpaceLow \fi
  \musicDynNote}

// Whether this note sits on or beyond a ledger line, into spPrevLedger, for the accidental on the note after it.
\def musicSpaceLedger {
  \set sgI {\mapget musicLetters {\msLetter}}
  \set sgSt {\calc{msOct * 7 + sgI - msBase}}
  \if {\<= {\sgSt} {-2}} \global\set spPrevLedger {1} \fi
  \if {\>= {\sgSt} {10}} \global\set spPrevLedger {1} \fi}

// An accidental is drawn to the left of its head (musicAccidental), into the gap after the note before, so that
// gap must hold it: from the previous head's right edge, half a staff space of white, then the sign. When the
// note before came straight before this one (no barline between — a barline makes its own room), its advance is
// widened to fit, and everything after moves right with it.
\def musicSpaceAcc {
  \set saI {\mapget musicLetters {\msLetter}}
  \set saSt {\calc{msOct * 7 + saI - msBase}}
  \musicAccLeft{\saSt}
  \if {\= {\spBarSince} {0}} \if {\> {\spPrevNote} {0}} \musicSpaceAccWiden \fi \fi}

// The note before needs its head, its ledger line's overhang if it has one, and three-fifths of a staff space of
// white before the sign.
\def musicSpaceAccWiden {
  \set swOld {\spPrevAdv}
  \set swLeft {\msAccLeftV}
  \set swLed {\spPrevLedger}
  \set swNeed {\calc{msHeadW + swLed * 0.4 * g + 0.6 * g + swLeft}}
  \set swNew {\calc{max(swOld, swNeed)}}
  \set swD {\calc{swNew - swOld}}
  \set swI {\spPrevNote}
  \global\set msTokAdv {\put{\msTokAdv}{\swI}{\swNew}}
  \set swX {\spX}
  \set swE {\spEnd}
  \global\set spX {\calc{swX + swD}}
  \global\set spEnd {\calc{swE + swD}}}

// The marks that matter to the plan: a beam or slur opening and closing (they decide which way stems point and
// what hangs below the notes), and a dynamic or hairpin, which means the score needs its dynamics lane.
\def musicSpaceMark tok {
  \if {\= {\tok} {[}} \global\set spBeam {1} \fi
  \if {\= {\tok} {]}} \global\set spBeam {0} \fi
  \if {\= {\tok} {(}} \global\set spSlur {1} \fi
  \if {\= {\tok} {)}} \global\set spSlur {0} \fi
  \if {\= {\tok} {<}} \musicDynItem \global\set spHair {1} \musicDynTopHair \fi
  \if {\= {\tok} {>}} \musicDynItem \global\set spHair {1} \musicDynTopHair \fi
  \if {\= {\tok} {=}} \global\set spHair {0} \global\set spSince {0} \fi
  \if {\= {\head{\cat{\tok}{}}} {!}} \musicDynItem \global\set spSpan {2} \musicDynTopLetters{\tail{\cat{\tok}{}}} \fi
  \if {\= {\tok} {|}} \musicSpaceBar{0.6}{0.08} \fi
  \if {\= {\tok} {||}} \musicSpaceBar{0.7}{0.53} \fi
  \if {\= {\tok} {|.}} \musicSpaceBar{0.8}{0.8} \fi
  \if {\= {\tok} {|:}} \musicSpaceBar{1.0}{1.17} \fi
  \if {\= {\tok} {:|}} \musicSpaceBar{0.9}{1.2} \fi}

// A barline in the plan, as musicWalk advances past it (adv, in musicnote) and as far right as its rules and dots
// reach from its x (reach, in staff spaces) — where the staff ends if it closes the score.
\def musicSpaceBar adv reach {
  \global\set spBarSince {1}
  \set sbX {\spX}
  \global\set spEnd {\calc{sbX + \reach * g}}
  \global\set spX {\calc{sbX + \adv * musicnote}}}

// Dynamics and hairpins are set in groups, each on one line of its own just low enough to clear the notes it sits
// under, as an engraver places them: a dynamic, or a hairpin, that follows the last mark's notes with at most one
// note between joins its group (so p < f > p reads as one level line), and anything further on starts a new one.
// A dynamic's notes are its own and the next, which its letters reach over; a hairpin's are every note it spans.
// Each dynamic and hairpin token records its group's number in msDynTokGrp, and each group's lane — in staff
// spaces from the bottom line, never above the usual 2.6 — is appended to msDynLanes when the group closes.
\def musicDynItem {
  \global\set msDynOn {1}
  \set diNew {0}
  \if {\= {\spGrpOpen} {0}} \set diNew {1} \fi
  \if {\> {\spSince} {1}} \if {\= {\spHair} {0}} \set diNew {1} \fi \fi
  \if {\= {\diNew} {1}} \musicDynGroupClose \musicDynGroupOpen \fi
  \global\set msDynTokGrp {\append{\msDynTokGrp}{\spGrpN}}
  \global\set spSince {0}}

\def musicDynGroupOpen {
  \set dgN {\spGrpN}
  \global\set spGrpN {\calc{dgN + 1}}
  \global\set spGrpOpen {1}
  \global\set spGrpLane {-2.6}}

\def musicDynGroupClose {
  \if {\= {\spGrpOpen} {1}}
    \global\set msDynLanes {\append{\msDynLanes}{\spGrpLane}}
    \global\set msDynLane {\calc{min(msDynLane, spGrpLane)}}
    \global\set spGrpOpen {0}
  \fi}

// Count this note or rest against the open group: when a hairpin is open or the last dynamic still reaches over
// it, its lowest ink (spLow, for a note) lowers the group's lane; otherwise it is one more note since the group's
// last mark.
\def musicDynNote {
  \if {\= {\spGrpOpen} {1}}
    \if {\= {\spHair} {1}} \musicDynLower
    \else \if {\> {\spSpan} {0}} \musicDynLower
    \else \global\set spSince {\calc{spSince + 1}}
    \fi \fi
  \else \global\set spSince {\calc{spSince + 1}}
  \fi}

// The marks over this note keep three-fifths of a staff space clear of its lowest ink.
\def musicDynLower {
  \global\set spGrpLane {\calc{min(spGrpLane, spLow - spItemTop - 0.6)}}
  \global\set spSpan {\calc{max(0, spSpan - 1)}}
  \if {\= {\spSpan} {0}} \global\set spItemTop {1.1} \fi
  \global\set spSince {0}}

// How far above the lane's baseline the marks over the current note reach (spItemTop, staff spaces): a hairpin's
// upper rule 1.1, or a dynamic's tallest letter as the music font draws it (an f rises well above a p or an m). A
// hairpin opened while a dynamic's letters still reach over a note keeps the taller of the two.
\def musicDynTopHair {
  \if {\= {\spSpan} {0}} \global\set spItemTop {1.1} \fi}

\def musicDynTopLetters s {
  \global\set spItemTop {0}
  \musicDynTopScan{\s}}

\def musicDynTopScan s {
  \if {\size{\s}}
    \musicDynGlyph{\head{\s}}
    \global\set spItemTop {\calc{max(spItemTop, \glyphheight{\musicfont}{\fs}{\msDynCp} / g)}}
    \musicDynTopScan{\tail{\s}}
  \fi}

// The music-font glyph for one dynamic letter (p m f r s z n), into msDynCp; any other letter reads as f.
\set musicDynGlyphs {\map{p 58656 m 58657 f 58658 r 58659 s 58660 z 58661 n 58662}}
\def musicDynGlyph c {
  \global\set msDynCp {\cpDynF}
  \if {\= {\mapget musicDynGlyphs {\c}} {}} \else \global\set msDynCp {\mapget musicDynGlyphs {\c}} \fi}

// In the drawing walk: a dynamic or hairpin token moves msUnder to its group's lane.
\def musicDynLaneNext {
  \global\set msDynI {\calc{msDynI + 1}}
  \set msUnder {\calc{msBottom + \nth{\msDynLanes}{\nth{\msDynTokGrp}{\msDynI}} * g}}}

// The lowest ink of this note, into spLow, in staff spaces from the bottom line: the bottom of its head; the foot
// of a down-stem (as long as musicStem draws it); the articulations stacked under an up-stemmed note; and the slur
// that bows under it when its stem is up. The marks over the note then keep three-fifths of a staff space clear
// of that point (musicDynLower).
\def musicSpaceLow {
  \set slI {\mapget musicLetters {\msLetter}}
  \set slSt {\calc{msOct * 7 + slI - msBase}}
  \set slLow {\calc{slSt / 2 - 0.5}}
  \set slDown {0}
  \if {\>= {\slSt} {4}} \if {\= {\spBeam} {0}} \if {\>= {\msDur} {2}} \set slDown {1} \fi \fi \fi
  \if {\= {\slDown} {1}}
    \musicDownStemLen{\msDur}
    \set slLow {\calc{min(slLow, slSt / 2 - msDownLen / g)}}
  \else
    \set slArt {\calc{msArtStacc + msArtTen + msArtAccent + msArtMarc}}
    \if {\> {\slArt} {0}} \set slLow {\calc{min(slLow, slSt / 2 - 1.1 - (slArt - 1) * 0.9 - 0.45)}} \fi
    \if {\= {\spSlur} {1}} \set slLow {\calc{min(slLow, slSt / 2 - 2.9)}} \fi
  \fi
  \global\set spLow {\slLow}}

// The room sung note spJ needs before the next: half its syllable, half the next one's, the gap, and a hyphen
// with a second gap when the two are one word.
\def musicSpaceSyllable {
  \set sk {\spJ}
  \if {\<= {\sk} {\msSylN}}
    \set skn {\calc{sk + 1}}
    \set swb {0}
    \if {\< {\sk} {\msSylN}} \set swb {\nth{\msSylW}{\skn}} \fi
    \set swa {\nth{\msSylW}{\sk}}
    \global\set spSylW {\swa}
    \set sha {\nth{\msSylH}{\sk}}
    \set shw {\msHyphW}
    \global\set spLyrNeed {\calc{swa / 2 + swb / 2 + musiclyricgap + sha * (shw + musiclyricgap)}}
  \fi
  \global\set spJ {\calc{sk + 1}}}

// A chord name on this note or rest: when the next note or rest also names a chord, or nothing follows, the
// name needs its own width and the gap before the next can begin.
\def musicSpaceChord rest {
  \global\set spChRight {\spChW}
  \musicNextChord{\rest}
  \if {\= {\msNextChord} {1}}
    \set scw {\spChW}
    \global\set spChNeed {\calc{scw + musicchordgap}}
  \fi
  \global\set spChW {0}}

// Whether the next note or rest in `items` carries a chord name (1 when the list ends first, since a name on the
// last note must still fit inside the score), into msNextChord.
\def musicNextChord items {
  \if {\size{\items}}
    \musicTokKind{\head{\items}}
    \if {\= {\msKind} {chord}} \global\set msNextChord {1}
    \else \if {\= {\msKind} {note}} \global\set msNextChord {0}
    \else \musicNextChord{\tail{\items}}
    \fi \fi
  \else \global\set msNextChord {1}
  \fi}

// Classify a score token into msKind: `chord` for a "…" name, `note` for a note or rest, `mark` for everything
// else (brackets, barlines, dynamics, hairpins), which takes no room of its own.
\set musicNoteStarts {\map{a 1 b 1 c 1 d 1 e 1 f 1 g 1 r 1 n 1 + 1 - 1}}
\def musicTokKind tok {
  \set tkc {\head{\cat{\tok}{}}}
  \global\set msKind {mark}
  \if {\= {\tkc} {"}} \global\set msKind {chord}
  \else \if {\= {\mapget musicNoteStarts {\tkc}} {1}} \global\set msKind {note}
  \fi \fi}

// ---- Barlines ------------------------------------------------------------------
// The pieces every barline kind is built from: a thin rule, a thick rule, and the pair of repeat dots in the
// two middle spaces. Each takes its x so a compound barline can place several side by side.
\def musicBarThin x {
  \nofill \stroke{\musiccolor} \linewidth{\calc{0.16 * g}}
  \line{\x \msBottom  \x \msTop}}

\def musicBarThick x {
  \nofill \stroke{\musiccolor} \linewidth{\calc{0.5 * g}}
  \line{\x \msBottom  \x \msTop}}

\def musicBarDots x {
  \fill{\musiccolor} \nostroke
  \circle{\x \calc{msBottom + 1.5 * g} \calc{0.22 * g}}
  \circle{\x \calc{msBottom + 2.5 * g} \calc{0.22 * g}}}

// A double barline (two thin rules), a final barline (a thin rule then a thick one), and the two repeat
// barlines (a thick and thin rule with the dots on the inside of the repeated span).
\def musicBarDouble {
  \musicBarThin{\msX}
  \musicBarThin{\calc{msX + 0.45 * g}}}

\def musicBarFinal {
  \musicBarThin{\msX}
  \musicBarThick{\calc{msX + 0.55 * g}}}

\def musicBarRepeatStart {
  \musicBarThick{\msX}
  \musicBarThin{\calc{msX + 0.55 * g}}
  \musicBarDots{\calc{msX + 0.95 * g}}}

\def musicBarRepeatEnd {
  \musicBarDots{\msX}
  \musicBarThin{\calc{msX + 0.4 * g}}
  \musicBarThick{\calc{msX + 0.95 * g}}}

// ---- One note ------------------------------------------------------------------
// Parse the token into pitch class, octave offset, and duration; place the head; then the stem and flag
// (for half notes and shorter), and any ledger lines. msX is the left edge of the head; the head glyph is
// stamped origin-on-point with a baseline anchor, since a notehead's origin is its left edge on the line.
\def musicNote tok {
  \musicParse{\tok}
  \if {\= {\msLetter} {r}}
    \musicRest
  \else
    \set li {\mapget musicLetters {\msLetter}}
    \set step {\calc{msOct * 7 + li - msBase}}
    \set ny {\calc{msBottom + step * g / 2}}
    \musicLedgers{\step}
    \musicAccidental
    // The head: a black notehead for a quarter or shorter, an open half-note head, or a whole-note head.
    \fill{\musiccolor} \nostroke
    \if {\>= {\msDur} {4}} \set msHead {\cpNoteBlack}
    \else \if {\= {\msDur} {2}} \set msHead {\cpNoteHalf}
    \else \set msHead {\cpNoteWhole} \fi \fi
    \fontglyph anchor:baseline {\msX \ny}{\musicfont}{\fs}{\msHead}
    \musicDot
    // The stem and any flag. In a beamed run every note shares one beam; otherwise the stem rises on the right
    // of low notes and falls on the left of high ones, flipping at the middle line, and a flagged note (eighth
    // or shorter) gets its own flag. A whole note has no stem at all.
    \if {\= {\msBeam} {1}}
      \musicBeamedStem
    \else \if {\>= {\msDur} {2}}
      \musicStem
    \fi \fi
    // Articulations sit on the side away from the stem, so they need the stem direction: up for a low note or
    // any beamed note, down for a high one.
    \set msStemUp {0}
    \if {\< {\step} {4}} \set msStemUp {1} \fi
    \if {\= {\msBeam} {1}} \set msStemUp {1} \fi
    \set msHasStem {0}
    \if {\>= {\msDur} {2}} \set msHasStem {1} \fi
    \if {\= {\msBeam} {1}} \set msHasStem {1} \fi
    \musicArtic
    //
    // The expression marks this note takes part in, each kept in globals that outlive the walk's recursion. First
    // this note's reference point, the head's centre, where a hairpin running up to it ends.
    \global\set msNoteX {\calc{msX + msHeadW / 2}}
    // A tie opened by the note before closes here, from that note's right edge to this head's left; and this note
    // opens one in turn if it carries the mark.
    \if {\= {\msTiePending} {1}} \musicDrawTie{\msTieXop}{\msTieY}{\msX} \fi
    \global\set msTiePending {\msTie}
    \if {\= {\msTie} {1}}
      \global\set msTieXop {\calc{msX + msHeadW}}
      \global\set msTieY {\ny}
    \fi
    \if {\= {\msSlur} {1}} \musicSlurNote \fi
    // A hairpin's left end is the first note after it opens.
    \if {\= {\msHairArmed} {1}}
      \global\set msHairXst {\calc{msX + msHeadW / 2}}
      \global\set msHairArmed {0}
    \fi
    // A dynamic's letters start under the note it precedes.
    \if {\= {\msDynArmed} {1}}
      \global\set dynX {\msX}
      \fill{\musiccolor} \nostroke
      \musicDynChars{\msDynStr}
      \global\set msDynArmed {0}
    \fi
  \fi}

// This note's part in an open slur: the first note of the run fixes the start, every note pushes out the end. Both
// ends are kept for either side the slur may take — below, by the head's centre height, and above, a little over
// the head or over the stem tip of an up-stemmed note — and any down-stem in the run sends the slur above.
\def musicSlurNote {
  \set snAbove {\calc{ny + 1.1 * g + msStemUp * msHasStem * 2.6 * g}}
  \if {\= {\msSlurStarted} {0}}
    \global\set msSlurXst {\calc{msX + msHeadW / 2}}
    \global\set msSlurYst {\ny}
    \global\set msSlurYstA {\snAbove}
    \global\set msSlurStarted {1}
  \fi
  \global\set msSlurXen {\calc{msX + msHeadW / 2}}
  \global\set msSlurYen {\ny}
  \global\set msSlurYenA {\snAbove}
  \if {\= {\msHasStem} {1}}
    \if {\= {\msStemUp} {0}} \global\set msSlurDown {1} \fi
  \fi}

// An augmentation dot, drawn right of the head for a dotted note. A dot belongs in a space, so when the head
// sits on a line (an even step) the dot is nudged up into the space above; in a space it stays on the line.
\def musicDot {
  \if {\= {\msDot} {1}}
    \fill{\musiccolor} \nostroke
    \set msDotY {\ny}
    \if {\= {\calc{step - 2 * floor(step / 2)}} {0}} \set msDotY {\calc{ny + g / 2}} \fi
    \fontglyph anchor:west {\calc{msX + msHeadW + 0.35 * g} \msDotY}{\musicfont}{\fs}{\cpAugDot}
  \fi}

// The stem and, for an eighth note, its flag. A note below the middle line stems up on the head's right edge,
// one at or above it stems down on its left; the stem meets the head at its centre height. The head's right
// edge comes from the font (msHeadW), so the stem seats correctly whatever music font is in use.
// The length of a down-stem for a note of duration dur, into msDownLen (points). A down-stem sits on the head's
// left, and its flag curls back up on the head's side; on a plain-length stem the flag's tip would run into the
// head, so a flagged down-stem is made long enough that the flag — measured from the music font, so this holds
// for any face — stops a quarter of a staff space below the head.
\def musicDownStemLen dur {
  \global\set msDownLen {\calc{3.3 * g}}
  \if {\>= {\dur} {8}}
    \set dsFlag {\cpEighthFlagDown}
    \if {\>= {\dur} {16}} \set dsFlag {\cpSixteenthFlagDown} \fi
    \set dsFlagH {\glyphheight{\musicfont}{\fs}{\dsFlag}}
    \global\set msDownLen {\calc{max(3.3 * g, dsFlagH + 0.75 * g)}}
  \fi}

\def musicStem {
  \nofill \stroke{\musiccolor} \linewidth{\calc{0.12 * g}}
  \set msStemLen {\calc{3.3 * g}}
  \if {\< {\step} {4}}
    \set msStemX {\calc{msX + msHeadW - msStemHalf}}
    \set msStemTop {\calc{ny + msStemLen}}
    \line{\msStemX \calc{ny + msStemAttach}  \msStemX \msStemTop}
    \if {\>= {\msDur} {16}}
      \fill{\musiccolor} \nostroke
      \fontglyph anchor:baseline {\calc{msStemX - msStemHalf} \msStemTop}{\musicfont}{\fs}{\cpSixteenthFlagUp}
    \else \if {\>= {\msDur} {8}}
      \fill{\musiccolor} \nostroke
      \fontglyph anchor:baseline {\calc{msStemX - msStemHalf} \msStemTop}{\musicfont}{\fs}{\cpEighthFlagUp}
    \fi \fi
  \else
    \musicDownStemLen{\msDur}
    \set msStemLen {\msDownLen}
    \set msStemX {\calc{msX + msStemHalf}}
    \set msStemTop {\calc{ny - msStemLen}}
    \line{\msStemX \calc{ny - msStemAttach}  \msStemX \msStemTop}
    \if {\>= {\msDur} {16}}
      \fill{\musiccolor} \nostroke
      \fontglyph anchor:baseline {\msStemX \msStemTop}{\musicfont}{\fs}{\cpSixteenthFlagDown}
    \else \if {\>= {\msDur} {8}}
      \fill{\musiccolor} \nostroke
      \fontglyph anchor:baseline {\msStemX \msStemTop}{\musicfont}{\fs}{\cpEighthFlagDown}
    \fi \fi
  \fi}

// Measure the beam line for the run that starts at the head of `items` and ends at the next `]`. The beam is an
// up-stem beam above the staff; its line is recorded as a start height (msBeamYZero, at the first note) and a slope
// (msBeamDy, the rise from one note to the next), so each note finds the beam at its own position. The slope
// follows the run's first-to-last pitch but is clamped so a wide leap does not tilt the beam wildly, and the
// whole line is then shifted up so even the highest interior note keeps a stem of at least msBeamMin.
\def musicBeamLine items {
  \global\set bmCount {0}
  \global\set bmFirst {0}
  \global\set bmSZero {0}
  \global\set bmSN {0}
  \musicBeamMeasure{\items}
  \set bmNyZero {\calc{msBottom + bmSZero * g / 2}}
  \set bmRise {\calc{(bmSN - bmSZero) * g / 2}}
  \set bmCap {\calc{1.5 * g}}
  \if {\> {\bmRise} {\bmCap}} \set bmRise {\bmCap} \fi
  \if {\< {\bmRise} {\calc{0 - bmCap}}} \set bmRise {\calc{0 - bmCap}} \fi
  \global\set msBeamYZero {\calc{bmNyZero + 3.3 * g}}
  \global\set msBeamDy {0}
  \if {\> {\bmCount} {1}} \global\set msBeamDy {\calc{bmRise / (bmCount - 1)}} \fi
  // Raise the line until every note clears it by at least msBeamMin staff spaces, so an interior peak (an arch
  // like c g c) never pokes through the beam.
  \global\set bmJ {0}
  \global\set bmShift {0}
  \musicBeamClear{\items}
  \global\set msBeamYZero {\calc{msBeamYZero + bmShift}}
  \global\set msBeamJ {0}}

// First pass: count the notes in the run and record the diatonic step of its first and last note.
\def musicBeamMeasure items {
  \if {\size{\items}}
    \set tok {\head{\items}}
    \if {\= {\tok} {]}} \else
      \musicParse{\tok}
      \set li {\mapget musicLetters {\msLetter}}
      \set bs {\calc{msOct * 7 + li - msBase}}
      \if {\= {\bmFirst} {0}} \global\set bmSZero {\bs} \global\set bmFirst {1} \fi
      \global\set bmSN {\bs}
      \global\set bmCount {\calc{bmCount + 1}}
      \musicBeamMeasure{\tail{\items}}
    \fi
  \fi}

// Second pass: for each note find how far the provisional beam line falls short of a full stem above it, and
// keep the largest such shortfall in bmShift; adding it to the line lengthens the tightest stem to msBeamMin.
\def musicBeamClear items {
  \if {\size{\items}}
    \set tok {\head{\items}}
    \if {\= {\tok} {]}} \else
      \musicParse{\tok}
      \set li {\mapget musicLetters {\msLetter}}
      \set bs {\calc{msOct * 7 + li - msBase}}
      \set bny {\calc{msBottom + bs * g / 2}}
      \set bby {\calc{msBeamYZero + bmJ * msBeamDy}}
      \set bneed {\calc{bny + 2.5 * g - bby}}
      \if {\> {\bneed} {\bmShift}} \global\set bmShift {\bneed} \fi
      \global\set bmJ {\calc{bmJ + 1}}
      \musicBeamClear{\tail{\items}}
    \fi
  \fi}

// A note inside a beamed run: an up-stem reaching the beam line at this note's place in the run (msBeamYcur),
// joined to the previous note by a thick bar along the line. A run of sixteenths carries a second beam parallel
// to and just below the first. The first note of a run only records its stem foot for the next to beam to.
\def musicBeamedStem {
  \nofill \stroke{\musiccolor} \linewidth{\calc{0.12 * g}}
  \set msStemX {\calc{msX + msHeadW - msStemHalf}}
  \set msBeamYcur {\calc{msBeamYZero + msBeamJ * msBeamDy}}
  \line{\msStemX \calc{ny + msStemAttach}  \msStemX \msBeamYcur}
  \if {\= {\msBeamPrev} {1}}
    \linewidth{\calc{0.5 * g}}
    // Run the beam half a stem-width past each stem centre so it ends flush with the outer edge of the stem
    // rather than leaving the stem's corner poking out; interior segments simply overlap at the shared stems.
    \line{\calc{msBeamPrevX - msStemHalf} \msBeamPrevY  \calc{msStemX + msStemHalf} \msBeamYcur}
    // A second beam, three-quarters of a staff space below the first, parallel to it, for a run of sixteenths.
    \if {\>= {\msDur} {16}}
      \line{\calc{msBeamPrevX - msStemHalf} \calc{msBeamPrevY - 0.75 * g}  \calc{msStemX + msStemHalf} \calc{msBeamYcur - 0.75 * g}}
    \fi
  \fi
  \global\set msBeamPrev {1}
  \global\set msBeamPrevX {\msStemX}
  \global\set msBeamPrevY {\msBeamYcur}
  \global\set msBeamJ {\calc{msBeamJ + 1}}}

// Ledger lines for a note that sits outside the staff: short rules on the even steps between the staff edge
// and the note (step 0 is the bottom line, step 8 the top), centred on the head and overhanging it a little.
\def musicLedgers step {
  \nofill \stroke{\musiccolor} \linewidth{\calc{0.16 * g}}
  \if {\<= {\step} {-2}}
    \set nb {\calc{floor((0 - (\step)) / 2)}}
    \for\k{\range{1}{\nb}}{
      \set ly {\calc{msBottom - \k * g}}
      \line{\calc{msX - 0.4 * g} \ly  \calc{msX + msHeadW + 0.4 * g} \ly}
    }
  \fi
  \if {\>= {\step} {10}}
    \set na {\calc{floor(((\step) - 8) / 2)}}
    \for\k{\range{1}{\na}}{
      \set ly {\calc{msTop + \k * g}}
      \line{\calc{msX - 0.4 * g} \ly  \calc{msX + msHeadW + 0.4 * g} \ly}
    }
  \fi}

// A rest sized to its duration, stamped from the music font. A whole rest hangs under the second line from the
// top, a half rest sits on the middle line, and quarter and eighth rests centre on the middle line.
\def musicRest {
  \fill{\musiccolor} \nostroke
  \if {\= {\msDur} {1}}
    \fontglyph anchor:baseline {\msX \calc{msBottom + 3 * g}}{\musicfont}{\fs}{\cpRestWhole}
  \else \if {\= {\msDur} {2}}
    \fontglyph anchor:baseline {\msX \msMiddle}{\musicfont}{\fs}{\cpRestHalf}
  \else \if {\>= {\msDur} {8}}
    \fontglyph anchor:west {\msX \msMiddle}{\musicfont}{\fs}{\cpEighthRest}
  \else
    \fontglyph anchor:west {\msX \msMiddle}{\musicfont}{\fs}{\cpRestQuarter}
  \fi \fi \fi}

// ---- Accidentals ---------------------------------------------------------------
// A sharp, flat or natural sign drawn just left of the head, its glyph origin (centred on the note line) set
// a glyph-width plus a small gap to the left of the head. The widths are the glyphs' own, in staff spaces.
\def musicAccidental {
  \if {\= {\msAcc} {none}} \else
    \fill{\musiccolor} \nostroke
    \musicAccLeft{\step}
    \fontglyph anchor:baseline {\calc{msX - msAccLeftV} \ny}{\musicfont}{\fs}{\msAccCp}
  \fi}

// How far left of its head an accidental's glyph starts (msAccLeftV, points), and which glyph it is (msAccCp): its
// own width, read from the music font, then a quarter-space of white — and, for a note on a ledger line, the
// ledger's overhang besides, since the sign stands clear of the ledger line rather than across it.
\def musicAccLeft st {
  \global\set msAccCp {\cpAccNatural}
  \if {\= {\msAcc} {sharp}} \global\set msAccCp {\cpAccSharp} \fi
  \if {\= {\msAcc} {flat}} \global\set msAccCp {\cpAccFlat} \fi
  \set alW {\glyphwidth{\musicfont}{\fs}{\msAccCp}}
  \set alLed {0}
  \if {\<= {\st} {-2}} \set alLed {1} \fi
  \if {\>= {\st} {10}} \set alLed {1} \fi
  \global\set msAccLeftV {\calc{alW + 0.25 * g + alLed * 0.4 * g}}}

// ---- Articulations -------------------------------------------------------------
// The articulations parsed off the note (staccato, tenuto, accent, marcato), each on the side away from the
// stem: below an up-stem note, above a down-stem one. They stack outward from the head — artK counts how many
// are already placed so each clears the last. A fermata is different: it always arches well above the note.
\def musicArtic {
  \fill{\musiccolor} \nostroke
  \global\set artK {0}
  \if {\= {\msArtStacc} {1}} \musicArticGlyph{\cpStaccatoAbove}{\cpStaccatoBelow} \fi
  \if {\= {\msArtTen} {1}} \musicArticGlyph{\cpTenutoAbove}{\cpTenutoBelow} \fi
  \if {\= {\msArtAccent} {1}} \musicArticGlyph{\cpAccentAbove}{\cpAccentBelow} \fi
  \if {\= {\msArtMarc} {1}} \musicArticGlyph{\cpMarcatoAbove}{\cpMarcatoBelow} \fi
  \musicFermata}

// Place one articulation, choosing its above or below form from the stem direction and stepping it out past any
// already placed. artK is global so the count survives each enclosing \if; the glyph is centred over the head.
\def musicArticGlyph above below {
  \set artCx {\calc{msX + msHeadW / 2}}
  \if {\= {\msStemUp} {1}}
    \fontglyph anchor:center {\artCx \calc{ny - 1.1 * g - artK * 0.9 * g}}{\musicfont}{\fs}{\below}
  \else
    \fontglyph anchor:center {\artCx \calc{ny + 1.1 * g + artK * 0.9 * g}}{\musicfont}{\fs}{\above}
  \fi
  \global\set artK {\calc{artK + 1}}}

// A fermata, arched above the note — above the top staff line, or higher still if the note reaches above it.
\def musicFermata {
  \if {\= {\msArtFerm} {1}}
    \fill{\musiccolor} \nostroke
    \global\set ferY {\calc{msTop + 1.8 * g}}
    \if {\> {\calc{ny + 2 * g}} {\ferY}} \global\set ferY {\calc{ny + 2 * g}} \fi
    \fontglyph anchor:center {\calc{msX + msHeadW / 2} \ferY}{\musicfont}{\fs}{\cpFermataAbove}
  \fi}

// ---- Slurs and ties ------------------------------------------------------------
// A slur ( … ) and a tie are drawn as a cubic arc on the side away from the stems: under the notes when every
// stem in the run points up, as most do, and over them as soon as one points down, so the arc never cuts through
// a stem. The span endpoints are gathered in globals as the notes are walked (see musicNote): the slur keeps the
// first and last note of the run, on both sides, the tie the right edge and height of the note that opened it.

// Draw the slur for the run just closed by ), one arc from the first note (msSlurXst) to the last (msSlurXen). The
// globals are read into locals at this scope, then the arc is laid with control points pulled past the ends, below
// them or above.
\def musicSlurEnd {
  \if {\= {\msSlurStarted} {1}}
    \nofill \stroke{\musiccolor} \linewidth{\calc{0.13 * g}}
    \set slxLo {\msSlurXst}
    \set slxHi {\msSlurXen}
    \set slyZerog {\msSlurYst}
    \set slyOneg {\msSlurYen}
    \set slOff {-1.1}
    \set slBow {-1.4}
    \if {\= {\msSlurDown} {1}}
      \set slyZerog {\msSlurYstA}
      \set slyOneg {\msSlurYenA}
      \set slOff {0}
      \set slBow {1.4}
    \fi
    \set slDx {\calc{slxHi - slxLo}}
    \set slYlo {\calc{slyZerog + slOff * g}}
    \set slYhi {\calc{slyOneg + slOff * g}}
    \set slPeak {\calc{(slYlo + slYhi) / 2 + slBow * g}}
    \path{ \moveto{\slxLo \slYlo} \curveto{\calc{slxLo + slDx * 0.25} \slPeak  \calc{slxLo + slDx * 0.75} \slPeak  \slxHi \slYhi} }
  \fi}

// Draw one tie: a shallow arc bowing down from (xa, yy) at the first note's right edge to xb at the second note's
// left edge. Both notes share a pitch, so yy is common. The arguments are interpolated into locals before \calc,
// since the openers come from globals and \calc reads only lexical names. (Param names are letter-only — a digit
// in a name can't be referenced with a backslash inside \calc.)
\def musicDrawTie xa yy xb {
  \nofill \stroke{\musiccolor} \linewidth{\calc{0.13 * g}}
  \set txLo {\xa}
  \set txHi {\xb}
  \set tyy {\yy}
  \set tDx {\calc{txHi - txLo}}
  \set tY {\calc{tyy - 0.9 * g}}
  \set tPeak {\calc{tyy - 1.7 * g}}
  \path{ \moveto{\txLo \tY} \curveto{\calc{txLo + tDx * 0.3} \tPeak  \calc{txLo + tDx * 0.7} \tPeak  \txHi \tY} }}

// ---- Dynamics ------------------------------------------------------------------
// A dynamic token (!p, !mf, !sfz) sets its marks below the staff under the note it precedes (the walk arms it and
// the note renders it from msDynStr). The leading ! is dropped on the walk side; each remaining letter maps to
// its own SMuFL dynamic glyph, laid left to right and advancing by the glyph's own width so the marks butt up the
// way mf or sfz do.
\def musicDynChars s {
  \if {\size{\s}}
    \musicDynGlyph{\head{\s}}
    \fontglyph anchor:baseline {\dynX \msUnder}{\musicfont}{\fs}{\msDynCp}
    \global\set dynX {\calc{dynX + \glyphwidth{\musicfont}{\fs}{\msDynCp}}}
    \musicDynChars{\tail{\s}}
  \fi}

// ---- Hairpins ------------------------------------------------------------------
// A crescendo (<) or diminuendo (>) hairpin, closed by =, drawn as a pair of rules below the staff that open
// from a point to a spread. The crescendo points left (opening rightward); the diminuendo opens at the left and
// closes to a point on the right. msHairXst is the first spanned note's x; msNoteX the last note's x, the close.
\def musicHairpinEnd {
  \if {\> {\msHair} {0}}
    \nofill \stroke{\musiccolor} \linewidth{\calc{0.12 * g}}
    \set hpXlo {\msHairXst}
    \set hpXhi {\msNoteX}
    // The three heights are computed straight from the staff metrics (outer-scope locals), so they can be read
    // inside the kind-selecting \if by plain interpolation — no \calc that reads a value set above that \if.
    \set hpYc {\calc{msUnder + 0.6 * g}}
    \set hpHi {\calc{msUnder + 1.1 * g}}
    \set hpLo {\calc{msUnder + 0.1 * g}}
    \if {\= {\msHair} {1}}
      \line{\hpXlo \hpYc  \hpXhi \hpHi}
      \line{\hpXlo \hpYc  \hpXhi \hpLo}
    \else
      \line{\hpXlo \hpHi  \hpXhi \hpYc}
      \line{\hpXlo \hpLo  \hpXhi \hpYc}
    \fi
  \fi}

// ---- Key signature -------------------------------------------------------------
// The sharps or flats of the key, written after the clef in their conventional order and on their conventional
// staff positions (which differ by clef — see the musicSharpSteps/musicFlatSteps rows). A positive musickey
// draws that many sharps, a negative one that many flats. Each accidental is a music-font glyph seated with its
// baseline on the pitch's line, advancing 0.9 staff spaces from the previous one.
\def musicKeySig {
  \set ksN {\calc{musickey}}
  \if {\= {\musicclef} {tenor}} \set ksN {0} \fi   // tenor key-signature layout is irregular; not drawn
  \if {\= {\ksN} {0}} \else
    \fill{\musiccolor} \nostroke
    \if {\> {\ksN} {0}}
      \set ksGlyph {\cpAccSharp}
      \set ksCount {\ksN}
      \set ksSteps {\musicSharpStepsTreble}
      \if {\= {\musicclef} {bass}} \set ksSteps {\musicSharpStepsBass} \fi
      \if {\= {\musicclef} {alto}} \set ksSteps {\musicSharpStepsAlto} \fi
    \else
      \set ksGlyph {\cpAccFlat}
      \set ksCount {\calc{0 - ksN}}
      \set ksSteps {\musicFlatStepsTreble}
      \if {\= {\musicclef} {bass}} \set ksSteps {\musicFlatStepsBass} \fi
      \if {\= {\musicclef} {alto}} \set ksSteps {\musicFlatStepsAlto} \fi
    \fi
    \set ksX {\msKeyX}
    \set ksI {0}
    \musicKeyAccs{\ksSteps}
  \fi}

// Place the next key-signature accidental and recurse for the rest, advancing ksX and the count ksI across the
// staff. The counter is a plain variable (advanced eagerly with \set) and the recursion peels the steps list,
// so it stops at ksCount accidentals without doing arithmetic on a macro argument.
\def musicKeyAccs steps {
  \if {\< {\ksI} {\ksCount}}
    \set ksStep {\head{\steps}}
    \fontglyph anchor:baseline {\ksX \calc{msBottom + ksStep * g / 2}}{\musicfont}{\fs}{\ksGlyph}
    \set ksX {\calc{ksX + 0.9 * g}}
    \set ksI {\calc{ksI + 1}}
    \musicKeyAccs{\tail{\steps}}
  \fi}

// ---- Time signature ------------------------------------------------------------
// The numerator over the denominator, after the clef and key signature. Each is a row of the font's time-signature
// figures (timeSig0..9), centred on a common x: the numerator between the middle and top lines, the denominator
// between the middle and bottom. A figure is about two staff spaces tall and centred on its baseline, so
// placing the row's baseline a staff space above and below the middle line seats the pair across the staff.
\def musicTimeSig {
  \if {\size{\cat{\musictimenum}{}}}
    \set tsCenterX {\calc{msTimeX + msTimeW / 2}}
    \fill{\musiccolor} \nostroke
    \musicTimeRow{\musictimenum}{\calc{msMiddle + g}}
    \musicTimeRow{\musictimeden}{\calc{msMiddle - g}}
  \fi}

// One row of time-signature figures, centred on tsCenterX at height y. Each digit occupies a fixed cell so
// a two-digit signature (12, 16) stays centred as a block; the digit glyph is centred within its cell.
\def musicTimeRow digits y {
  \set ds {\cat{\digits}{}}
  \set n {\size{\ds}}
  \set cell {\calc{1.4 * g}}
  \set xZero {\calc{tsCenterX - n * cell / 2}}
  \set i {0}
  \musicTimeDigits{\ds}{\y}}

\def musicTimeDigits s y {
  \if {\size{\s}}
    \set d {\head{\s}}
    \set cx {\calc{xZero + i * cell + cell / 2}}
    \fontglyph anchor:center {\cx \y}{\musicfont}{\fs}{\calc{cpTimeDigitBase + \d}}
    \set i {\calc{i + 1}}
    \musicTimeDigits{\tail{\s}}{\y}
  \fi}

// ---- Note parsing --------------------------------------------------------------
// Set msAcc (accidental: sharp/flat/nat/none), msLetter (pitch class), msOct (octave offset from middle C's
// octave), msDur (1/2/4/8/16/32), and msDot (1 if dotted), plus a flag for each articulation (msArtAccent,
// msArtStacc, msArtTen, msArtMarc, msArtFerm) and msTie. An optional accidental (+ sharp, - flat, n natural)
// leads the token; then the letter, then any octave marks, a duration number, a trailing dot, then any
// articulation marks (> ! = * ;) and a tie (a trailing -). An accidental shifts the look, not the staff line — a sharpened
// C and a plain C sit on the same line — so it only chooses which sign is drawn. The duration's digits
// accumulate, so 16 and 32 read as one number, not two marks.
\def musicParse tok {
  \global\set ps {\cat{\tok}{}}
  \global\set msAcc {none}
  \set accCh {\head{\ps}}
  \if {\= {\accCh} {+}} \global\set msAcc {sharp} \global\set ps {\tail{\ps}}
  \else \if {\= {\accCh} {-}} \global\set msAcc {flat} \global\set ps {\tail{\ps}}
  \else \if {\= {\accCh} {n}} \global\set msAcc {nat} \global\set ps {\tail{\ps}}
  \fi \fi \fi
  \global\set msLetter {\head{\ps}}
  \global\set msOct {0}
  \global\set msDur {4}
  \global\set msDot {0}
  \global\set msDurSeen {0}
  \global\set msArtAccent {0}
  \global\set msArtStacc {0}
  \global\set msArtTen {0}
  \global\set msArtMarc {0}
  \global\set msArtFerm {0}
  \global\set msTie {0}
  \musicParseRest{\tail{\ps}}}

\def musicParseRest s {
  \if {\size{\s}}
    \set pc {\head{\s}}
    \if {\= {\pc} {'}} \global\set msOct {\calc{msOct + 1}}
    \else \if {\= {\pc} {,}} \global\set msOct {\calc{msOct - 1}}
    \else \if {\= {\pc} {.}} \global\set msDot {1}
    \else \if {\= {\pc} {>}} \global\set msArtAccent {1}
    \else \if {\= {\pc} {!}} \global\set msArtStacc {1}
    \else \if {\= {\pc} {=}} \global\set msArtTen {1}
    \else \if {\= {\pc} {*}} \global\set msArtMarc {1}
    \else \if {\= {\pc} {;}} \global\set msArtFerm {1}
    \else \if {\= {\pc} {-}} \global\set msTie {1}
    \else
      \if {\= {\msDurSeen} {0}} \global\set msDur {\calc{pc}} \global\set msDurSeen {1}
      \else \global\set msDur {\calc{msDur * 10 + pc}} \fi
    \fi \fi \fi \fi \fi \fi \fi \fi \fi
    \musicParseRest{\tail{\s}}
  \fi}

// ---- The clef ------------------------------------------------------------------
// The clef, stamped from the music font. Each clef's origin sits on the line it names, so a baseline anchor on
// that line seats the glyph: the G (treble) clef on the second line from the bottom, the F (bass) clef on the
// second from the top, and the C (alto/tenor) clef on the line that is middle C — the middle line for the alto,
// the fourth line for the tenor. A small left margin keeps the clef clear of the staff's left edge.
\def musicClef {
  \fill{\musiccolor} \nostroke
  \set msClefX {\calc{1.4 * g}}
  \if {\= {\musicclef} {bass}}
    \fontglyph anchor:baseline {\msClefX \calc{msBottom + 3 * g}}{\musicfont}{\fs}{\cpFClef}
  \else \if {\= {\musicclef} {alto}}
    \fontglyph anchor:baseline {\msClefX \calc{msBottom + 2 * g}}{\musicfont}{\fs}{\cpCClef}
  \else \if {\= {\musicclef} {tenor}}
    \fontglyph anchor:baseline {\msClefX \calc{msBottom + 3 * g}}{\musicfont}{\fs}{\cpCClef}
  \else
    \fontglyph anchor:baseline {\msClefX \calc{msBottom + 1 * g}}{\musicfont}{\fs}{\cpGClef}
  \fi \fi \fi}
