// music — staff notation drawn with Bravura, the reference font for SMuFL (Standard Music Font Layout),
// over the \picture vector layer. Import it with:
//
//     \use{music}
//
// A line of music is drawn by \score, whose body is a space-separated list of notes:
//
//     \score{c d e f g a b c'}
//     \score{e4 d4 c4 d4 | e4 e4 e2}
//
// A note is an optional accidental, a letter a–g, optional octave marks, then an optional duration digit:
//   - + - n    an accidental — sharp, flat, or natural — drawn just left of the head (it changes how the
//              note reads, not where it sits, so +c and c share a line)
//   - letter   the pitch class; lowercase c is middle C (one ledger line below the staff)
//   - ' or ,   raise / lower by an octave, repeatable (c' is the C above, c, the C below)
//   - 1 2 4 8  the duration — whole, half, quarter (the default), or eighth note
// `r` is a rest and `|` a barline. `[` and `]` bracket a run of notes joined by one beam instead of flags.
// So `g,2` is the G below middle C held for a half note, `+c'8` the C-sharp an octave up as an eighth, and
// `[ c d e f ]` four beamed notes. A time signature is drawn from \musictimenum / \musictimeden (see below).
//
// Heads, clefs, flags, rests, accidentals and time-signature figures are real engraved glyphs from Bravura,
// stamped with \fontglyph; stems, beams, staff lines, ledger lines and barlines are ruled. SMuFL draws every
// glyph to the convention that one staff space is a quarter of the em, so the font is set at a size of four
// staff spaces (\set fs inside \score) and its own coordinates fall straight onto the staff.

// ---- Configuration (override with \set after \use, before \score) ---------------
// Sizes are in points (72 per inch).
\set musicgap {8}          // space between adjacent staff lines — the staff space, the unit everything scales from
\set musicnote {22}        // horizontal advance from one note to the next
\set musicleft {44}        // x of the first note — leaves room for the clef
\set musicpad {30}         // vertical room above and below the staff for ledger lines, stems and flags
\set musiccolor {black}
\set musicclef {treble}    // treble or bass; chooses the clef and how pitches sit on the staff
\set musictimenum {}       // time-signature numerator, drawn after the clef (e.g. {3}); empty for no signature
\set musictimeden {}       // time-signature denominator (e.g. {4})
// c d e f g a b -> 0..6, the diatonic step of each pitch class within an octave.
\set musicLetters {\map{c 0 d 1 e 2 f 3 g 4 a 5 b 6}}

// ---- SMuFL codepoints ----------------------------------------------------------
// The Private-Use codepoints of the glyphs this package stamps. Names follow the SMuFL glyph registry.
\set cpGClef {57424}            // U+E050 gClef
\set cpFClef {57442}            // U+E062 fClef
\set cpNoteWhole {57506}        // U+E0A2 noteheadWhole
\set cpNoteHalf {57507}         // U+E0A3 noteheadHalf
\set cpNoteBlack {57508}        // U+E0A4 noteheadBlack
\set cpFlag8Up {57920}          // U+E240 flag8thUp
\set cpFlag8Down {57921}        // U+E241 flag8thDown
\set cpRestWhole {58595}        // U+E4E3 restWhole
\set cpRestHalf {58596}         // U+E4E4 restHalf
\set cpRestQuarter {58597}      // U+E4E5 restQuarter
\set cpRest8 {58598}            // U+E4E6 rest8th
\set cpAccFlat {57952}          // U+E260 accidentalFlat
\set cpAccNatural {57953}       // U+E261 accidentalNatural
\set cpAccSharp {57954}         // U+E262 accidentalSharp
\set cpTimeSig0 {57472}         // U+E080 timeSig0; a digit d is at cpTimeSig0 + d

// ---- The score -----------------------------------------------------------------
// \score sizes a picture to hold the notes, draws the five staff lines and the clef, then walks the note
// list left to right. The bottom staff line sits at y = musicpad; a pitch's vertical position is half the
// staff space per diatonic step above it. The font size fs is four staff spaces, so a Bravura glyph's own
// units (where the staff space is a quarter of the em) come out one staff space = musicgap points.
\def score notes {{
  \set msList {\seq{\notes}}
  \set msN {\size{\msList}}
  \set g {\musicgap}
  \set fs {\calc{4 * g}}

  // A time signature, if any, takes a column of its own after the clef; shift the music right to clear it.
  \set msShift {0}
  \if {\size{\cat{\musictimenum}{}}} \set msShift {\calc{2.6 * g}} \fi

  \set msW {\calc{musicleft + msShift + msN * musicnote + 12}}
  \set msBottom {\musicpad}
  \set msTop {\calc{msBottom + 4 * g}}
  \set msMiddle {\calc{msBottom + 2 * g}}
  \set msH {\calc{msBottom + 4 * g + musicpad}}

  // The common height of a beam: a flat bar above the staff, the same for every note in a run.
  \set msBeamY {\calc{msTop + 1.6 * g}}
  \set msBeam {0}

  // The diatonic step of the bottom line, used to place every pitch: E4 (index 2) on the treble staff,
  // G2 (index -10) on the bass. A note's index is msOct*7 + its pitch class; its step above the bottom
  // line is that index minus this base, and half the staff space per step gives its height.
  \set msBase {2}
  \if {\= {\musicclef} {bass}} \set msBase {-10} \fi

  \picture width:{\msW} height:{\msH} {
    \musicStaffLines
    \musicClef
    \musicTimeSig
    \set msX {\calc{musicleft + msShift}}
    \musicWalk{\msList}
  }
}}

// The five staff lines, spanning the full width, at the SMuFL staff-line thickness.
\def musicStaffLines {
  \nofill \stroke{\musiccolor} \linewidth{\calc{0.13 * g}}
  \for\i{\range{0}{4}}{
    \set ly {\calc{msBottom + \i * g}}
    \line{8 \ly  \calc{msW - 10} \ly}
  }}

// Walk the note list, advancing msX. A barline is drawn thin and advances less than a note. `[` and `]`
// open and close a beamed run: the notes between them share one flat beam instead of carrying flags.
\def musicWalk items {
  \if {\size{\items}}
    \set tok {\head{\items}}
    \if {\= {\tok} {[}}
      \global\set msBeam {1}
      \global\set msBeamPrev {0}
    \else \if {\= {\tok} {]}}
      \global\set msBeam {0}
    \else \if {\= {\tok} {|}}
      \musicBarline
      \set msX {\calc{msX + musicnote * 0.6}}
    \else
      \musicNote{\tok}
      \set msX {\calc{msX + musicnote}}
    \fi \fi \fi
    \musicWalk{\tail{\items}}
  \fi}

// A barline from the bottom to the top staff line, at the SMuFL thin-barline thickness.
\def musicBarline {
  \nofill \stroke{\musiccolor} \linewidth{\calc{0.16 * g}}
  \line{\msX \msBottom  \msX \msTop}}

// ---- One note ------------------------------------------------------------------
// Parse the token into pitch class, octave offset, and duration; place the head; then the stem and flag
// (for half notes and shorter), and any ledger lines. msX is the left edge of the head; the head glyph is
// stamped origin-on-point with a baseline anchor, since a notehead's origin is its left edge on the line.
\def musicNote tok {
  \musicParse{\tok}
  \if {\= {\msLetter} {r}}
    \musicRest
  \else
    \set li {\mapget musicLetters {\msLetter}}
    \set step {\calc{msOct * 7 + li - msBase}}
    \set ny {\calc{msBottom + step * g / 2}}
    \musicLedgers{\step}
    \musicAccidental
    // The head: a black notehead for a quarter or shorter, an open half-note head, or a whole-note head.
    \fill{\musiccolor} \nostroke
    \if {\>= {\msDur} {4}} \set msHead {\cpNoteBlack}
    \else \if {\= {\msDur} {2}} \set msHead {\cpNoteHalf}
    \else \set msHead {\cpNoteWhole} \fi \fi
    \fontglyph anchor:baseline {\msX \ny}{bravura}{\fs}{\msHead}
    // The stem and any flag. In a beamed run every note shares one flat beam; otherwise the stem rises on
    // the right of low notes and falls on the left of high ones, flipping at the middle line, and an eighth
    // note gets its own flag. A whole note has no stem at all.
    \if {\= {\msBeam} {1}}
      \musicBeamedStem
    \else \if {\>= {\msDur} {2}}
      \musicStem
    \fi \fi
  \fi}

// The stem and, for an eighth note, its flag. SMuFL gives each black/half head a stem-attachment anchor:
// stemUpSE = (1.18, 0.168) and stemDownNW = (0, -0.168) staff spaces from the head's origin. A note below
// the middle line stems up on the right, one at or above it stems down on the left.
\def musicStem {
  \nofill \stroke{\musiccolor} \linewidth{\calc{0.12 * g}}
  \set msStemLen {\calc{3.3 * g}}
  \if {\< {\step} {4}}
    \set msStemX {\calc{msX + 1.12 * g}}
    \set msStemFoot {\calc{ny - 0.168 * g}}
    \set msStemTop {\calc{ny + msStemLen}}
    \line{\msStemX \msStemFoot  \msStemX \msStemTop}
    \if {\>= {\msDur} {8}}
      \fill{\musiccolor} \nostroke
      \fontglyph anchor:baseline {\calc{msStemX - 0.06 * g} \msStemTop}{bravura}{\fs}{\cpFlag8Up}
    \fi
  \else
    \set msStemX {\calc{msX + 0.06 * g}}
    \set msStemFoot {\calc{ny + 0.168 * g}}
    \set msStemTop {\calc{ny - msStemLen}}
    \line{\msStemX \msStemFoot  \msStemX \msStemTop}
    \if {\>= {\msDur} {8}}
      \fill{\musiccolor} \nostroke
      \fontglyph anchor:baseline {\msStemX \msStemTop}{bravura}{\fs}{\cpFlag8Down}
    \fi
  \fi}

// A note inside a beamed run: an up-stem reaching the common beam height, joined to the previous note in
// the run by a thick flat bar at that height. The first note of a run only records its stem foot for the
// next to beam to.
\def musicBeamedStem {
  \nofill \stroke{\musiccolor} \linewidth{\calc{0.12 * g}}
  \set msStemX {\calc{msX + 1.12 * g}}
  \line{\msStemX \calc{ny - 0.168 * g}  \msStemX \msBeamY}
  \if {\= {\msBeamPrev} {1}}
    \linewidth{\calc{0.5 * g}}
    \line{\msBeamPrevX \msBeamY  \msStemX \msBeamY}
  \fi
  \global\set msBeamPrev {1}
  \global\set msBeamPrevX {\msStemX}}

// Ledger lines for a note that sits outside the staff: short rules on the even steps between the staff edge
// and the note (step 0 is the bottom line, step 8 the top), centred on the head and overhanging it a little.
\def musicLedgers step {
  \nofill \stroke{\musiccolor} \linewidth{\calc{0.16 * g}}
  \if {\<= {\step} {-2}}
    \set nb {\calc{floor((0 - (\step)) / 2)}}
    \for\k{\range{1}{\nb}}{
      \set ly {\calc{msBottom - \k * g}}
      \line{\calc{msX - 0.4 * g} \ly  \calc{msX + 1.58 * g} \ly}
    }
  \fi
  \if {\>= {\step} {10}}
    \set na {\calc{floor(((\step) - 8) / 2)}}
    \for\k{\range{1}{\na}}{
      \set ly {\calc{msTop + \k * g}}
      \line{\calc{msX - 0.4 * g} \ly  \calc{msX + 1.58 * g} \ly}
    }
  \fi}

// A rest sized to its duration, stamped from Bravura. A whole rest hangs under the second line from the
// top, a half rest sits on the middle line, and quarter and eighth rests centre on the middle line.
\def musicRest {
  \fill{\musiccolor} \nostroke
  \if {\= {\msDur} {1}}
    \fontglyph anchor:baseline {\msX \calc{msBottom + 3 * g}}{bravura}{\fs}{\cpRestWhole}
  \else \if {\= {\msDur} {2}}
    \fontglyph anchor:baseline {\msX \msMiddle}{bravura}{\fs}{\cpRestHalf}
  \else \if {\>= {\msDur} {8}}
    \fontglyph anchor:west {\msX \msMiddle}{bravura}{\fs}{\cpRest8}
  \else
    \fontglyph anchor:west {\msX \msMiddle}{bravura}{\fs}{\cpRestQuarter}
  \fi \fi \fi}

// ---- Accidentals ---------------------------------------------------------------
// A sharp, flat or natural sign drawn just left of the head, its glyph origin (centred on the note line) set
// a glyph-width plus a small gap to the left of the head. The widths are the glyphs' own, in staff spaces.
\def musicAccidental {
  \if {\= {\msAcc} {none}} \else
    \fill{\musiccolor} \nostroke
    \if {\= {\msAcc} {sharp}}
      \fontglyph anchor:baseline {\calc{msX - 1.2 * g} \ny}{bravura}{\fs}{\cpAccSharp}
    \else \if {\= {\msAcc} {flat}}
      \fontglyph anchor:baseline {\calc{msX - 1.1 * g} \ny}{bravura}{\fs}{\cpAccFlat}
    \else
      \fontglyph anchor:baseline {\calc{msX - 0.9 * g} \ny}{bravura}{\fs}{\cpAccNatural}
    \fi \fi
  \fi}

// ---- Time signature ------------------------------------------------------------
// The numerator over the denominator, just after the clef. Each is a row of Bravura time-signature figures
// (timeSig0..9), centred on a common x: the numerator between the middle and top lines, the denominator
// between the middle and bottom. A figure is about two staff spaces tall and centred on its baseline, so
// placing the row's baseline a staff space above and below the middle line seats the pair across the staff.
\def musicTimeSig {
  \if {\size{\cat{\musictimenum}{}}}
    \set tsCenterX {\calc{musicleft + 1.0 * g}}
    \fill{\musiccolor} \nostroke
    \musicTimeRow{\musictimenum}{\calc{msMiddle + g}}
    \musicTimeRow{\musictimeden}{\calc{msMiddle - g}}
  \fi}

// One row of time-signature figures, centred on tsCenterX at height y. Each digit occupies a fixed cell so
// a two-digit signature (12, 16) stays centred as a block; the digit glyph is centred within its cell.
\def musicTimeRow digits y {
  \set ds {\cat{\digits}{}}
  \set n {\size{\ds}}
  \set cell {\calc{1.9 * g}}
  \set x0 {\calc{tsCenterX - n * cell / 2}}
  \set i {0}
  \musicTimeDigits{\ds}{\y}}

\def musicTimeDigits s y {
  \if {\size{\s}}
    \set d {\head{\s}}
    \set cx {\calc{x0 + i * cell + cell / 2}}
    \fontglyph anchor:center {\cx \y}{bravura}{\fs}{\calc{cpTimeSig0 + \d}}
    \set i {\calc{i + 1}}
    \musicTimeDigits{\tail{\s}}{\y}
  \fi}

// ---- Note parsing --------------------------------------------------------------
// Set msAcc (accidental: sharp/flat/nat/none), msLetter (pitch class), msOct (octave offset from middle
// C's octave), msDur (1/2/4/8). An optional accidental (+ sharp, - flat, n natural) leads the token; then
// the letter, then octave marks and a duration digit. An accidental shifts the look, not the staff line —
// a sharpened C and a plain C sit on the same line — so it only chooses which sign is drawn.
\def musicParse tok {
  \global\set ps {\cat{\tok}{}}
  \global\set msAcc {none}
  \set accCh {\head{\ps}}
  \if {\= {\accCh} {+}} \global\set msAcc {sharp} \global\set ps {\tail{\ps}}
  \else \if {\= {\accCh} {-}} \global\set msAcc {flat} \global\set ps {\tail{\ps}}
  \else \if {\= {\accCh} {n}} \global\set msAcc {nat} \global\set ps {\tail{\ps}}
  \fi \fi \fi
  \global\set msLetter {\head{\ps}}
  \global\set msOct {0}
  \global\set msDur {4}
  \musicParseRest{\tail{\ps}}}

\def musicParseRest s {
  \if {\size{\s}}
    \set pc {\head{\s}}
    \if {\= {\pc} {'}} \global\set msOct {\calc{msOct + 1}}
    \else \if {\= {\pc} {,}} \global\set msOct {\calc{msOct - 1}}
    \else \global\set msDur {\calc{pc}} \fi \fi
    \musicParseRest{\tail{\s}}
  \fi}

// ---- The clef ------------------------------------------------------------------
// A G (treble) or F (bass) clef, stamped from Bravura. Each clef's origin sits on the line it names — the G
// clef on the second line from the bottom, the F clef on the second from the top — so a baseline anchor on
// that line seats the glyph correctly. A small left margin keeps it clear of the staff's left edge.
\def musicClef {
  \fill{\musiccolor} \nostroke
  \if {\= {\musicclef} {bass}}
    \fontglyph anchor:baseline {6 \calc{msBottom + 3 * g}}{bravura}{\fs}{\cpFClef}
  \else
    \fontglyph anchor:baseline {6 \calc{msBottom + 1 * g}}{bravura}{\fs}{\cpGClef}
  \fi}
