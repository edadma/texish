// ---- The score -----------------------------------------------------------------
// \score sizes a picture to hold the notes, draws the five staff lines and the clef,
// then walks the note list left to right. The bottom staff line sits at y = musicpad;
// a pitch's vertical position is half the line gap per diatonic step above it.
\def score notes {{
  \set msList {\seq{\notes}}
  \set msN {\size{\msList}}
  \set msW {\calc{musicleft + msN * musicnote + 12}}
  \set msBottom {\musicpad}
  \set msTop {\calc{msBottom + 4 * musicgap}}
  \set msH {\calc{msBottom + 4 * musicgap + musicpad}}

  \picture width:{\msW} height:{\msH} {
    \musicStaffLines
    \musicClef
    \set msX {\musicleft}
    \musicWalk{\msList}
  }
}}

// The five staff lines, spanning the full width.
\def musicStaffLines {
  \nofill \stroke{\musiccolor} \linewidth{0.8pt}
  \for\i{\range{0}{4}}{
    \set ly {\calc{msBottom + \i * musicgap}}
    \line{8 \ly  \calc{msW - 10} \ly}
  }}

// Walk the note list, advancing msX. A barline is drawn thin and advances less than a note.
\def musicWalk items {
  \if {\size{\items}}
    \set tok {\head{\items}}
    \if {\= {\tok} {|}}
      \musicBarline
      \set msX {\calc{msX + musicnote * 0.6}}
    \else
      \musicNote{\tok}
      \set msX {\calc{msX + musicnote}}
    \fi
    \musicWalk{\tail{\items}}
  \fi}

// A barline from the bottom to the top staff line.
\def musicBarline {
  \nofill \stroke{\musiccolor} \linewidth{0.9pt}
  \line{\msX \msBottom  \msX \msTop}}

// ---- One note ------------------------------------------------------------------
// Parse the token into pitch class, octave offset, and duration; place the head; then
// the stem and flag (for half notes and shorter), and any ledger lines.
\def musicNote tok {
  \musicParse{\tok}
  \if {\= {\msLetter} {r}}
    \musicRest
  \else
    \set li {\mapget musicLetters {\msLetter}}
    \set step {\calc{msOct * 7 + li - 2}}
    \set ny {\calc{msBottom + step * musicgap / 2}}
    \musicLedgers{\step}
    // The head: filled for a quarter note or shorter, open for a half or whole. Tilted
    // a little, as an engraved head is, by rotating the coordinate system around it.
    \group{
      \translate{\msX \ny}
      \rotate{20}
      \if {\>= {\msDur} {4}} \fill{\musiccolor} \nostroke
      \else \nofill \stroke{\musiccolor} \linewidth{1.1pt} \fi
      \ellipse{0 0 \musicheadrx \musicheadry}
    }
    // The stem (everything but a whole note) rises on the right of low notes and falls on
    // the left of high ones, flipping at the middle line. An eighth note gets a flag.
    \if {\>= {\msDur} {2}}
      \nofill \stroke{\musiccolor} \linewidth{1.1pt}
      \if {\< {\step} {4}}
        \set sx {\calc{msX + musicheadrx - 0.4}}
        \set stemEnd {\calc{ny + musicstem}}
        \line{\sx \ny  \sx \stemEnd}
        \if {\>= {\msDur} {8}} \musicFlagUp \fi
      \else
        \set sx {\calc{msX - musicheadrx + 0.4}}
        \set stemEnd {\calc{ny - musicstem}}
        \line{\sx \ny  \sx \stemEnd}
        \if {\>= {\msDur} {8}} \musicFlagDown \fi
      \fi
    \fi
  \fi}

// An up-stem flag: a filled hook off the top of the stem (sx, stemEnd).
\def musicFlagUp {
  \fill{\musiccolor} \nostroke
  \path{
    \moveto{\sx \stemEnd}
    \curveto{\calc{sx + 7} \calc{stemEnd - 3}  \calc{sx + 8} \calc{stemEnd - 11}  \calc{sx + 3} \calc{stemEnd - 16}}
    \curveto{\calc{sx + 8} \calc{stemEnd - 10}  \calc{sx + 7} \calc{stemEnd - 4}  \calc{sx} \calc{stemEnd - 4}}
    \close
  }}

// A down-stem flag: the mirror, off the bottom of the stem.
\def musicFlagDown {
  \fill{\musiccolor} \nostroke
  \path{
    \moveto{\sx \stemEnd}
    \curveto{\calc{sx + 7} \calc{stemEnd + 3}  \calc{sx + 8} \calc{stemEnd + 11}  \calc{sx + 3} \calc{stemEnd + 16}}
    \curveto{\calc{sx + 8} \calc{stemEnd + 10}  \calc{sx + 7} \calc{stemEnd + 4}  \calc{sx} \calc{stemEnd + 4}}
    \close
  }}

// Ledger lines for a note that sits outside the staff: short segments on the even steps
// between the staff edge and the note (step 0 is the bottom line, step 8 the top).
\def musicLedgers step {
  \nofill \stroke{\musiccolor} \linewidth{0.8pt}
  \if {\<= {\step} {-2}}
    \set nb {\calc{floor((0 - (\step)) / 2)}}
    \for\k{\range{1}{\nb}}{
      \set ly {\calc{msBottom - \k * musicgap}}
      \line{\calc{msX - musicheadrx - 3} \ly  \calc{msX + musicheadrx + 3} \ly}
    }
  \fi
  \if {\>= {\step} {10}}
    \set na {\calc{floor(((\step) - 8) / 2)}}
    \for\k{\range{1}{\na}}{
      \set ly {\calc{msTop + \k * musicgap}}
      \line{\calc{msX - musicheadrx - 3} \ly  \calc{msX + musicheadrx + 3} \ly}
    }
  \fi}

// A rest: a small filled block on the middle line. (A single mark for every duration,
// enough to hold a beat of silence in a simple line.)
\def musicRest {
  \fill{\musiccolor} \nostroke
  \set ry {\calc{msBottom + 2 * musicgap}}
  \rect{\calc{msX - 4} \calc{ry - 1.5} 8 3}}

// ---- Note parsing --------------------------------------------------------------
// Set msLetter (pitch class), msOct (octave offset from middle C's octave), msDur
// (1/2/4/8). The letter is the first character; the rest are octave marks and a digit.
\def musicParse tok {
  \set ps {\cat{\tok}{}}
  \global\set msLetter {\head{\ps}}
  \global\set msOct {0}
  \global\set msDur {4}
  \musicParseRest{\tail{\ps}}}

\def musicParseRest s {
  \if {\size{\s}}
    \set pc {\head{\s}}
    \if {\= {\pc} {'}} \global\set msOct {\calc{msOct + 1}}
    \else \if {\= {\pc} {,}} \global\set msOct {\calc{msOct - 1}}
    \else \global\set msDur {\calc{pc}} \fi \fi
    \musicParseRest{\tail{\s}}
  \fi}

// ---- The treble clef -----------------------------------------------------------
// A G (treble) clef. On a backend with image support the embedded bitmap is placed on the G line —
// engraving quality, since a drawn clef can only approximate the calligraphic glyph. Where images are
// unavailable (the imagessupported flag is 0, e.g. the JS layer) it falls back to a stroked path, so
// the package still works: one pen-like stroke curled around the second line from the bottom (the G line).
\def musicClef {
  \if {\= {\imagessupported} {1}}
    \at anchor:center {22 \calc{msBottom + musicgap + 8}}{\usebitmap height:{60} {musicTrebleClef}}
  \else
  \nofill \stroke{\musiccolor} \linewidth{2.4pt} \linecap{round} \linejoin{round}
  \group{
    \translate{20 \calc{msBottom + musicgap}}
    \set u {\calc{musicgap / 8}}
    \scale{\u \u}
    // one continuous pen stroke, the way a treble clef is written: up the stem from the
    // ball, a crook over the top, then the body swooping down through the upper loop into
    // the big lower belly and spiralling in to an eye centred on the G line (y = 0). The
    // body crosses the stem twice, as a real clef does.
    \path{
      \moveto{-1 -14}
      \curveto{1 -2     2 18    1 30}
      \curveto{-3 31    -7 29   -6 25}
      \curveto{-9 21    -9 16   -7 13}
      \curveto{-2 10    3 11    6 9}
      \curveto{8 3      4 -9    -2 -11}
      \curveto{-8 -12   -11 -8  -10 -2}
      \curveto{-9 5     -1 5    3 2}
      \curveto{5 3      2 -3    -1 -1}
    }
    // the filled ball at the foot of the stem, below the staff
    \fill{\musiccolor} \nostroke
    \circle{-1 -16 2.6}
  }
  \fi}
