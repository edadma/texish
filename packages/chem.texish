// chem — chemical-structure drawing, written entirely in the document language.
// Import this module with:
//
//     \use{chem}
//
// The macros below are the whole library: bonds between named coordinates,
// shortened at each end so atom labels stay clear, and \atom to name-and-label a
// point. Bond geometry is computed with \xof/\yof and \calc over the picture
// primitives — no engine code. Tunable through bondgap (clearance at each end) and
// doublesep (half the gap between the two lines of a double bond).
\set bondgap {9}
\set doublesep {2.5}

// \bond{A}{B} — a single bond between two coordinates, shortened by bondgap at each end.
\def bond a b {
  \set chemAx {\xof{\a}} \set chemAy {\yof{\a}}
  \set chemBx {\xof{\b}} \set chemBy {\yof{\b}}
  \set chemLen {\calc{hypot(chemBx - chemAx, chemBy - chemAy)}}
  \set chemUx {\calc{(chemBx - chemAx) / chemLen}}
  \set chemUy {\calc{(chemBy - chemAy) / chemLen}}
  \line{(chemAx + chemUx*bondgap, chemAy + chemUy*bondgap)
        (chemBx - chemUx*bondgap, chemBy - chemUy*bondgap)}
}

// \dbond{A}{B} — a double bond: two parallel lines, offset doublesep either side of the bond axis.
\def dbond a b {
  \set chemAx {\xof{\a}} \set chemAy {\yof{\a}}
  \set chemBx {\xof{\b}} \set chemBy {\yof{\b}}
  \set chemLen {\calc{hypot(chemBx - chemAx, chemBy - chemAy)}}
  \set chemUx {\calc{(chemBx - chemAx) / chemLen}}
  \set chemUy {\calc{(chemBy - chemAy) / chemLen}}
  \set chemOx {\calc{-chemUy * doublesep}}
  \set chemOy {\calc{chemUx * doublesep}}
  \line{(chemAx + chemUx*bondgap + chemOx, chemAy + chemUy*bondgap + chemOy)
        (chemBx - chemUx*bondgap + chemOx, chemBy - chemUy*bondgap + chemOy)}
  \line{(chemAx + chemUx*bondgap - chemOx, chemAy + chemUy*bondgap - chemOy)
        (chemBx - chemUx*bondgap - chemOx, chemBy - chemUy*bondgap - chemOy)}
}

// \tbond{A}{B} — a triple bond: a central line flanked by two parallel lines a little wider apart.
\def tbond a b {
  \set chemAx {\xof{\a}} \set chemAy {\yof{\a}}
  \set chemBx {\xof{\b}} \set chemBy {\yof{\b}}
  \set chemLen {\calc{hypot(chemBx - chemAx, chemBy - chemAy)}}
  \set chemUx {\calc{(chemBx - chemAx) / chemLen}}
  \set chemUy {\calc{(chemBy - chemAy) / chemLen}}
  \set chemOx {\calc{-chemUy * doublesep * 1.8}}
  \set chemOy {\calc{chemUx * doublesep * 1.8}}
  \line{(chemAx + chemUx*bondgap, chemAy + chemUy*bondgap)
        (chemBx - chemUx*bondgap, chemBy - chemUy*bondgap)}
  \line{(chemAx + chemUx*bondgap + chemOx, chemAy + chemUy*bondgap + chemOy)
        (chemBx - chemUx*bondgap + chemOx, chemBy - chemUy*bondgap + chemOy)}
  \line{(chemAx + chemUx*bondgap - chemOx, chemAy + chemUy*bondgap - chemOy)
        (chemBx - chemUx*bondgap - chemOx, chemBy - chemUy*bondgap - chemOy)}
}

// \atom{name}{coord}{label} — name a coordinate and set its element label, centred on the point.
\def atom n c l {
  \coordinate{\n}{\c}
  \at anchor:center {\c}{\l}
}

// ---- Reactions ----------------------------------------------------------------
// A reaction is a row of species joined by an operator and an arrow. Each species
// is an inline box: a formula (atom counts as subscripts with \dn, a leading number
// for the stoichiometric coefficient) or a drawn \picture structure. The operator
// $+$, the reaction arrow $\longrightarrow$ and the equilibrium arrow
// $\rightleftharpoons$ are all math symbols — written between dollars — so they are
// real glyphs from the math font: a true plus, a true minus sign (not a hyphen) for
// a charge, and arrows centred on the text's axis. Charges use $+$ / $-$ inside \up
// (Na\up{$+$}, SO\dn{4}\up{$2-$}). The pieces sit in the running text, so a whole
// equation is one line, typically inside \centerline to centre it.

// \dn{n} / \up{n} — an atom-count subscript and an ionic-charge superscript, sized
// from the current font by the engine's \textsub / \textsup: \dn turns H\dn2 O into
// H2O with the 2 dropped and shrunk, and \up gives Na\up+ or SO\dn4\up{2-}.
\def dn n {\textsub{\n}}
\def up n {\textsup{\n}}

// ---- \ce: a reaction equation from compact notation ---------------------------
// \ce{CH4 + 2 O2 -> CO2 + 2 H2O} typesets a reaction in math mode, the way mhchem's
// \ce does. Species are separated by spaces; a + joins them and -> / <=> / <- / <->
// are the reaction arrows. Inside a species a run of letters is an element symbol
// (set upright with \text), a digit run after letters is a subscript count, and a
// digit run at the start is a stoichiometric coefficient. There is no special-purpose
// engine primitive: \ce assembles math markup and the surrounding $...$ renders it in
// math mode, so + is a binary operator and the arrows are math glyphs. The parsing is
// done with the general string primitives \seq, \head, \tail, \size, \cat and \maphas.
//
// (Neutral species only for now: a ^ charge cannot survive a macro argument, so write
// ions with \up — e.g. Na\up{$+$} — outside \ce.)
\set cedigits {\map{0 1 1 1 2 1 3 1 4 1 5 1 6 1 7 1 8 1 9 1}}

// Split on whitespace, then recurse over the tokens. Recursion (not \for) matters: a
// macro expands inline, so every atom lands in one flat math list and gets the normal
// inter-atom spacing — \for opens a scope per iteration, which in math mode would wrap
// each token in its own sub-formula and lose the spacing around + and the arrows.
\def ce f {$\ceSeq{\seq{\f}}$}

\def ceSeq items {
  \if {\size{\items}}
    \ceTok{\head{\items}}
    \ceSeq{\tail{\items}}
  \fi}

// One whitespace-separated token: an operator/arrow, or otherwise a species formula.
\def ceTok t {
  \if {\= {\t} {+}} +
  \else \if {\= {\t} {->}} \longrightarrow
  \else \if {\= {\t} {<=>}} \rightleftharpoons
  \else \if {\= {\t} {<->}} \leftrightarrow
  \else \if {\= {\t} {<-}} \leftarrow
  \else \ceWalk{\cat{\t}{}}{1}
  \fi \fi \fi \fi \fi}

// Walk a species string: letters become upright \text, a digit run is a coefficient
// at the start of the species (start = 1) or a subscript otherwise.
\def ceWalk s start {
  \if {\size{\s}}
    \set cwc {\head{\s}}
    \if {\maphas cedigits {\cwc}}
      \global\set cedr {}
      \ceDigits{\s}
      \if {\= {\start} {1}} \cedr\, \else _{\cedr} \fi
      \ceWalk{\cerest}{0}
    \else
      \text{\cwc}
      \ceWalk{\tail{\s}}{0}
    \fi
  \fi}

// Consume the leading digit run of \s into the global cedr, leaving the remainder in
// the global cerest.
\def ceDigits s {
  \if {\size{\s}}
    \set cdc {\head{\s}}
    \if {\maphas cedigits {\cdc}}
      \global\set cedr {\cat{\cedr}{\cdc}}
      \ceDigits{\tail{\s}}
    \else
      \global\set cerest {\s}
    \fi
  \else
    \global\set cerest {}
  \fi}
