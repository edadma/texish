// document — a very basic document format, layered over the texish engine.
//
// Import it at the top of a document:
//
//     \use{document}
//
// It provides a title block, numbered sections, spacing and alignment helpers,
// emphasis, an abstract, quotation blocks, and bulleted / numbered lists. The
// look follows a 10-point LaTeX `article`: a serif body (Latin Modern Roman),
// roman title, bold headings on a tight type scale, and a centred page number at
// the foot of every page.

// ---- Body font and leading ----------------------------------------------------
// A 10pt body on a 12pt baseline, as in a default `article`. The heading and
// title sizes below follow the LaTeX magnification steps from this base:
// \large = 12, \Large = 14, \LARGE = 17.
\font lmroman 10 regular
\set baselineskip {12}
\set topskip {10}

// ---- Page and paragraph defaults ----------------------------------------------
// Paragraphs are marked by a first-line indent, with no extra gap between them
// and a ragged (un-stretched) page bottom.
\set parindent {15}
\set parskip {0}
\set raggedbottom {1}

// A plain page style: just the page number, centred at the foot of the page. A
// document can override \footline, or \def a \headline, to put a running head or
// footer in its place.
\def footline {\hss\font lmroman 10 regular \the\pageno\hss}

// ---- Vertical spacing ----------------------------------------------------------
\def smallskip {\vskip 3pt plus 1pt minus 1pt}
\def medskip {\vskip 6pt plus 2pt minus 2pt}
\def bigskip {\vskip 12pt plus 4pt minus 4pt}

// ---- Horizontal alignment of a single line ------------------------------------
\def centerline t {\hbox to:\hsize {\hss\t\hss}}
\def leftline t {\hbox to:\hsize {\t\hfil}}
\def rightline t {\hbox to:\hsize {\hfil\t}}

// \centering switches the rest of the current group to centred lines: the surrounding
// glue stretches equally on both sides and the last line is not filled to the right,
// so every line of a wrapped paragraph centres. Use it inside a group or a figure body
// so the setting reverts when the group closes.
\def centering {
  \set leftskip {0 plus 1fil}
  \set rightskip {0 plus 1fil}
  \set parfillskip {0}
}

// Zero-width overlap boxes (the plain-TeX definitions): \rlap draws its content to
// the right of the current point, \llap to the left, neither advancing the pen.
// A list marker placed with one of these hangs beside the text without pushing it.
\def rlap m {\hbox to:0 {\m\hss}}
\def llap m {\hbox to:0 {\hss\m}}

// ---- Drop caps -------------------------------------------------------------------
// \dropcap[lines][gap]{L}{orem} opens a paragraph with an oversized initial: the
// letter is enlarged until it spans the given number of lines — its top on the first
// line's cap height, its baseline on the baseline of the last spanned line — and the
// opening lines are carved around it. The optional arguments are positional: [lines] is
// how many lines the letter spans (default 2) and [gap] the space in points between the
// letter and the carved text (default 3), so \dropcap{L}{orem}, \dropcap[3]{L}{orem}
// and \dropcap[3][6]{L}{orem} are all valid. The last mandatory argument is the rest of
// the opening word, set through \dropcaptext — small capitals by default, redefinable
// like \foliostyle.
//
// The size is measured, not guessed: an X of the surrounding font gives the cap
// height, the letter is test-set once at a reference size, and the ratio of the target
// height — (lines − 1) baselines plus that cap height — to the measured height gives
// the final size. Any typeface, weight and leading therefore come out aligned; a
// descender (Q, J) hangs below the last spanned baseline, as a metal initial would.
// The letter is placed in a zero-width overlap box, smashed so the first line keeps
// its own height and lowered onto the last spanned baseline.
//
// The carve is a \cutout of the letter's height, not a \hangindent, so it reserves the
// space by vertical band rather than by line count: the opening text flows around the
// letter even when it crosses a paragraph break within the letter's lines — a short
// first paragraph followed by another still carves correctly, where a per-paragraph
// hanging indent would revert at the break and let the next paragraph ride onto the
// letter. Because the cutout is registered between paragraphs, \dropcap must open in
// vertical mode (its own \noindent starts the paragraph). Under a right-to-left base
// the carve and the letter move to the right edge, mirroring \item's marker.
\def dropcaptext t {\textsc{\t}}
\def dropcap [lines:2] [gap:3] letter text {
\setbox dropcapxbox \hbox{X}
\set dropcapcap {\ht dropcapxbox}
\set dropcapdrop {\calc{(\lines - 1) * baselineskip}}
\setbox dropcaprefbox \hbox{\fontsize{100}\letter}
\set dropcaprefht {\ht dropcaprefbox}
\setbox dropcapbox \hbox{\fontsize{\calc{100 * (dropcapdrop + dropcapcap) / dropcaprefht}}\letter}
\set dropcapwd {\wd dropcapbox}
\if {\> {\calc{pardir}} {0}}
\cutout {\calc{dropcapwd + \gap}} {\calc{dropcapdrop + dropcapcap}} {right}
\noindent\rlap{\kern \gap\smash{\lower \dropcapdrop \hbox{\box dropcapbox}}}\dropcaptext{\text}
\else
\cutout {\calc{dropcapwd + \gap}} {\calc{dropcapdrop + dropcapcap}} {left}
\noindent\llap{\smash{\lower \dropcapdrop \hbox{\box dropcapbox}}\kern \gap}\dropcaptext{\text}
\fi
}

// ---- Font-size declarations ----------------------------------------------------
// LaTeX's size-changing declarations, on a 10pt base. Each switches the type size for
// the rest of the current group — use one inside { … } or an environment — keeping the
// current family and shape and resetting the leading to TeX's 1.2× the new size. The
// scale is `article`'s 10pt option: \footnotesize 8, \small 9, \large 12, \Large 14.
\def tiny {\fontsize{5}}
\def scriptsize {\fontsize{7}}
\def footnotesize {\fontsize{8}}
\def small {\fontsize{9}}
\def normalsize {\fontsize{10}}
\def large {\fontsize{12}}
\def Large {\fontsize{14}}
\def LARGE {\fontsize{17}}
\def huge {\fontsize{20}}
\def Huge {\fontsize{25}}

// ---- Inline markup -------------------------------------------------------------
// \emph and \textit slant the body into italic; \textbf sets it bold; \textsl uses the
// slanted cut and \textsc small capitals. The family-role switches \textrm / \textsf /
// \texttt (roman / sans-serif / typewriter) are engine primitives — they keep the current
// weight and slope — and \textnormal resets to the plain face. \textsuperscript and
// \textsubscript raise or drop a smaller box; \dots / \ldots set an ellipsis.
// (\texttt, \textsf, \textrm, \underline, \smallcaps, \slanted are engine primitives.)
\def emph t {\italic{\t}}
\def textit t {\italic{\t}}
\def textbf t {\bold{\t}}
\def textsl t {\slanted{\t}}
\def textsc t {\smallcaps{\t}}
\def textnormal t {{\normalfont\t}}
\def textsuperscript t {\textsup{\t}}
\def textsubscript t {\textsub{\t}}
// ---- Text symbols --------------------------------------------------------------
// The common LaTeX text symbols (\dots \ldots \S \P \dag \ddag \copyright \textregistered \texttrademark \pounds
// \textbullet \textemdash \textendash \textdegree) are engine primitives, available to every document whether or
// not it loads this package; they are not redefined here.

// ---- TeX-family logos ----------------------------------------------------------
// The TeX-family wordmarks, set from the engine's box primitives. \LaTeX rides a
// small capital A in a \vbox whose height is a measured T, with \vss filling
// beneath, so its apex sits at the cap height (Lamport's own construction). \TeXish
// is this engine's mark — \TeX with a slanted "ish" raised against the X. The small
// letters and the kerns are all relative to the current size (\fontscale and em/ex
// units), so every logo scales cleanly from a footnote to a title.
\def TeX {T\kern-.1667em\lower.5ex\hbox{E}\kern-.125em X}
\def LaTeX {L\kern-.36em\setbox latexAbox \hbox{T}\vbox to:\ht latexAbox {\hbox{\fontscale{.7}{regular}A}\vss}\kern-.15em\TeX}
\def TeXish {\TeX\kern-.14em\raise.22em\hbox{\fontscale{.7}{slanted}ish}}

// ---- Title block ---------------------------------------------------------------
// \title / \author / \date record their argument (markup preserved) in a macro;
// \maketitle typesets whichever of them were given, centred. The title is roman,
// not bold, as in `article`.
\def doctitle {}
\def docauthor {}
\def docdate {}
\def title t {\def doctitle {\t}}
\def author a {\def docauthor {\a}}
\def date d {\def docdate {\d}}

\def maketitle {
  \bigskip
  \centerline{\font lmroman 17 regular \doctitle}
  \medskip
  \centerline{\font lmroman 12 regular \docauthor}
  \smallskip
  \centerline{\font lmroman 12 regular \docdate}
  \bigskip
}

// ---- Abstract ------------------------------------------------------------------
// A centred bold "Abstract" heading over a smaller, narrower block, as in
// `article`. The font and margins are set inside the environment's own group, so
// they revert at \end{abstract}.
\newenvironment abstract {
  \medskip
  \centerline{\font lmroman 10 bold Abstract}
  \smallskip
  \font lmroman 9 regular
  \set baselineskip {11}
  \set leftskip {28}
  \set rightskip {28}
  \noindent\par
} {}

// ---- Sections ------------------------------------------------------------------
// Two levels, auto-numbered. A subsection's number resets with each new section.
// The paragraph that follows a heading is set flush left (no first-line indent),
// as in LaTeX. A \nobreak after the heading keeps it with the text it introduces:
// it makes the glue below the heading a non-break, so a page break that would have
// orphaned the heading at the foot of a page falls before the heading instead.
\newcounter{section}
\newcounter{subsection}
\newcounter{subsubsection}
\counterwithin{subsection}{section}
\counterwithin{subsubsection}{subsection}

// The printed section numbers route through \thesection / \thesubsection /
// \thesubsubsection, so \appendix can switch the top level from 1, 2, 3 to A, B, C just
// by redefining \thesection — the lower levels follow because they build on it.
\def thesection {\arabic{\value{section}}}
\def thesubsection {\thesection.\arabic{\value{subsection}}}
\def thesubsubsection {\thesubsection.\arabic{\value{subsubsection}}}

// Value forms of the same numbers, for places that capture the number as a string rather than print it: a
// cross-reference (currentlabel) and a contents entry. The printed forms above join their parts with a literal
// dot, which reads as the dotted-access operator when the macro is evaluated in expression position, so the
// captured value would lose everything after the dot; these build the dotted number with \cat instead. The top
// level is just \thesection, so \appendix's switch to lettered numbers carries through here too.
\def thesectionnum {\thesection}
\def thesubsectionnum {\cat{\thesectionnum}{\cat{.}{\arabic{\value{subsection}}}}}
\def thesubsubsectionnum {\cat{\thesubsectionnum}{\cat{.}{\arabic{\value{subsubsection}}}}}

// Each heading takes a leading * for the unnumbered form (\section*{…}): the star form
// skips the counter and prints no number, exactly as in LaTeX.
// A numbered heading also records itself for cross-references and the table of contents: currentlabel holds the
// number a following \label captures (set \global because the \else branch is inside \if's group), and \tocentry
// notes the heading so \tableofcontents can list it with the page it lands on. The starred forms do neither, as
// in LaTeX.
//
// Every numbered heading shares that bookkeeping — the three currentlabel fields a following \label/\autoref/
// \nameref read, then a contents entry at the heading's level — so it lives here once. The book package's
// \chapter, a heading level the article format does not have, calls this too.
\def headingmeta lvl num kind t {
  \global\set currentlabel {\num}
  \global\set currentlabeltype {\kind}
  \global\set currentlabelname {\t}
  \tocentry{\lvl}{\num}{\t}
}

\def section * t {
  \clearwrap
  \vskip 14pt plus 3pt minus 1pt
  \if {\star}
    \leftline{\font lmroman 14 bold \t}
  \else
    \stepcounter{section}
    \headingmeta{1}{\thesectionnum}{Section}{\t}
    \leftline{\font lmroman 14 bold \thesection\hskip 10 \t}
  \fi
  \nobreak
  \vskip 8pt plus 2pt
  \noindent\par
}

\def subsection * t {
  \clearwrap
  \vskip 12pt plus 3pt minus 1pt
  \if {\star}
    \leftline{\font lmroman 12 bold \t}
  \else
    \stepcounter{subsection}
    \headingmeta{2}{\thesubsectionnum}{Subsection}{\t}
    \leftline{\font lmroman 12 bold \thesubsection\hskip 10 \t}
  \fi
  \nobreak
  \vskip 6pt plus 1pt
  \noindent\par
}

\def subsubsection * t {
  \clearwrap
  \vskip 10pt plus 2pt minus 1pt
  \if {\star}
    \leftline{\font lmroman 11 bold \t}
  \else
    \stepcounter{subsubsection}
    \headingmeta{3}{\thesubsubsectionnum}{Subsubsection}{\t}
    \leftline{\font lmroman 11 bold \thesubsubsection\hskip 10 \t}
  \fi
  \nobreak
  \vskip 5pt plus 1pt
  \noindent\par
}

// The table of contents is driven by the engine's \tableofcontents, which calls this once per entry it collected,
// passing the heading's level, number, title and the page it starts on. Each line indents by depth, sets the
// number and title, then a dotted leader carries the eye to the page number at the right margin. \tocheading
// prints the contents title above the list.
\def tocindent lvl {\calc{(\lvl - 1) * 18}}

// The leader between an entry and its folio uses \leaders (grid-aligned), not \dotfill (centred), so the dots fall
// on a fixed column and line up from row to row, as a LaTeX contents does. The unit is a period centred in a
// half-em cell; the fil glue spans whatever gap the line leaves.
\def tocleader {\leaders\hbox to:0.5em {\hss.\hss}{0pt plus 1fil}}

\def tocformat lvl num ttl pg {
  \set tocskip {\tocindent{\lvl}}
  \hbox to:\hsize {\hskip \tocskip \num\hskip 8 \ttl\tocleader\hskip 6 \pg}
}

\def tableofcontentstitle {Contents}

\def contents {
  \section*{\tableofcontentstitle}
  \tableofcontents
}

// The list of figures and list of tables run the same way over their own engine-collected lists: \listoffigures /
// \listoftables replay each caption's entry through \lofformat / \lotformat. These have no depth to indent — every
// entry is a single float — so they print the number, the caption title, a dotted leader and the page. \listoffigs
// / \listoftabs add the heading above the list, mirroring \contents.
\def lofformat lvl num ttl pg {
  \hbox to:\hsize {\num\hskip 8 \ttl\tocleader\hskip 6 \pg}
}

\def lotformat lvl num ttl pg {
  \hbox to:\hsize {\num\hskip 8 \ttl\tocleader\hskip 6 \pg}
}

\def listoffigurestitle {List of Figures}
\def listoftablestitle {List of Tables}

\def listoffigs {
  \section*{\listoffigurestitle}
  \listoffigures
}

\def listoftabs {
  \section*{\listoftablestitle}
  \listoftables
}

// \paragraph is the lowest level: a bold run-in heading on the same line as the text it
// introduces, with no number and no break after it.
\def paragraph t {
  \medskip
  \noindent {\font lmroman 10 bold \t}\hskip 6 \ignorespaces
}

// \appendix restarts the section counter and switches its number to a letter, so the
// sections after it read Appendix A, B, … while keeping the same \section command.
\def appendix {
  \setcounter{section}{0}
  \def thesection {\Alph{\value{section}}}
}

// ---- Quotation block -----------------------------------------------------------
// Indents the block on both sides. leftskip / rightskip are set inside the
// environment's own group, so they revert automatically at \end{quote}.
\newenvironment quote {
  \set leftskip {25}
  \set rightskip {25}
} {}

// \quotation is the same, with a wider indent.
\newenvironment quotation {
  \set leftskip {40}
  \set rightskip {40}
} {}

// ---- Alignment environments ----------------------------------------------------
// Block forms of the alignment declarations: every paragraph inside is centred, set
// ragged-right (flushleft) or ragged-left (flushright). The infinite glue on the
// stretching side(s) plus a zero parfillskip makes even the last line align, and
// parindent is dropped so the block has no first-line indent. The settings revert at
// \end because the environment is its own group.
\newenvironment center {
  \set leftskip {0 plus 1fil}
  \set rightskip {0 plus 1fil}
  \set parfillskip {0}
  \set parindent {0}
} {}

\newenvironment flushleft {
  \set rightskip {0 plus 1fil}
  \set parfillskip {0}
  \set parindent {0}
} {}

\newenvironment flushright {
  \set leftskip {0 plus 1fil}
  \set parfillskip {0}
  \set parindent {0}
} {}

// ---- Lists ---------------------------------------------------------------------
// Lists nest: listdepth is a scoped variable, so each environment sees one more
// than its parent and the value restores when the environment closes. Each level
// indents the whole block by listindent (so even a first-level list sits in from
// the margin, as in LaTeX); the marker hangs to the left of the text.
\set listdepth {0}
\set listindent {22}
\set labelsep {5}

\newenvironment itemize {
  \set listdepth {\calc{listdepth + 1}}
  \set leftskip {\calc{listdepth * listindent}}
  \def itemmark {•}
} {}

\newenvironment enumerate {
  \set listdepth {\calc{listdepth + 1}}
  \set leftskip {\calc{listdepth * listindent}}
  \setcounter{enumi}{0}
  \def itemmark {\stepcounter{enumi}\arabic{\value{enumi}}.}
} {}
\newcounter{enumi}

// A description list: terms with hanging definitions. The marker for each item is the
// bracketed label given to \item ( \item[Term] ), set bold, rather than a bullet or
// number — so itemmark is empty here and the label supplies the marker.
\newenvironment description {
  \set listdepth {\calc{listdepth + 1}}
  \set leftskip {\calc{listdepth * listindent}}
  \def itemmark {}
} {}

// \item starts one list item, at the list's leading margin (leftskip, mapped to the reading side by
// the base direction). A bullet or number is a narrow marker, so it is set in a zero-width overlap
// box that hangs into the indent on the leading edge, a labelsep gap before the text, exactly as a
// LaTeX list label does: \llap hangs it to the left under a left-to-right base, \rlap to the right
// under a right-to-left one. A description term — the optional bold [label] — can be much wider than
// the indent, so it is set inline at the margin instead (advancing the pen), the definition
// following after the gap. The closing \ignorespaces drops the space before the item's text. The opening
// \par ends the previous item's paragraph so each item starts a fresh line — an explicit break, since a
// module body's source newlines are not paragraph breaks.
\def item [label:] {
  \par\noindent\if {\label} {\font lmroman 10 bold \label}\hskip\labelsep\else\if {\> {\calc{pardir}} {0}}\rlap{\hskip\labelsep\itemmark}\else\llap{\itemmark\hskip\labelsep}\fi\fi\ignorespaces}

// ---- Floats (figures and tables) ----------------------------------------------
// \figure / \table detach their body to a page edge (default top) over the engine's
// \topinsert primitive; a \caption written inside numbers it as a figure or table
// — each on its own counter — e.g. "Figure 1: …". An optional [htb] placement is
// forwarded to \topinsert.
\newcounter{figure}
\newcounter{table}
\def figure [placement:t] body {{
\set captionkind {Figure}
\set captioncounter {figure}
\set captionlist {lof}
\topinsert[\placement]{\body}
}}
\def table [placement:t] body {{
\set captionkind {Table}
\set captioncounter {table}
\set captionlist {lot}
\topinsert[\placement]{\body}
}}
// \caption steps the float's counter, then records the state a following \label captures — currentlabel holds the
// number (\global, so it outlives the caption's group), currentlabeltype the kind word \autoref prefixes, and
// currentlabelname the caption text \nameref prints — and files an entry into the float's contents list (lof / lot)
// before printing the visible "Figure 1: …" caption.
\def caption text {{
\stepcounter \captioncounter
\global\set currentlabel {\arabic{\value \captioncounter}}
\global\set currentlabeltype {\captionkind}
\global\set currentlabelname {\text}
\addcontentsline{\captionlist}{1}{\arabic{\value \captioncounter}}{\text}
\the\captionkind \arabic{\value \captioncounter}: \text
}}

// ---- Boxes and conditionals ----------------------------------------------------
// \begin{minipage}[pos]{width} … \end{minipage} sets its body as a paragraph in a box of the given width, the
// environment form of \parbox, over the engine's \beginminipage / \endminipage pair. [pos] (t / c / b) aligns the
// box on the surrounding baseline, defaulting to centred as in LaTeX.
\newenvironment minipage [pos:c] w {\beginminipage[\pos]{\w}} {\endminipage}

// \ifthenelse{test}{then}{else} chooses one of two branches on a boolean test, over the engine's \if. The test is
// an ordinary expression — a comparison such as \> {\x} {3}, or \equal for strings; compound tests use the
// expression operators. \equal{a}{b} is true when the two expand to the same string, the common ifthen test.
\def equal a b {\={\a}{\b}}
\def ifthenelse c a b {\if {\c} \a \else \b \fi}
