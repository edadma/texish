// book — a LaTeX `book`-class document format, layered over the `document` package.
//
//     \use{book}
//     \title{...} \author{...} \date{...}
//
//     \frontmatter            // lowercase-roman folios, unnumbered chapters
//     \halftitle              // optional: the title alone, on its own leaf
//     \maketitle
//     \copyrightpage{...}     // optional: the title page's verso
//     \contents
//     \chapter{Preface} ...
//
//     \mainmatter             // arabic folios restarting at 1, numbered chapters
//     \chapter{Introduction}
//     \section{...} \subsection{...} ...
//
//     \backmatter             // unnumbered chapters, folios continue
//     \chapter{Bibliography} ...
//
// It adds a chapter level above the article sectioning, numbers sections within
// chapters (1.1, 1.2, ...) and figures and tables within chapters (Figure 1.1),
// starts every chapter and part on a fresh recto, puts a running chapter head at the
// top of each page, and switches folio style and chapter numbering between the three
// matter divisions, exactly as the LaTeX book class does. Whatever the document
// package already provides — emphasis, lists, quotations, floats, spacing helpers —
// is inherited unchanged.
//
// A book is two-sided unless it says otherwise, as LaTeX's book class is: the text
// block mirrors on verso pages, the folio sits in the outer corner, and every part
// and chapter opens on a recto. A book meant to be read on a screen or printed on
// one side of the sheet says so with \geometry twoside:off.

\use{document}

// ---- Two-sided by default ------------------------------------------------------
// The package turns two-sided printing on with \geometry twoside:on, which sets the
// `twoside` register and nothing else. A \geometry that names neither `twoside` nor
// an `inner`/`outer` margin leaves that register as it found it, so a document's own
// \geometry paper:a5 margin:… after \use{book} changes the page and keeps the book
// two-sided; only one that says twoside:off makes it one-sided.
\geometry twoside:on

// ---- Chapter and part counters -------------------------------------------------
// A chapter numbers the sections, figures and tables beneath it, so stepping it
// resets all three (the document package already nests subsection within section).
// Parts carry their own counter, shown as an uppercase roman numeral.
\newcounter{part}
\newcounter{chapter}
\counterwithin{section}{chapter}
\counterwithin{figure}{chapter}
\counterwithin{table}{chapter}

// ---- Opening a division --------------------------------------------------------
// Chapters and parts start a fresh page. In a two-sided book they start a fresh
// *recto*: the reader turns the leaf and the division begins on the right-hand page,
// which is what \cleardoublepage gives — an extra blank leaf inserted when the page
// would otherwise fall on a verso. One-sided there is no such thing as a wrong side,
// so a plain \eject is right and no blank is ever wasted. \cleardoublepage inserts
// at most one blank leaf, so however divisions follow one another no two blank pages
// ever fall in a row.
\def openpage {\iftwoside{\cleardoublepage}{\eject}}

// ---- Matter divisions ----------------------------------------------------------
// chapnumbered says whether \chapter prints a number: only the main matter does.
// foliostyle is the macro that renders the page number in the footer; front matter
// sets it to roman, the main matter to arabic. The default before any division is
// main-matter style, so a book that skips \frontmatter still numbers sensibly.
\set chapnumbered {1}
\def foliostyle n {\arabic{\n}}

// The folio sits centred at the foot of a one-sided book. Two-sided it moves to the
// outer corner — the edge the reader's thumb turns — which is the left of a verso and
// the right of a recto, so the two folios of an opening sit at its outer edges.
\def folio {\foliostyle{\calc{pageno}}}

\def footline {\font lmroman 10 regular \iftwoside{\ifrecto{\hss\folio}{\folio\hss}}{\hss\folio\hss}}

// Each division begins on a fresh page — a fresh recto in a two-sided book, so a
// division that restarts the folio at 1 puts that odd folio on a right-hand page and
// the mirrored margins stay with the sheet. \frontmatter restarts the folio at i and
// leaves chapters unnumbered; \mainmatter restarts arabic folios at 1 and turns
// chapter numbers on; \backmatter keeps the running folio but unnumbers chapters
// again (appendix-style matter is set apart by its headings, not its numbers).
\def frontmatter {
  \openpage
  \set pageno {1}
  \set chapnumbered {0}
  \def foliostyle n {\roman{\n}}
}
\def mainmatter {
  \openpage
  \set pageno {1}
  \set chapnumbered {1}
  \def foliostyle n {\arabic{\n}}
}
\def backmatter {
  \openpage
  \set chapnumbered {0}
}

// ---- Opening pages -------------------------------------------------------------
// A published book opens with up to three pages before its contents, in this order:
//
//     \halftitle              // recto: the title alone; its verso blank
//     \maketitle              // recto: title, author, date
//     \copyrightpage{...}     // the title's verso: copyright, licence, ISBN, edition
//
// None of them carries a running head or a folio, though each counts as a page: the
// head and foot are emptied inside a group that the page ships within, as
// \cleardoublepage does for its blank leaf. (The document package's \title / \author /
// \date and the doctitle / docauthor / docdate macros they fill are reused as-is.)
//
// The half-title is the title alone, smaller than on the title page and set a third
// of the way down, with no author or date. Its verso is left blank, so the title page
// after it still falls on a recto.
\def halftitle {
  \openpage
  {
    \def headline {}
    \def footline {}
    \vfil
    \centerline{\font lmroman 17 regular \doctitle}
    \vfil
    \vfil
    \eject
  }
  \openpage
}

// The title page: the title, author and date set large and centred over vertical
// fill, on a recto of its own.
//
// Its verso belongs to whatever comes next. A \copyrightpage there fills it; anything
// else — the contents, a chapter, \mainmatter — opens on a recto of its own, and the
// single blank leaf that inserts is the title's verso. \maketitle therefore ships no
// blank of its own, which would only have to be taken back when a copyright page
// follows and would be a stray empty page in a one-sided book. No arrangement of these pages puts two blank pages in a
// row, which matters to print-on-demand services that reject a run of blanks mid-book.
\def maketitle {
  \openpage
  \maketitlepage
}
\def maketitlepage {{
  \def headline {}
  \def footline {}
  \vfil
  \centerline{\font lmroman 24 bold \doctitle}
  \vskip 36pt
  \centerline{\font lmroman 14 regular \docauthor}
  \vskip 14pt
  \centerline{\font lmroman 12 regular \docdate}
  \vfil
  \eject
}}

// The copyright page is the verso of the title, so it is written straight after
// \maketitle. It takes the page's text — the copyright line, the licence, the ISBN,
// the edition and printing — as paragraphs, and sets them small, flush left and
// ragged right, pushed down to the foot of the page, which is where a reader expects
// the fine print and where it stays out of the way of the title facing it. The
// paragraph shape is set inside the group and the last paragraph ended there too,
// since a paragraph is broken with whatever settings stand when it ends.
\def copyrightpage t {
  \eject
  {
    \def headline {}
    \def footline {}
    \vfill
    \font lmroman 8 regular
    \set baselineskip {10}
    \set parindent {0}
    \set parskip {5}
    \set rightskip {0 plus 1fil}
    \noindent\ignorespaces\t\par
    \eject
  }
}

// ---- Parts ---------------------------------------------------------------------
// A part is a page of its own: "Part <roman>" over the part title, both centred and
// vertically centred between fills. It steps the part counter but resets nothing
// below it — parts group chapters without renumbering them.
\def part t {
  \openpage
  \stepcounter{part}
  \mark{}
  \submark{}
  \vfil
  \centerline{\font lmroman 18 bold Part \Roman{\value{part}}}
  \vskip 24pt
  \centerline{\font lmroman 28 bold \t}
  \vfil
  \eject
  \noindent\par
}

// ---- Chapters ------------------------------------------------------------------
// Every chapter opens a new page. In the main matter it shows "Chapter <n>" above a
// large title and steps the chapter counter (which resets the section, figure and
// table counters under it); in front and back matter the number line is dropped and
// the counter left alone. Either way the title is recorded as a page mark, so the
// running head names whichever chapter a page belongs to.
\def thechapter {\arabic{\value{chapter}}}

// The word a numbered chapter is announced by, and the form of its number. Both are
// macros because \appendix swaps them: the chapters after it read "Appendix A", "Appendix
// B", counting from zero again, while every \chapter, \section and \label around them is
// written exactly as before. Everything built on the chapter number — the section numbers,
// the float captions, the contents entries — reads \thechapter rather than the counter, so
// the switch carries through all of them from this one place.
\def chaptername {Chapter}

\def appendix {
  \openpage
  \setcounter{chapter}{0}
  \def chaptername {Appendix}
  \def thechapter {\Alph{\value{chapter}}}
}

\def chapter * t {
  \openpage
  \vskip 36pt
  \if {\= {\calc{chapnumbered}} {1}}
    \if {\star}
    \else
      \stepcounter{chapter}
      \leftline{\font lmroman 14 bold \chaptername \thechapter}
      \vskip 8pt
      \headingmeta{0}{\thechapter}{\chaptername}{\t}
    \fi
  \fi
  \leftline{\font lmroman 24 bold \t}
  \mark{\t}
  \submark{}
  \vskip 20pt plus 4pt minus 2pt
  \noindent\par
}

// ---- Running head --------------------------------------------------------------
// One-sided, the head names the current chapter, set in italics and centred at the top
// of every page. firstmark is the first mark reaching a page (or the previous page's
// last mark on a page that sets none), so it names whichever chapter the page belongs
// to whether or not the chapter opened there.
//
// Two-sided, the head is read across the opening rather than page by page, as a printed
// book's is: the verso names the chapter and the recto the section within it, from the
// two mark streams (\chapter marks the first, \section the second). A chapter clears
// the second stream as it opens, so the recto of an opening before the first section
// carries no head rather than the last section of the chapter before.
\def headline {\font lmroman 9 italic \iftwoside{\ifrecto{\hfil\the\firstsubmark\hfil}{\hfil\the\firstmark\hfil}}{\hfil\the\firstmark\hfil}}

// ---- Sectioning within a chapter -----------------------------------------------
// A book numbers sections within the chapter, so a section reads 1.1 and a subsection
// 1.1.1. The document package builds every printed number, cross-reference and contents
// entry on \thesection, so redefining that one macro is the whole change: \section,
// \subsection, their starred forms and their \label / \autoref support are all
// inherited from the document package unchanged. (\counterwithin above already resets
// the section counter at the start of each chapter.)
//
// As in the document package there are two forms of the number, and book prefixes the
// chapter onto each root; the sub-levels build on these and inherit the prefix. The
// printed \thesection joins its parts with a literal dot, because it is typeset into the
// heading. The value \thesectionnum joins them with \cat, because the document package
// feeds it to \tocentry and \label as a value, where a bare `.` is the member-access
// operator rather than a printed dot.
\def thesection {\thechapter.\arabic{\value{section}}}
\def thesectionnum {\cat{\thechapter}{\cat{.}{\arabic{\value{section}}}}}

// ---- Float captions ------------------------------------------------------------
// Figures and tables number within the chapter, so a caption shows the chapter as a
// prefix — "Figure 1.2: ...". The captionkind / captioncounter scratch variables are
// set by the document package's \figure / \table wrappers; this only widens the
// number printed by \caption to match the per-chapter counters declared above.
\def caption text {{
\stepcounter \captioncounter
\global\set currentlabel {\cat{\thechapter}{\cat{.}{\arabic{\value \captioncounter}}}}
\global\set currentlabeltype {\captionkind}
\global\set currentlabelname {\text}
\addcontentsline{\captionlist}{1}{\cat{\thechapter}{\cat{.}{\arabic{\value \captioncounter}}}}{\text}
\the\captionkind \thechapter.\arabic{\value \captioncounter}: \text
}}

// ---- Contents, lists, bibliography and index headings --------------------------
// The document package opens its contents, its lists of figures and tables, its
// reference list and its index with a \section*, the top level an article has. In a
// book each is a division in its own right — opening on a recto like a chapter, with
// its name in the running head — so each is a \chapter* here instead. The lists
// themselves are inherited from the document package unchanged; only the heading
// above them differs.
\def contents {
  \chapter*{\tableofcontentstitle}
  \tableofcontents
}
\def listoffigs {
  \chapter*{\listoffigurestitle}
  \listoffigures
}
\def listoftabs {
  \chapter*{\listoftablestitle}
  \listoftables
}
\def bibname {Bibliography}
\def bibheading {\chapter*{\bibname}}
\def indexheading {\chapter*{\indextitle}}
