// railroad — railroad (syntax) diagrams drawn from a grammar, written entirely in the
// document language over the \picture vector-graphics layer. Import it with:
//
//     \use{railroad}
//
// A diagram is produced from a grammar in W3C-style EBNF (the notation of the XML and
// XPath specifications), one picture per rule:
//
//     \railroad{
//       ifStatement ::= "if" "(" condition ")" statement ("else" statement)?
//       condition   ::= expression
//     }
//
// The grammar is read verbatim — the `<g>` raw parameter hands \railroad the literal
// text, so the EBNF specials (::= | ? * + ( ) " ' [ ]) survive untouched — then it is
// tokenized with \words and a small char-level lexer, parsed by recursive descent into a
// tree held in maps, measured bottom-up, and drawn top-down into a \picture. There is no
// railroad-specific engine primitive: the layout and the rails are all document language.
//
// Supported W3C EBNF:
//   name ::= expr      a rule (a diagram); rules are separated by whitespace/newlines
//   a | b              alternation         (a fork, the branches stacked)
//   a b                concatenation       (a and b in a row)
//   ( ... )            grouping
//   x?                 optional            (a skip on the main line, x on a track below)
//   x*                 zero or more        (x with a bypass and a return loop)
//   x+                 one or more         (x with a return loop)
//   "literal" 'lit'    a terminal          (a rounded "stadium" box)
//   [a-z] [^x] ...     a character class   (a pointed hexagon, its brackets kept)
//   name               a nonterminal       (a reference to another rule; a square box)
//
// A terminal may contain spaces ("end of file") — the lexer rejoins words across an open
// quote. The difference operator (-) is treated as concatenation: A - B draws A then B.

// ---- Configuration (override with \set after \use, before \railroad) ------------
// All sizes are in points (72 per inch).
\set rrface {jetbrains}     // typeface for the labels and titles (JetBrains Mono, a code face)
\set rrfont {9}             // type size of the labels inside the boxes
\set rrtitlefont {10}       // type size of the rule-name title above each diagram
\set rrboxh {20}            // height of a box (the rail runs through its middle)
\set rrpadx {11}            // horizontal padding (>= rrboxh/2 so a terminal's caps fit inside it)
\set rrhgap {15}            // length of a connecting rail between items in a row
\set rrvgap {11}            // vertical gap between stacked alternatives of a choice
\set rrfork {18}            // lead-in / lead-out rail on each side of a choice fork
\set rrloop {11}            // vertical clearance of an optional / repetition bypass or loop
\set rrloopx {12}           // how far a repeat loop's sides bow out past the box (<= rrfork)
\set rrcr {6}               // radius of the rounded rail corners (the "railroad" curves)
\set rrah {7}               // length of the entry / exit arrowheads
\set rrahw {3.5}            // half-width of the arrowheads
\set rrmargin {7}           // blank margin around the whole diagram
\set rrlinecolor {black}    // ink for the rails and the box outlines
\set rrbase {#dde8fb}       // base fill colour; terminals and classes are darker shades of it
\set rrtermdark {0.08}      // how far to lower the Oklch lightness for a terminal box
\set rrccdark {0.17}        // how far to lower the Oklch lightness for a character-class box
\set rrccpt {6}             // depth of a character class's pointed ends

// ================================================================================
// Lexer — turn the raw grammar text into a token stream stored in maps:
//   rrTok i -> the token's text       rrTy i -> its type (op | id | tm)   rrN -> count
// op = ::= ( ) | ? * + ; id = a nonterminal name; tm = a terminal (quotes stripped, a
// character class keeps its brackets). Whitespace separates tokens; \words splits the
// characters of the verbatim argument (handling spaces, tabs and newlines uniformly),
// then each word is char-lexed so glued operators (name*, (a|b)+) come apart.

\def rrEmit s ty {
  \global\mapset rrTok {\rrN}{\s}
  \global\mapset rrTy {\rrN}{\ty}
  \global\set rrN {\calc{rrN + 1}}}

// Assemble words into balanced chunks, rejoining across an open quote so a terminal may
// contain spaces, then char-lex each chunk. rrOpen / rrQc track an unterminated quote.
\def rrLex g {
  \global\set rrN {0}
  \global\set rrAcc {}
  \global\set rrOpen {0}
  \global\set rrQc {}
  \for\w{\words{\g}}{\rrFeed{\w}}
  \if {\> {\size{\rrAcc}}{0}}\rrLexChunk{\rrAcc}\fi}

\def rrFeed w {
  \if {\= {\rrOpen}{1}}
    \global\set rrAcc {\cat{\rrAcc}{\cat{ }{\w}}}
  \else
    \global\set rrAcc {\w}
  \fi
  \rrScanQuote{\rrAcc}
  \if {\= {\rrOpen}{0}}\rrLexChunk{\rrAcc}\global\set rrAcc {}\fi}

// Scan a chunk for quote toggles, leaving rrOpen=1 (and rrQc=the quote char) if a quote
// is still open at its end. Only " and ' open a terminal; brackets never span spaces.
\def rrScanQuote s {
  \global\set rrOpen {0}\global\set rrQc {}
  \rrScanQ{\s}}
\def rrScanQ s {
  \if {\size{\s}}
    \set c {\head{\s}}
    \if {\= {\rrOpen}{1}}
      \if {\= {\c}{\rrQc}}\global\set rrOpen {0}\fi
    \else
      \if {\= {\c}{"}}\global\set rrOpen {1}\global\set rrQc {"}
      \else\if {\= {\c}{'}}\global\set rrOpen {1}\global\set rrQc {'}\fi\fi
    \fi
    \rrScanQ{\tail{\s}}
  \fi}

// Char-lex one balanced chunk into tokens. The single-character operators ( ) | ? * +
// are tested inline: a predicate macro that returned 1/0 through nested \if would read as
// true in an \if condition even on a miss, so every comparison is made directly here.
\def rrLexChunk s {
  \if {\size{\s}}
    \set c {\head{\s}}
    \if {\= {\c}{"}}\rrReadQuoted{\tail{\s}}{"}
    \else\if {\= {\c}{'}}\rrReadQuoted{\tail{\s}}{'}
    \else\if {\= {\c}{[}}\rrReadBracket{\tail{\s}}
    \else\if {\= {\c}{:}}\rrEmit{::=}{op}\rrLexChunk{\tail{\tail{\tail{\s}}}}
    \else\if {\= {\c}{-}}\rrLexChunk{\tail{\s}}
    \else\if {\= {\c}{(}}\rrEmit{(}{op}\rrLexChunk{\tail{\s}}
    \else\if {\= {\c}{)}}\rrEmit{)}{op}\rrLexChunk{\tail{\s}}
    \else\if {\= {\c}{|}}\rrEmit{|}{op}\rrLexChunk{\tail{\s}}
    \else\if {\= {\c}{?}}\rrEmit{?}{op}\rrLexChunk{\tail{\s}}
    \else\if {\= {\c}{*}}\rrEmit{*}{op}\rrLexChunk{\tail{\s}}
    \else\if {\= {\c}{+}}\rrEmit{+}{op}\rrLexChunk{\tail{\s}}
    \else\rrReadIdent{\s}
    \fi\fi\fi\fi\fi\fi\fi\fi\fi\fi\fi
  \fi}

// Set rrStop to 1 if c ends an identifier run — an operator, a quote, or a bracket.
\def rrClassify c {
  \global\set rrStop {0}
  \if {\= {\c}{(}}\global\set rrStop {1}\fi
  \if {\= {\c}{)}}\global\set rrStop {1}\fi
  \if {\= {\c}{|}}\global\set rrStop {1}\fi
  \if {\= {\c}{?}}\global\set rrStop {1}\fi
  \if {\= {\c}{*}}\global\set rrStop {1}\fi
  \if {\= {\c}{+}}\global\set rrStop {1}\fi
  \if {\= {\c}{[}}\global\set rrStop {1}\fi
  \if {\= {\c}{]}}\global\set rrStop {1}\fi
  \if {\= {\c}{:}}\global\set rrStop {1}\fi
  \if {\= {\c}{"}}\global\set rrStop {1}\fi
  \if {\= {\c}{'}}\global\set rrStop {1}\fi}

// Accumulate \s into rrLacc until the character \d, leaving the remainder in rrLrem.
\def rrScanTo s d {
  \if {\size{\s}}
    \set c {\head{\s}}
    \if {\= {\c}{\d}}\global\set rrLrem {\tail{\s}}
    \else\global\set rrLacc {\cat{\rrLacc}{\c}}\rrScanTo{\tail{\s}}{\d}\fi
  \else\global\set rrLrem {}\fi}

// A quoted terminal: read to the closing quote, emit the inside as a terminal, lex on.
\def rrReadQuoted rest q {
  \global\set rrLacc {}
  \rrScanTo{\rest}{\q}
  \rrEmit{\rrLacc}{tm}
  \rrLexChunk{\rrLrem}}

// A character class: read to ], emit (brackets kept) as a character class, lex on.
\def rrReadBracket rest {
  \global\set rrLacc {}
  \rrScanTo{\rest}{]}
  \rrEmit{\cat{[}{\cat{\rrLacc}{]}}}{cc}
  \rrLexChunk{\rrLrem}}

// An identifier (a nonterminal): read up to a stop character, emit, lex on.
\def rrReadIdent s {
  \global\set rrLacc {}
  \rrIdentScan{\s}
  \rrEmit{\rrLacc}{id}
  \rrLexChunk{\rrLrem}}
\def rrIdentScan s {
  \if {\size{\s}}
    \set c {\head{\s}}
    \rrClassify{\c}
    \if {\= {\rrStop}{1}}\global\set rrLrem {\s}
    \else\global\set rrLacc {\cat{\rrLacc}{\c}}\rrIdentScan{\tail{\s}}\fi
  \else\global\set rrLrem {}\fi}

// ================================================================================
// Parser — recursive descent over the token stream (cursor rrP), building a tree in
// maps keyed by a node id (counter rrId). Each parse routine leaves the id of the node
// it built in rrRet. Node kinds: T terminal, N nonterminal, S sequence, C choice,
// R star (*), P plus (+), E empty branch (a choice's skip), L separated list. An optional
// (?) is not its own kind: it is built as a choice with an empty skip branch. A child of a
// seq/choice is stored under the numeric key id*1000+index; a wrapper's single child under rrSub.
//   rrKind id -> kind   rrLabel id -> text (T/N)   rrCount id -> #children (S/C)
//   rrChild id*1000+i -> child id   rrSub id -> child id (Q/R/P)

// Load the current token into rrTk (text) and rrTt (type); empty past the end.
\def rrPeek {
  \if {\< {\rrP}{\rrN}}
    \global\set rrTk {\mapget rrTok {\rrP}}
    \global\set rrTt {\mapget rrTy {\rrP}}
  \else\global\set rrTk {}\global\set rrTt {}\fi}
\def rrNext {\global\set rrP {\calc{rrP + 1}}}

// rrRS = 1 when the cursor sits on a rule start (an id immediately followed by ::=).
\def rrRuleStart {
  \global\set rrRS {0}
  \if {\= {\rrTt}{id}}
    \if {\< {\calc{rrP + 1}}{\rrN}}
      \if {\= {\mapget rrTok {\calc{rrP + 1}}}{::=}}\global\set rrRS {1}\fi
    \fi
  \fi}

// rrFS = 1 when a factor can start here: not at end, |, ) or the next rule.
\def rrFactorStart {
  \rrPeek\rrRuleStart
  \if {\< {\size{\rrTk}}{1}}\global\set rrFS {0}
  \else\if {\= {\rrTk}{|}}\global\set rrFS {0}
  \else\if {\= {\rrTk}{)}}\global\set rrFS {0}
  \else\if {\= {\rrRS}{1}}\global\set rrFS {0}
  \else\global\set rrFS {1}\fi\fi\fi\fi}

// expr ::= term ( '|' term )* — a single term passes through; two or more make a choice.
\def rrExpr {{
  \rrTerm
  \set first {\rrRet}
  \rrPeek
  \if {\= {\rrTk}{|}}
    \global\set rrId {\calc{rrId + 1}}\set cid {\rrId}
    \global\mapset rrKind {\cid}{C}
    \global\mapset rrChild {\calc{\cid * 1000}}{\first}
    \rrChoiceLoop{\cid}{1}
  \else
    \global\set rrRet {\first}
  \fi
}}
\def rrChoiceLoop cid k {{
  \rrPeek
  \if {\= {\rrTk}{|}}
    \rrNext\rrTerm
    \global\mapset rrChild {\calc{\cid * 1000 + \k}}{\rrRet}
    \set nk {\calc{\k + 1}}
    \rrChoiceLoop{\cid}{\nk}
  \else
    \global\mapset rrCount {\cid}{\k}
    \global\set rrRet {\cid}
  \fi
}}

// term ::= factor+ — one factor passes through; two or more make a sequence.
\def rrTerm {{
  \rrFactor
  \set first {\rrRet}
  \rrFactorStart
  \if {\= {\rrFS}{1}}
    \global\set rrId {\calc{rrId + 1}}\set sid {\rrId}
    \global\mapset rrKind {\sid}{S}
    \global\mapset rrChild {\calc{\sid * 1000}}{\first}
    \rrSeqLoop{\sid}{1}
    \rrCheckSepList{\sid}
  \else
    \global\set rrRet {\first}
  \fi
}}

// Recognise a separated-list idiom — A ( B A )* (or +), where A is a single symbol — and
// fold it into one "list" node (kind L) holding the item A and the separator B. It then draws
// the bottlecaps way: A on the line with B on a return loop, far clearer than the literal
// "A then zero-or-more of (B A)".
\def rrCheckSepList sid {{
  \if {\= {\mapget rrCount {\sid}}{2}}
    \set a {\mapget rrChild {\calc{\sid * 1000}}}
    \set w {\mapget rrChild {\calc{\sid * 1000 + 1}}}
    \set wk {\mapget rrKind {\w}}
    \global\set rrSP {0}
    \if {\= {\wk}{R}}\global\set rrSP {1}\fi
    \if {\= {\wk}{P}}\global\set rrSP {1}\fi
    \if {\= {\rrSP}{1}}
      \set ws {\mapget rrSub {\w}}
      \if {\= {\mapget rrKind {\ws}}{S}}
        \if {\= {\mapget rrCount {\ws}}{2}}
          \set b {\mapget rrChild {\calc{\ws * 1000}}}
          \set a2 {\mapget rrChild {\calc{\ws * 1000 + 1}}}
          \rrLeafEq{\a}{\a2}
          \if {\= {\rrEq}{1}}
            \global\mapset rrKind {\sid}{L}
            \global\mapset rrSepItem {\sid}{\a}
            \global\mapset rrSepBy {\sid}{\b}
          \fi
        \fi
      \fi
    \fi
  \fi
}}

// rrEq = 1 when two nodes are the same single symbol — same leaf kind (terminal, nonterminal
// or character class) and the same label.
\def rrLeafEq a b {{
  \global\set rrEq {0}
  \set ka {\mapget rrKind {\a}}
  \if {\= {\ka}{\mapget rrKind {\b}}}
    \global\set rrLf {0}
    \if {\= {\ka}{T}}\global\set rrLf {1}\fi
    \if {\= {\ka}{N}}\global\set rrLf {1}\fi
    \if {\= {\ka}{X}}\global\set rrLf {1}\fi
    \if {\= {\rrLf}{1}}
      \if {\= {\mapget rrLabel {\a}}{\mapget rrLabel {\b}}}\global\set rrEq {1}\fi
    \fi
  \fi
}}
\def rrSeqLoop sid k {{
  \rrFactorStart
  \if {\= {\rrFS}{1}}
    \rrFactor
    \global\mapset rrChild {\calc{\sid * 1000 + \k}}{\rrRet}
    \set nk {\calc{\k + 1}}
    \rrSeqLoop{\sid}{\nk}
  \else
    \global\mapset rrCount {\sid}{\k}
    \global\set rrRet {\sid}
  \fi
}}

// factor ::= primary ( '?' | '*' | '+' )?
\def rrFactor {{
  \rrPrimary
  \set pid {\rrRet}
  \rrPeek
  \if {\= {\rrTk}{?}}\rrNext\rrOptional{\pid}
  \else\if {\= {\rrTk}{*}}\rrNext\rrWrap{R}{\pid}
  \else\if {\= {\rrTk}{+}}\rrNext\rrWrap{P}{\pid}
  \else\global\set rrRet {\pid}\fi\fi\fi
}}
\def rrWrap kind child {{
  \global\set rrId {\calc{rrId + 1}}\set wid {\rrId}
  \global\mapset rrKind {\wid}{\kind}
  \global\mapset rrSub {\wid}{\child}
  \global\set rrRet {\wid}
}}

// An optional x? is the bottlecaps "optional choice": the skip is the straight main line and the
// item rides a forked track below it — the same shape, and the same clean fork rails, whether the
// optional wraps one item or a whole choice. When the body is already a choice, the skip is folded
// in as an empty top branch on the main line; any other body is wrapped in a two-branch choice of
// an empty skip and the item, so a single optional and an optional choice draw identically.
\def rrOptional pid {{
  \set p {\pid}
  \if {\= {\mapget rrKind {\p}}{C}}
    \rrChoicePrependSkip{\p}
    \global\set rrRet {\p}
  \else
    \global\set rrId {\calc{rrId + 1}}\set eid {\rrId}
    \global\mapset rrKind {\eid}{E}
    \global\set rrId {\calc{rrId + 1}}\set cid {\rrId}
    \global\mapset rrKind {\cid}{C}
    \global\mapset rrChild {\calc{\cid * 1000}}{\eid}
    \global\mapset rrChild {\calc{\cid * 1000 + 1}}{\p}
    \global\mapset rrCount {\cid}{2}
    \global\set rrRet {\cid}
  \fi
}}
\def rrChoicePrependSkip cid {{
  \set ck {\cid}
  \set n {\mapget rrCount {\ck}}
  \global\set rrId {\calc{rrId + 1}}\set eid {\rrId}
  \global\mapset rrKind {\eid}{E}
  \set top {\calc{\n - 1}}
  \rrShiftUp{\ck}{\top}
  \global\mapset rrChild {\calc{\ck * 1000}}{\eid}
  \global\mapset rrCount {\ck}{\calc{\n + 1}}
}}
// Shift the choice's children up one index, from the top down, so index 0 is freed for the
// skip branch.
\def rrShiftUp cid k {{
  \set nid {\cid}
  \if {\> {\k}{-1}}
    \set src {\mapget rrChild {\calc{\nid * 1000 + \k}}}
    \global\mapset rrChild {\calc{\nid * 1000 + (\k + 1)}}{\src}
    \set pk {\calc{\k - 1}}
    \rrShiftUp{\nid}{\pk}
  \fi
}}

// primary ::= '(' expr ')' | terminal | nonterminal. A group is transparent: it returns
// the inner expression's id with no node of its own.
\def rrPrimary {{
  \rrPeek
  \if {\= {\rrTk}{(}}
    \rrNext\rrExpr\rrPeek
    \if {\= {\rrTk}{)}}\rrNext\fi
  \else
    \global\set rrId {\calc{rrId + 1}}\set lid {\rrId}
    \if {\= {\rrTt}{tm}}\global\mapset rrKind {\lid}{T}
    \else\if {\= {\rrTt}{cc}}\global\mapset rrKind {\lid}{X}
    \else\global\mapset rrKind {\lid}{N}\fi\fi
    \global\mapset rrLabel {\lid}{\rrTk}
    \rrNext
    \global\set rrRet {\lid}
  \fi
}}

// ================================================================================
// Measure — bottom-up, storing each node's width and its extents above (rrUp) and below
// (rrDn) the rail it sits on, so the rail of any item lines up with its neighbours'.
//   rrW id -> width   rrUp id -> height above the rail   rrDn id -> height below

// Every walking routine binds its node id into a fresh local (nid) on its first line,
// before touching the shared child variable. A macro argument is a name, not a value, so a
// later \set of that same name inside the body would otherwise change the argument under
// it; capturing first pins the id for the whole routine, recursion included.
\def rrMeasure id {{
  \set nid {\id}
  \set k {\mapget rrKind {\nid}}
  \if {\= {\k}{T}}\rrMeasLeaf{\nid}{1}
  \else\if {\= {\k}{N}}\rrMeasLeaf{\nid}{0}
  \else\if {\= {\k}{X}}\rrMeasLeaf{\nid}{2}
  \else\if {\= {\k}{S}}\rrMeasSeq{\nid}
  \else\if {\= {\k}{C}}\rrMeasChoice{\nid}
  \else\if {\= {\k}{L}}\rrMeasL{\nid}
  \else\if {\= {\k}{E}}\rrMeasEmpty{\nid}
  \else\rrMeasWrap{\nid}{\k}\fi\fi\fi\fi\fi\fi\fi
}}

// An empty branch (the skip of an optional choice): zero size, so as a choice's first branch
// it is just the straight main-line rail the fork bypasses to.
\def rrMeasEmpty id {{
  \set nid {\id}
  \global\mapset rrW {\nid}{0}
  \global\mapset rrUp {\nid}{0}
  \global\mapset rrDn {\nid}{0}
}}

// A separated list A (B A)*: the item A sits on the rail and the separator B rides a return
// loop above it. As wide as the wider of the two plus the loop lead; as tall as A's upper half
// plus the clearance and B above.
\def rrMeasL id {{
  \set nid {\id}
  \set a {\mapget rrSepItem {\nid}}
  \set b {\mapget rrSepBy {\nid}}
  \rrMeasure{\a}
  \rrMeasure{\b}
  \set aw {\mapget rrW {\a}}\set au {\mapget rrUp {\a}}\set ad {\mapget rrDn {\a}}
  \set bw {\mapget rrW {\b}}\set bu {\mapget rrUp {\b}}\set bd {\mapget rrDn {\b}}
  \global\set rrInner {\aw}
  \if {\> {\bw}{\aw}}\global\set rrInner {\bw}\fi
  \global\mapset rrW {\nid}{\calc{rrInner + 2 * rrloopx}}
  \global\mapset rrUp {\nid}{\calc{\au + rrloop + \bd + \bu}}
  \global\mapset rrDn {\nid}{\ad}
}}

// A box sizes to its label — the label plus rrpadx on each side — the same for every shape: a
// square nonterminal (shape 0), a rounded terminal whose caps fit inside the padding (shape 1),
// or a pointed character-class hexagon whose points sit inside the padding too (shape 2).
\def rrMeasLeaf id shape {{
  \set nid {\id}
  \set lbl {\mapget rrLabel {\nid}}
  \global\set rrwt {regular}
  \if {\> {\shape}{0}}\global\set rrwt {bold}\fi
  \setbox rrbox \hbox{{\font {\rrface} {\rrfont} {\rrwt}\lbl}}
  \set tw {\wd rrbox}
  \global\mapset rrW {\nid}{\calc{\tw + 2 * rrpadx}}
  \global\mapset rrUp {\nid}{\calc{rrboxh / 2}}
  \global\mapset rrDn {\nid}{\calc{rrboxh / 2}}
}}

// A sequence is as wide as its children plus the connecting rails, and as tall as the
// tallest child on each side of the rail. Children are measured first (filling the maps),
// then summed without any further descent.
\def rrMeasSeq id {{
  \set nid {\id}
  \set n {\mapget rrCount {\nid}}
  \rrMeasKids{\nid}{0}{\n}
  \global\set rrAw {0}\global\set rrAu {0}\global\set rrAd {0}
  \rrSeqSum{\nid}{0}{\n}
  \global\mapset rrW {\nid}{\calc{rrAw + (\n - 1) * rrhgap}}
  \global\mapset rrUp {\nid}{\rrAu}
  \global\mapset rrDn {\nid}{\rrAd}
}}
\def rrMeasKids id i n {{
  \set nid {\id}
  \if {\< {\i}{\n}}
    \set c {\mapget rrChild {\calc{\nid * 1000 + \i}}}
    \rrMeasure{\c}
    \set ni {\calc{\i + 1}}
    \rrMeasKids{\nid}{\ni}{\n}
  \fi
}}
\def rrSeqSum id i n {{
  \set nid {\id}
  \if {\< {\i}{\n}}
    \set c {\mapget rrChild {\calc{\nid * 1000 + \i}}}
    \set cw {\mapget rrW {\c}}\set cu {\mapget rrUp {\c}}\set cd {\mapget rrDn {\c}}
    \global\set rrAw {\calc{rrAw + \cw}}
    \if {\> {\cu}{\rrAu}}\global\set rrAu {\cu}\fi
    \if {\> {\cd}{\rrAd}}\global\set rrAd {\cd}\fi
    \set ni {\calc{\i + 1}}
    \rrSeqSum{\nid}{\ni}{\n}
  \fi
}}

// A choice stacks its alternatives. The main rail enters on the first one, so the choice
// reaches up by the first alternative's height and down by the first's lower half plus
// every later alternative's full height and the gaps between. It is as wide as the widest
// alternative plus a fork lead-in and lead-out on each side.
\def rrMeasChoice id {{
  \set nid {\id}
  \set n {\mapget rrCount {\nid}}
  \rrMeasKids{\nid}{0}{\n}
  \global\set rrAw {0}
  \rrChoiceMaxW{\nid}{0}{\n}
  \set cz {\mapget rrChild {\calc{\nid * 1000}}}
  \set uz {\mapget rrUp {\cz}}
  \set dz {\mapget rrDn {\cz}}
  \global\mapset rrUp {\nid}{\uz}
  \global\set rrAd {\dz}
  \rrChoiceSumDn{\nid}{1}{\n}
  \global\mapset rrDn {\nid}{\rrAd}
  \global\mapset rrW {\nid}{\calc{rrAw + 2 * rrfork}}
}}
\def rrChoiceMaxW id i n {{
  \set nid {\id}
  \if {\< {\i}{\n}}
    \set c {\mapget rrChild {\calc{\nid * 1000 + \i}}}
    \set cw {\mapget rrW {\c}}
    \if {\> {\cw}{\rrAw}}\global\set rrAw {\cw}\fi
    \set ni {\calc{\i + 1}}
    \rrChoiceMaxW{\nid}{\ni}{\n}
  \fi
}}
\def rrChoiceSumDn id i n {{
  \set nid {\id}
  \if {\< {\i}{\n}}
    \set c {\mapget rrChild {\calc{\nid * 1000 + \i}}}
    \set cu {\mapget rrUp {\c}}\set cd {\mapget rrDn {\c}}
    \global\set rrAd {\calc{rrAd + rrvgap + \cu + \cd}}
    \set ni {\calc{\i + 1}}
    \rrChoiceSumDn{\nid}{\ni}{\n}
  \fi
}}

// A repetition wrapper is its child plus room on each side for the loop arcs, and extra height
// for a bypass above (the skip of a *) and a return loop below (the repeat of a * or a +).
\def rrMeasWrap id k {{
  \set nid {\id}
  \set c {\mapget rrSub {\nid}}
  \rrMeasure{\c}
  \set cu {\mapget rrUp {\c}}\set cd {\mapget rrDn {\c}}\set cw {\mapget rrW {\c}}
  \global\mapset rrW {\nid}{\calc{\cw + 2 * rrloopx}}
  \if {\= {\k}{R}}
    \global\mapset rrUp {\nid}{\calc{\cu + rrloop}}\global\mapset rrDn {\nid}{\calc{\cd + rrloop}}
  \else
    \global\mapset rrUp {\nid}{\cu}\global\mapset rrDn {\nid}{\calc{\cd + rrloop}}
  \fi
}}

// ================================================================================
// Draw — top-down. Each node is drawn with its rail entering at (x, y) on the left and
// leaving at (x + width, y) on the right; children get their own (x, y) computed from the
// measured sizes. All coordinates are absolute within the \picture.

\def rrRail ax ay bx by {\nofill\stroke{\rrlinecolor}\linewidth{1pt}\line{\ax \ay \bx \by}}

// Every draw routine captures its node id and coordinates into fresh locals (nid, bx, by,
// and bw for a width) on its first lines, before computing any others. A macro argument is
// a name, so a later \set of a name a coordinate was passed under would change it mid-draw;
// capturing pins them for the whole routine and its recursion.
\def rrDraw id x y {{
  \set nid {\id}\set bx {\x}\set by {\y}
  \set k {\mapget rrKind {\nid}}
  \if {\= {\k}{T}}\rrDrawLeaf{\nid}{\bx}{\by}{1}
  \else\if {\= {\k}{N}}\rrDrawLeaf{\nid}{\bx}{\by}{0}
  \else\if {\= {\k}{X}}\rrDrawLeaf{\nid}{\bx}{\by}{2}
  \else\if {\= {\k}{S}}\rrDrawSeq{\nid}{\bx}{\by}
  \else\if {\= {\k}{C}}\rrDrawChoice{\nid}{\bx}{\by}
  \else\if {\= {\k}{R}}\rrDrawStar{\nid}{\bx}{\by}
  \else\if {\= {\k}{L}}\rrDrawL{\nid}{\bx}{\by}
  \else\if {\= {\k}{E}}
  \else\rrDrawPlus{\nid}{\bx}{\by}\fi\fi\fi\fi\fi\fi\fi\fi
}}

// A separated list: the item A on the main line, the separator B on a return loop above it,
// the loop rising from after A, running left through B, and dropping back to before A.
\def rrDrawL id x y {{
  \set nid {\id}\set bx {\x}\set by {\y}
  \set a {\mapget rrSepItem {\nid}}
  \set b {\mapget rrSepBy {\nid}}
  \set aw {\mapget rrW {\a}}\set au {\mapget rrUp {\a}}
  \set bw {\mapget rrW {\b}}\set bd {\mapget rrDn {\b}}
  \set w {\mapget rrW {\nid}}
  \global\set rrInner {\aw}\if {\> {\bw}{\aw}}\global\set rrInner {\bw}\fi
  \set xL {\calc{\bx + rrloopx}}
  \set xR {\calc{\bx + \w - rrloopx}}
  \set xA {\calc{\xL + (rrInner - \aw) / 2}}
  \set xB {\calc{\xL + (rrInner - \bw) / 2}}
  \set yt {\calc{\by + \au + rrloop + \bd}}
  \set xw {\calc{\bx + \w}}
  \rrRail{\bx}{\by}{\xA}{\by}
  \rrDraw{\a}{\xA}{\by}
  \rrRail{\calc{\xA + \aw}}{\by}{\xw}{\by}
  \rrDraw{\b}{\xB}{\yt}
  \rrSepRight{\xR}{\xw}{\by}{\yt}{\calc{\xB + \bw}}
  \rrSepLeft{\xL}{\bx}{\by}{\yt}{\xB}
}}

// The two halves of a separated-list loop. Like the repeat loop, each leaves the main line at
// its connection point (cx), runs out to the loop's outer edge (ox), and rounds the corner
// up — so the loop bows outward and meets the line with a curve, not a right angle — then runs
// along the top to the separator's edge. Right half: cx on the right, B's right edge (xbr).
\def rrSepRight cx ox y yt xbr {{
  \set r {\rrcr}\set kr {\calc{0.5523 * \r}}
  \nofill\stroke{\rrlinecolor}\linewidth{1pt}
  \path{
    \moveto{\cx \y}
    \lineto{\calc{\ox - \r} \y}
    \curveto{\calc{\ox - \r + \kr} \y  \ox \calc{\y + \r - \kr}  \ox \calc{\y + \r}}
    \lineto{\ox \calc{\yt - \r}}
    \curveto{\ox \calc{\yt - \r + \kr}  \calc{\ox - \r + \kr} \yt  \calc{\ox - \r} \yt}
    \lineto{\xbr \yt}
  }
}}
// Left half: cx on the left, ox the left outer edge, down to B's left edge (xbl).
\def rrSepLeft cx ox y yt xbl {{
  \set r {\rrcr}\set kr {\calc{0.5523 * \r}}
  \nofill\stroke{\rrlinecolor}\linewidth{1pt}
  \path{
    \moveto{\xbl \yt}
    \lineto{\calc{\ox + \r} \yt}
    \curveto{\calc{\ox + \r - \kr} \yt  \ox \calc{\yt - \r + \kr}  \ox \calc{\yt - \r}}
    \lineto{\ox \calc{\y + \r}}
    \curveto{\ox \calc{\y + \r - \kr}  \calc{\ox + \r - \kr} \y  \calc{\ox + \r} \y}
    \lineto{\cx \y}
  }
}}

// A leaf box, the label centred on it: a rounded stadium for a terminal (shape 1), a pointed
// hexagon for a character class (shape 2), or a plain rectangle for a nonterminal (shape 0).
\def rrDrawLeaf id x y shape {{
  \set nid {\id}\set bx {\x}\set by {\y}
  \set bw {\mapget rrW {\nid}}
  \set lbl {\mapget rrLabel {\nid}}
  \global\set rrwt {regular}
  \if {\> {\shape}{0}}\global\set rrwt {bold}\fi
  \set top {\calc{\by + rrboxh / 2}}\set bot {\calc{\by - rrboxh / 2}}
  \if {\= {\shape}{1}}
    // the stadium as ONE closed path — top edge, right cap (two quarter Béziers), bottom edge,
    // left cap — filled and stroked in a single paint, so there are no seams between sections.
    \set r {\calc{rrboxh / 2}}\set kr {\calc{0.5523 * \r}}
    \set xl {\calc{\bx + \r}}\set xr {\calc{\bx + \bw - \r}}
    \fill{\rrtermfill}\stroke{\rrlinecolor}\linewidth{1pt}
    \path{
      \moveto{\xl \top}
      \lineto{\xr \top}
      \curveto{\calc{\xr + \kr} \top  \calc{\xr + \r} \calc{\by + \kr}  \calc{\xr + \r} \by}
      \curveto{\calc{\xr + \r} \calc{\by - \kr}  \calc{\xr + \kr} \bot  \xr \bot}
      \lineto{\xl \bot}
      \curveto{\calc{\xl - \kr} \bot  \calc{\xl - \r} \calc{\by - \kr}  \calc{\xl - \r} \by}
      \curveto{\calc{\xl - \r} \calc{\by + \kr}  \calc{\xl - \kr} \top  \xl \top}
      \close
    }
  \else\if {\= {\shape}{2}}
    // a character class: a hexagon with pointed left/right ends, where the rail meets it.
    \set d {\rrccpt}
    \fill{\rrccfill}\stroke{\rrlinecolor}\linewidth{1pt}
    \polygon{\bx \by  \calc{\bx + \d} \top  \calc{\bx + \bw - \d} \top  \calc{\bx + \bw} \by  \calc{\bx + \bw - \d} \bot  \calc{\bx + \d} \bot}
  \else
    \fill{\rrnontermfill}\stroke{\rrlinecolor}\linewidth{1pt}
    \rect{\bx \bot \bw \rrboxh}
  \fi\fi
  \at anchor:center {\calc{\bx + \bw / 2} \by}{{\font {\rrface} {\rrfont} {\rrwt}\lbl}}
}}

// A sequence draws each child in turn with a connecting rail between neighbours.
\def rrDrawSeq id x y {{\set nid {\id}\set n {\mapget rrCount {\nid}}\rrSeqDraw{\nid}{0}{\n}{\x}{\y}}}
\def rrSeqDraw id i n x y {{
  \set nid {\id}\set bx {\x}\set by {\y}
  \if {\< {\i}{\n}}
    \set c {\mapget rrChild {\calc{\nid * 1000 + \i}}}
    \set cw {\mapget rrW {\c}}
    \rrDraw{\c}{\bx}{\by}
    \set ni {\calc{\i + 1}}
    \if {\< {\ni}{\n}}
      \set xe {\calc{\bx + \cw}}
      \set nx {\calc{\bx + \cw + rrhgap}}
      \rrRail{\xe}{\by}{\nx}{\by}
      \rrSeqDraw{\nid}{\ni}{\n}{\nx}{\by}
    \fi
  \fi
}}

// A choice: lay out the rail height of each alternative (rrYof), draw the two vertical
// fork buses joining them at the left and right, then each alternative with its lead-in
// and lead-out rails.
\def rrDrawChoice id x y {{
  \set nid {\id}\set bx {\x}\set by {\y}
  \set n {\mapget rrCount {\nid}}
  \set bw {\mapget rrW {\nid}}
  \global\mapset rrYof {\calc{\nid * 1000}}{\by}
  \rrChoiceLayout{\nid}{1}{\n}{\by}
  \rrChoiceDraw{\nid}{0}{\n}{\bx}{\bw}{\by}
}}
\def rrChoiceLayout id k n yprev {{
  \set nid {\id}\set byp {\yprev}
  \set cprev {\mapget rrChild {\calc{\nid * 1000 + (\k - 1)}}}
  \set ccur {\mapget rrChild {\calc{\nid * 1000 + \k}}}
  \set dnprev {\mapget rrDn {\cprev}}
  \set upc {\mapget rrUp {\ccur}}
  \set yk {\calc{\byp - \dnprev - rrvgap - \upc}}
  \global\mapset rrYof {\calc{\nid * 1000 + \k}}{\yk}
  \set nk {\calc{\k + 1}}
  \if {\< {\nk}{\n}}\rrChoiceLayout{\nid}{\nk}{\n}{\yk}\fi
}}
// The first alternative sits on the main line (straight lead-in / lead-out); every later one
// is reached by a rounded fork branch dropping from the main line and rising back to it.
\def rrChoiceDraw id k n x w ey {{
  \set nid {\id}\set bx {\x}\set bw {\w}\set bey {\ey}
  \if {\< {\k}{\n}}
    \set c {\mapget rrChild {\calc{\nid * 1000 + \k}}}
    \set yk {\mapget rrYof {\calc{\nid * 1000 + \k}}}
    \set cw {\mapget rrW {\c}}
    \set xin {\calc{\bx + rrfork}}
    \set xout {\calc{\bx + rrfork + \cw}}
    \set xr {\calc{\bx + \bw}}
    \if {\= {\k}{0}}
      \rrRail{\bx}{\yk}{\xin}{\yk}
      \rrRail{\xout}{\yk}{\xr}{\yk}
    \else
      \rrForkDown{\bx}{\bey}{\xin}{\yk}
      \rrForkUp{\xout}{\yk}{\xr}{\bey}
    \fi
    \rrDraw{\c}{\xin}{\yk}
    \set nk {\calc{\k + 1}}
    \rrChoiceDraw{\nid}{\nk}{\n}{\bx}{\bw}{\bey}
  \fi
}}

// Zero or more: a bypass above (skip) and a return loop below (repeat).
\def rrDrawStar id x y {{
  \set nid {\id}\set bx {\x}\set by {\y}
  \set c {\mapget rrSub {\nid}}
  \set cw {\mapget rrW {\c}}
  \set cu {\mapget rrUp {\c}}
  \set cd {\mapget rrDn {\c}}
  \set xin {\calc{\bx + rrloopx}}
  \set xout {\calc{\bx + rrloopx + \cw}}
  \set xr {\calc{\xout + rrloopx}}
  \set yt {\calc{\by + \cu + rrloop}}
  \set yb {\calc{\by - \cd - rrloop}}
  \rrRail{\bx}{\by}{\xin}{\by}
  \rrDraw{\c}{\xin}{\by}
  \rrRail{\xout}{\by}{\xr}{\by}
  \rrBypass{\bx}{\xr}{\by}{\yt}
  \rrReturn{\xin}{\xout}{\by}{\yb}
}}

// One or more: a return loop below, no skip.
\def rrDrawPlus id x y {{
  \set nid {\id}\set bx {\x}\set by {\y}
  \set c {\mapget rrSub {\nid}}
  \set cw {\mapget rrW {\c}}
  \set cd {\mapget rrDn {\c}}
  \set xin {\calc{\bx + rrloopx}}
  \set xout {\calc{\bx + rrloopx + \cw}}
  \set xr {\calc{\xout + rrloopx}}
  \set yb {\calc{\by - \cd - rrloop}}
  \rrRail{\bx}{\by}{\xin}{\by}
  \rrDraw{\c}{\xin}{\by}
  \rrRail{\xout}{\by}{\xr}{\by}
  \rrReturn{\xin}{\xout}{\by}{\yb}
}}

// The rounded rails. Every bend is a quarter circle of radius rrcr, approximated by one
// cubic Bézier (control handles at 0.5523·r along the tangents) so a bend joins its straight
// segments smoothly — the curves that give a railroad diagram its name. Each rail is a single
// \path; the bumps leave and rejoin the main line tangentially, a corner-radius in from each
// end, so the join is seamless.

// A bypass rail from (ax,y) up to height yt and across to (bx,y) — the skip over a starred item.
// Unlike the return loop, a bypass does not turn back on itself: it leaves the main line in
// the direction of travel (an off-ramp), humps over, and merges back, so every corner curves
// forward rather than reversing.
\def rrBypass ax bx y yt {{
  \set r {\rrcr}\set kr {\calc{0.5523 * \r}}
  \nofill\stroke{\rrlinecolor}\linewidth{1pt}
  \path{
    \moveto{\ax \y}
    \curveto{\calc{\ax + \kr} \y  \calc{\ax + \r} \calc{\y + \r - \kr}  \calc{\ax + \r} \calc{\y + \r}}
    \lineto{\calc{\ax + \r} \calc{\yt - \r}}
    \curveto{\calc{\ax + \r} \calc{\yt - \r + \kr}  \calc{\ax + 2 * \r - \kr} \yt  \calc{\ax + 2 * \r} \yt}
    \lineto{\calc{\bx - 2 * \r} \yt}
    \curveto{\calc{\bx - 2 * \r + \kr} \yt  \calc{\bx - \r} \calc{\yt - \r + \kr}  \calc{\bx - \r} \calc{\yt - \r}}
    \lineto{\calc{\bx - \r} \calc{\y + \r}}
    \curveto{\calc{\bx - \r} \calc{\y + \r - \kr}  \calc{\bx - \kr} \y  \bx \y}
  }
}}

// A return rail under an item, leaving the main line at its entry (ax,y) and exit (bx,y),
// running out along the line by rrloopx so the loop's vertical sides stand clear of the box,
// then dropping to yb and back — the repeat loop.
\def rrReturn ax bx y yb {{
  \set r {\rrcr}\set kr {\calc{0.5523 * \r}}\set g {\rrloopx}
  \nofill\stroke{\rrlinecolor}\linewidth{1pt}
  \path{
    \moveto{\ax \y}
    \lineto{\calc{\ax - \g + \r} \y}
    \curveto{\calc{\ax - \g + \r - \kr} \y  \calc{\ax - \g} \calc{\y - \r + \kr}  \calc{\ax - \g} \calc{\y - \r}}
    \lineto{\calc{\ax - \g} \calc{\yb + \r}}
    \curveto{\calc{\ax - \g} \calc{\yb + \r - \kr}  \calc{\ax - \g + \r - \kr} \yb  \calc{\ax - \g + \r} \yb}
    \lineto{\calc{\bx + \g - \r} \yb}
    \curveto{\calc{\bx + \g - \r + \kr} \yb  \calc{\bx + \g} \calc{\yb + \r - \kr}  \calc{\bx + \g} \calc{\yb + \r}}
    \lineto{\calc{\bx + \g} \calc{\y - \r}}
    \curveto{\calc{\bx + \g} \calc{\y - \r + \kr}  \calc{\bx + \g - \r + \kr} \y  \calc{\bx + \g - \r} \y}
    \lineto{\bx \y}
  }
}}

// A fork branch curving DOWN from the main line at (ex,ey) to an alternative's left at
// (tx,ty): out along the line, a rounded drop, then in to the alternative.
\def rrForkDown ex ey tx ty {{
  \set r {\rrcr}\set kr {\calc{0.5523 * \r}}
  \nofill\stroke{\rrlinecolor}\linewidth{1pt}
  \path{
    \moveto{\ex \ey}
    \curveto{\calc{\ex + \kr} \ey  \calc{\ex + \r} \calc{\ey - \r + \kr}  \calc{\ex + \r} \calc{\ey - \r}}
    \lineto{\calc{\ex + \r} \calc{\ty + \r}}
    \curveto{\calc{\ex + \r} \calc{\ty + \r - \kr}  \calc{\ex + 2 * \r - \kr} \ty  \calc{\ex + 2 * \r} \ty}
    \lineto{\tx \ty}
  }
}}

// The mirror of rrForkDown on the right: from an alternative's right (sx,sy) curving UP to
// the main line at (ex,ey).
\def rrForkUp sx sy ex ey {{
  \set r {\rrcr}\set kr {\calc{0.5523 * \r}}
  \nofill\stroke{\rrlinecolor}\linewidth{1pt}
  \path{
    \moveto{\sx \sy}
    \lineto{\calc{\ex - 2 * \r} \sy}
    \curveto{\calc{\ex - 2 * \r + \kr} \sy  \calc{\ex - \r} \calc{\sy + \r - \kr}  \calc{\ex - \r} \calc{\sy + \r}}
    \lineto{\calc{\ex - \r} \calc{\ey - \r}}
    \curveto{\calc{\ex - \r} \calc{\ey - \r + \kr}  \calc{\ex - \kr} \ey  \ex \ey}
  }
}}

// A rightward arrowhead (a filled triangle) with its tip at (x,y) — the entry / exit marker.
\def rrArrow x y {\fill{\rrlinecolor}\nostroke\polygon{\calc{\x - rrah} \calc{\y - rrahw}  \calc{\x - rrah} \calc{\y + rrahw}  \x \y}}

// Derive the box fills from the base colour: a terminal and a character class are the base at a
// lower Oklch lightness, keeping its hue and chroma, so the three shades read as one palette.
\def rrColors {{
  \set lch {\oklchof{\rrbase}}
  \set bL {\head{\lch}}
  \set bC {\head{\tail{\lch}}}
  \set bH {\head{\tail{\tail{\lch}}}}
  \global\set rrnontermfill {\rrbase}
  \global\set rrtermfill {\oklch{\calc{\bL - rrtermdark}}{\bC}{\bH}}
  \global\set rrccfill {\oklch{\calc{\bL - rrccdark}}{\bC}{\bH}}
}}

// ================================================================================
// \railroad{ <grammar> } — lex, then parse and render each rule as its own diagram.
\def railroad <g> {
  \rrLex{\g}
  \rrColors
  \global\set rrId {0}
  \global\set rrP {0}
  \rrRules}

\def rrRules {{
  \rrPeek
  \if {\< {\rrP}{\rrN}}
    \set rname {\rrTk}
    \rrNext\rrPeek
    \if {\= {\rrTk}{::=}}\rrNext\fi
    \rrExpr
    \set root {\rrRet}
    \rrRender{\rname}{\root}
    \rrRules
  \fi
}}

// Measure a rule's tree, then draw it as one self-contained picture: a bold rule-name
// title in a band across the top, and below it the diagram between two terminator bullets
// with the rail running through the middle. Keeping the title inside the picture means a
// diagram needs no paragraph or spacing commands from a document format — it is just a box.
\def rrRender rname root {{
  \rrMeasure{\root}
  \set up {\mapget rrUp {\root}}
  \set dn {\mapget rrDn {\root}}
  \set rw {\mapget rrW {\root}}
  \set titleh {\calc{rrtitlefont + 8}}
  \set pw {\calc{2 * rrmargin + 2 * rrah + 2 * rrhgap + \rw}}
  \set ph {\calc{\up + \dn + 2 * rrmargin + \titleh}}
  \set ry {\calc{rrmargin + \dn}}
  \set yt {\calc{rrmargin + \dn + \up + \titleh / 2}}
  \picture width:{\pw} height:{\ph} {
    \at anchor:west {\rrmargin \yt}{{\font {\rrface} {\rrtitlefont} {bold}\rname}}
    \set xa {\calc{rrmargin + rrah}}
    \rrArrow{\xa}{\ry}
    \set xstart {\calc{\xa + rrhgap}}
    \rrRail{\xa}{\ry}{\xstart}{\ry}
    \rrDraw{\root}{\xstart}{\ry}
    \set xc {\calc{\xstart + \rw}}
    \set xend {\calc{\xc + rrhgap}}
    \rrRail{\xc}{\ry}{\xend}{\ry}
    \set xea {\calc{\xend + rrah}}
    \rrArrow{\xea}{\ry}
  }
}}
