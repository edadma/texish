// tract.texish - impose a bilingual Z-fold gospel tract for printing, folding, and cutting.
//
// A tract carries the same message in two languages, one per face, each Z-folded in thirds. Write each
// language once as flowing prose; the package splits it into three panel-height columns (the leftmost
// fills first), places them across a full-sheet \picture, and emits a two-page document -- front in
// language A, back in language B, in the SAME column order -- with dashed fold guides on the thirds.
// Unfolded flat, one face reads language A across columns 1-2-3 and the other reads language B.
//
//   \use{tract}
//   \tract{ <language A body> }{ <language B body> }
//
// Two paper sizes (\set tractpaper {...}):
//   letter - US Letter portrait holding TWO identical tracts stacked top and bottom, each 612x396 pts;
//            a cut guide crosses the middle (y=396). Cut the sheet in half to get two tracts.
//   a5     - A5 landscape (595.276x419.528 pts) holding ONE tract that fills the sheet; no cut.
//
// Printed double-sided, the back is NOT mirrored relative to the front on a long-edge-flip duplexer, so
// language B's columns land behind language A's directly. Print at true 100% (no fit-to-page scaling)
// so the fold thirds stay exact.

// ---- configuration ----
\set tractmargin {18}            // inset from each panel edge to its content (0.25in)
\set tractguides {1}             // draw fold (vertical) and cut (horizontal) guide lines
\set tractguidecolor {#b0b0b0}
\set tractpaper {letter}         // letter: two tracts per US Letter sheet, cut in half. a5: one
                                 //   tract per A5 sheet (landscape), no cut.

// Hyphenation language per face, as a tag whose patterns ship in the binary (en-us, es, fr). A narrow
// column justifies much more tightly when long words can break, so set these to the body languages.
// Empty (the default) leaves a face unhyphenated. For a language whose patterns are not bundled, load
// them once with \loadhyphenation{tag}{path} before \tract and name the tag here.
\set tractlanga {}               // hyphenation tag for the language-A (front) body, e.g. en-us
\set tractlangb {}               // hyphenation tag for the language-B (back) body, e.g. es

// A note on duplex registration: double-sided printing rarely lands the back image exactly over the
// front, so the cut line on the two faces may differ by up to about a millimetre on a consumer
// printer. The package does not try to compensate -- the front and back are different languages a
// reader never sees overlaid, so a small drift is invisible in use, and the cut still falls within
// each face's margin. A press or a better duplexer removes the drift at the source.

// Set up the sheet for the chosen paper, then derive every metric from it. An imposition package owns
// the physical page, so we set paperwidth/paperheight ourselves (the CLI -p flag is irrelevant here)
// and zero the page margins so picture coordinates are true sheet coordinates. Letter holds two tracts
// stacked and is cut in half; A5 (landscape) holds one tract and is not cut. Names are letter-only: a
// digit in a \-referenced name would be read as a separate token.
\def trSetup {
  \if {\= {\tractpaper}{a5}}
    \global\set trSheetW {595.276}   // A5 landscape: 210mm wide
    \global\set trSheetH {419.528}   //               148mm tall
    \global\set trNup {1}
  \else
    \global\set trSheetW {612}       // US Letter portrait: 8.5in x 11in
    \global\set trSheetH {792}
    \global\set trNup {2}
  \fi
  \global\set paperwidth {\trSheetW}
  \global\set paperheight {\trSheetH}
  \global\set hoffset {0}
  \global\set voffset {0}
  \global\set hsize {\trSheetW}
  \global\set vsize {\trSheetH}
  \global\set raggedbottom {1}
  \global\set trColW {\calc{trSheetW / 3}}
  \global\set trTractH {\calc{trSheetH / trNup}}
  \global\set trFoldA {\trColW}
  \global\set trFoldB {\calc{2 * trColW}}
  \global\set trCut {\trTractH}
  \global\set trCW {\calc{trColW - 2 * tractmargin}}
  \global\set trCH {\calc{trTractH - 2 * tractmargin}}
  \global\set trXa {\tractmargin}
  \global\set trXb {\calc{trColW + tractmargin}}
  \global\set trXc {\calc{2 * trColW + tractmargin}}
  \global\set trYup {\calc{trSheetH - tractmargin}}
  \global\set trYdn {\calc{trTractH - tractmargin}}
}

// The fold and cut guides, drawn light and dashed so they are easy to see on a proof yet unobtrusive.
// Turn them off with \set tractguides {0} for the final run if your trimmer prefers a clean sheet.
\def trGuides {
  \if {\tractguides}
    \nofill\stroke{\tractguidecolor}\linewidth{0.5}\dash{3 3}
    \line{\trFoldA 0 \trFoldA \trSheetH}
    \line{\trFoldB 0 \trFoldB \trSheetH}
    \if {\> {\trNup}{1}}\line{0 \trCut \trSheetW \trCut}\fi
    \dash{}\stroke{black}\linewidth{1}
  \fi
}

// Place three column boxes across one tract at content-top y. Used twice per page, once for the upper
// tract and once for the lower, so the two tracts on the sheet are identical. Each column argument is a
// guarded \copy (see \tract), so an empty column places nothing rather than erroring.
\def trPlace pa pb pc y {
  \at anchor:northwest {\trXa \y}{\pa}
  \at anchor:northwest {\trXb \y}{\pb}
  \at anchor:northwest {\trXc \y}{\pc}
}

// One side of the sheet: the guides, then the three given columns set into both the upper and the
// lower tract. Each column argument is re-evaluated for each tract, so pass \copy (not \box) to keep
// the register alive for the second placement.
\def trSide ca cb cc {
  \noindent\picture width:{\trSheetW} height:{\trSheetH} {
    \trGuides
    \trPlace{\ca}{\cb}{\cc}{\trYup}
    \if {\> {\trNup}{1}}\trPlace{\ca}{\cb}{\cc}{\trYdn}\fi
  }
}

\def tract bodyA bodyB {{
  \trSetup
  // Typeset each language's body at the column content width. Hyphenation is a global setting read as
  // each paragraph is broken, so switch to each face's language right before building its box.
  \set hsize {\trCW}
  \if {\size {\tractlanga}}\usehyphenation{\tractlanga}\fi
  \setbox trA \vbox{\noindent\bodyA}
  \if {\size {\tractlangb}}\usehyphenation{\tractlangb}\fi
  \setbox trB \vbox{\noindent\bodyB}
  \set hsize {\trSheetW}
  // Split each body into three panel-height columns. The first cut is column 1 (leftmost), the second
  // is column 2, and the remainder is column 3 -- so the message fills the columns left to right. A
  // body shorter than three columns empties its source register early, so each \vsplit is guarded with
  // \isvoid (splitting a void register would error) and the unfilled columns are simply left empty.
  \if {\isvoid trA}\else \setbox trA1 \vsplit trA to:{\trCH}\fi
  \if {\isvoid trA}\else \setbox trA2 \vsplit trA to:{\trCH}\fi
  \if {\isvoid trB}\else \setbox trB1 \vsplit trB to:{\trCH}\fi
  \if {\isvoid trB}\else \setbox trB2 \vsplit trB to:{\trCH}\fi
  // Warn (without stopping the run) when the remainder left after two splits is taller than one column:
  // the body did not fit in three panels and the third will spill past the fold. \ht/\dp take a bare
  // register name and cannot appear inside \calc, so each height is stored first, then summed. The names
  // are literal because \isvoid/\ht read a raw token, not a macro-expanded one.
  \if {\isvoid trA}\else
    \set trRh {\ht trA}\set trRd {\dp trA}
    \if {\> {\calc{trRh + trRd}}{\trCH}}\message{tract: the language-A body overflows three columns; the third panel spills past the fold. Shorten the text or reduce the tractmargin setting.}\fi
  \fi
  \if {\isvoid trB}\else
    \set trRh {\ht trB}\set trRd {\dp trB}
    \if {\> {\calc{trRh + trRd}}{\trCH}}\message{tract: the language-B body overflows three columns; the third panel spills past the fold. Shorten the text or reduce the tractmargin setting.}\fi
  \fi
  // FRONT: language A, columns A1 A2 A3 (the remainder) left to right. Each column is placed with a
  // guarded \copy so a column left empty by a short body contributes nothing instead of erroring.
  \trSide{\if {\isvoid trA1}\else\copy trA1\fi}{\if {\isvoid trA2}\else\copy trA2\fi}{\if {\isvoid trA}\else\copy trA\fi}
  \newpage
  // BACK: language B in the SAME column order as the front. On this duplex path the back is not
  // mirrored relative to the front, so B1 B2 B3 land behind A1 A2 A3 directly.
  \trSide{\if {\isvoid trB1}\else\copy trB1\fi}{\if {\isvoid trB2}\else\copy trB2\fi}{\if {\isvoid trB}\else\copy trB\fi}
}}
