// tract.texish - impose a bilingual Z-fold gospel tract onto US Letter.
//
// One Letter sheet (portrait) carries TWO identical half-letter tracts stacked top and bottom; cut
// the sheet across the middle to get two tracts. Each tract is Z-folded in thirds -- three 2.833in
// columns. The message in language A flows down the front's three columns (leftmost column first);
// the same message in language B flows down the back's three columns. Printed double-sided and
// flipped on the LONG edge, the back columns are imposed in reverse so that after the flip each B
// column lands behind its A column. So when a tract is unfolded flat it shows the whole message in
// language A on one face and language B on the other.
//
//   \use{tract}
//   \tract{ <language A body> }{ <language B body> }
//
// Geometry (points, 72 per inch): sheet 612x792, each tract 612x396, column 204 wide, fold lines at
// x=204 and x=408, cut line at y=396. Print double-sided, flip on the long edge, cut, then Z-fold.

// ---- configuration ----
\set tractmargin {18}            // inset from each panel edge to its content (0.25in)
\set tractguides {1}             // draw fold (vertical) and cut (horizontal) guide lines
\set tractguidecolor {#b0b0b0}
\set tractpaper {letter}         // letter: two tracts per US Letter sheet, cut in half. a5: one
                                 //   tract per A5 sheet (landscape), no cut.

// Duplex registration: real duplex printing rarely lands the back exactly over the front, and the
// cut must fall on the sheet's true middle. Fold the calibration sheet in half to find that middle,
// see which side's cut guide sits on it (that side is correct) and how far the other side is off,
// then nudge the off side onto the middle with these. Positive dy moves a side UP, positive dx moves
// it RIGHT; about 2.835 points per millimetre. All default to 0 and are printer-specific.
\set tractfrontdx {0}
\set tractfrontdy {0}
\set tractbackdx {0}
\set tractbackdy {0}

// Set up the sheet for the chosen paper, then derive every metric from it. An imposition package owns
// the physical page, so we set paperwidth/paperheight ourselves (the CLI -p flag is irrelevant here)
// and zero the page margins so picture coordinates are true sheet coordinates. Letter holds two tracts
// stacked and is cut in half; A5 (landscape) holds one tract and is not cut. Names are letter-only: a
// digit in a \-referenced name would be read as a separate token.
\def trSetup {
  \if {\= {\tractpaper}{a5}}
    \global\set trSheetW {595.276}   // A5 landscape: 210mm wide
    \global\set trSheetH {419.528}   //               148mm tall
    \global\set trNup {1}
  \else
    \global\set trSheetW {612}       // US Letter portrait: 8.5in x 11in
    \global\set trSheetH {792}
    \global\set trNup {2}
  \fi
  \global\set paperwidth {\trSheetW}
  \global\set paperheight {\trSheetH}
  \global\set hoffset {0}
  \global\set voffset {0}
  \global\set hsize {\trSheetW}
  \global\set vsize {\trSheetH}
  \global\set raggedbottom {1}
  \global\set trColW {\calc{trSheetW / 3}}
  \global\set trTractH {\calc{trSheetH / trNup}}
  \global\set trFoldA {\trColW}
  \global\set trFoldB {\calc{2 * trColW}}
  \global\set trCut {\trTractH}
  \global\set trCW {\calc{trColW - 2 * tractmargin}}
  \global\set trCH {\calc{trTractH - 2 * tractmargin}}
  \global\set trXa {\tractmargin}
  \global\set trXb {\calc{trColW + tractmargin}}
  \global\set trXc {\calc{2 * trColW + tractmargin}}
  \global\set trYup {\calc{trSheetH - tractmargin}}
  \global\set trYdn {\calc{trTractH - tractmargin}}
}

// The fold and cut guides, drawn light and dashed so they are easy to see on a proof yet unobtrusive.
// Turn them off with \set tractguides {0} for the final run if your trimmer prefers a clean sheet.
\def trGuides {
  \if {\tractguides}
    \nofill\stroke{\tractguidecolor}\linewidth{0.5}\dash{3 3}
    \line{\trFoldA 0 \trFoldA \trSheetH}
    \line{\trFoldB 0 \trFoldB \trSheetH}
    \if {\> {\trNup}{1}}\line{0 \trCut \trSheetW \trCut}\fi
    \dash{}\stroke{black}\linewidth{1}
  \fi
}

// Place three column boxes across one tract at content-top y. Used twice per page, once for the upper
// tract and once for the lower, so the two tracts on the sheet are identical.
\def trPlace pa pb pc y {
  \at anchor:northwest {\trXa \y}{\pa}
  \at anchor:northwest {\trXb \y}{\pb}
  \at anchor:northwest {\trXc \y}{\pc}
}

// One side of the sheet: a registration offset (dx, dy) for the whole side, the guides, then the
// three given columns set into both the upper and the lower tract. Each column argument is
// re-evaluated for each tract, so pass \copy (not \box) to keep the register alive for the second
// placement.
\def trSide dx dy ca cb cc {
  \noindent\picture width:{\trSheetW} height:{\trSheetH} {
    \translate{\dx \dy}
    \trGuides
    \trPlace{\ca}{\cb}{\cc}{\trYup}
    \if {\> {\trNup}{1}}\trPlace{\ca}{\cb}{\cc}{\trYdn}\fi
  }
}

\def tract bodyA bodyB {{
  \trSetup
  // Typeset each language's body at the column content width.
  \set hsize {\trCW}
  \setbox trA \vbox{\noindent\bodyA}
  \setbox trB \vbox{\noindent\bodyB}
  \set hsize {\trSheetW}
  // Split each body into three panel-height columns. The first cut is column 1 (leftmost), the second
  // is column 2, and the remainder is column 3 -- so the message fills the columns left to right.
  \setbox trA1 \vsplit trA to:{\trCH}
  \setbox trA2 \vsplit trA to:{\trCH}
  \setbox trB1 \vsplit trB to:{\trCH}
  \setbox trB2 \vsplit trB to:{\trCH}
  // FRONT: language A, columns A1 A2 A3 left to right.
  \trSide{\tractfrontdx}{\tractfrontdy}{\copy trA1}{\copy trA2}{\copy trA}
  \newpage
  // BACK: language B in the SAME column order as the front. On this duplex path the back is not
  // mirrored relative to the front, so B1 B2 B3 land behind A1 A2 A3 directly.
  \trSide{\tractbackdx}{\tractbackdy}{\copy trB1}{\copy trB2}{\copy trB}
}}
